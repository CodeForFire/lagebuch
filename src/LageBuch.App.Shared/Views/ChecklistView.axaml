<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             x:Class="LageBuch.App.Shared.Views.ChecklistView"
             x:DataType="vm:ChecklistViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="CHECKLISTE" Classes="overline" Margin="0,0,0,14" />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}" IsEnabled="{Binding !IsReadOnly}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChecklistItemViewModel">
            <Border Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}" Padding="14,11" Margin="0,0,0,7">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsDone}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontSize="14.5" Margin="4,0,0,0" />
                <Border Grid.Column="2" IsVisible="{Binding IsMandatory}" VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusSm}" Background="#241608"
                        BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" Padding="8,3" Margin="8,0,0,0">
                  <TextBlock Text="PFLICHT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
