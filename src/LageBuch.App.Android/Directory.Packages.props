<Project>
  <!-- Android-only package versions: Avalonia.Android itself is never referenced by the
       desktop projects, so it's pinned here rather than in the root file. Everything else
       (Avalonia, Avalonia.Fonts.Inter, ...) comes from the root file with no override needed;
       keep Avalonia.Android on the same version as the root's Avalonia packages.
       Nearest-wins rules apply, so import the root definitions first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />

  <ItemGroup>
    <PackageVersion Include="Avalonia.Android" Version="12.1.5" />
    <!-- Floors required by Avalonia.Android 12.1.5's own transitive dependencies on
         Xamarin.AndroidX.AppCompat 1.7.1.3 and Xamarin.AndroidX.DocumentFile 1.1.0.3, which
         need Core >= 1.17.0.2 and Activity >= 1.12.4.1 (checked against both nuspecs). -->
    <PackageVersion Include="Xamarin.AndroidX.Activity" Version="1.12.4.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
  </ItemGroup>
</Project>
