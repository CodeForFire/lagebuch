<Project>
  <!-- Central Package Management: single source of truth for package versions.
       Projects reference <PackageReference Include="..." /> without a Version attribute;
       dependabot updates versions here (one edit per package instead of per project).

       Subtrees that intentionally deviate keep their own Directory.Packages.props
       (nearest file wins; they import this one):
         - src/LageBuch.App.Android            (Avalonia.Android is Android-only, never referenced
                                                 by the desktop projects, plus two AndroidX floors)
         - tests/LageBuch.Acceptance.Tests     (xunit.v3 stack)
       Single-reference exceptions use VersionOverride in the .csproj. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.43" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="QuestPDF" Version="2026.9.2" />
    <!-- Already shipped by Avalonia.Skia; referenced directly so the map can ask a picture's codec its size before decoding (RasterOverlayCache). Keep on the version Avalonia.Skia resolves. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
