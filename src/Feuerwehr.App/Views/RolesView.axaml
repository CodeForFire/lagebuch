<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Feuerwehr.AppLogic.ViewModels;assembly=Feuerwehr.AppLogic"
             x:Class="Feuerwehr.App.Views.RolesView"
             x:DataType="vm:RolesViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="FÜHRUNG &amp; FUNKTIONEN" Classes="overline" Margin="0,0,0,14" />

    <!-- Input dock -->
    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Width="130" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding NewRole}" />
        <TextBox x:Name="PersonNameBox" Width="210" Watermark="Name" Text="{Binding NewPersonName}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddRoleCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <ComboBox Width="170" ItemsSource="{Binding CallSignOptions}" SelectedItem="{Binding NewCallSign}" />
        <Button Classes="signal" Content="ZUWEISEN" Command="{Binding AddRoleCommand}" />
      </StackPanel>
    </Border>

    <Border Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <DataGrid ItemsSource="{Binding Roles}" IsReadOnly="True" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="FUNKTION" Binding="{Binding Role}" />
          <DataGridTextColumn Header="NAME" Binding="{Binding PersonName}" Width="*" />
          <DataGridTextColumn Header="FUNKRUFNAME" Binding="{Binding CallSign}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
