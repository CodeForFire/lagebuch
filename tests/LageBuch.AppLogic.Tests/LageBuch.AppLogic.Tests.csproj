<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CoOnlyIncidentExtensions.cs" Link="Shared\CoOnlyIncidentExtensions.cs" />
    <Compile Include="..\Shared\CoOnlySessionExtensions.cs" Link="Shared\CoOnlySessionExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LageBuch.AppLogic\LageBuch.AppLogic.csproj" />
    <!-- Test-only: exercises real PDF rendering (ExportPdfAsync) via a QuestPDF-backed
         IIncidentPdfExporter double. Production AppLogic itself no longer references Documents,
         which is what keeps QuestPDF out of the Android build (#184). -->
    <ProjectReference Include="..\..\src\LageBuch.Documents\LageBuch.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The byte-level PMTiles/MVT builder, so a viewport test can show a real archive. -->
    <Compile Include="..\LageBuch.Persistence.Tests\VectorTileFixtures.cs" Link="VectorTileFixtures.cs" />
    <!-- The GeoTIFF writer, so terrain is drawn from made-up heights, never from real DGM data. -->
    <Compile Include="..\LageBuch.Persistence.Tests\GeoTiffFixtures.cs" Link="GeoTiffFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fictional all-fields Stammdaten file the import/export round-trip tests share. -->
    <Compile Include="..\Fixtures\StammdatenFixture.cs" Link="Fixtures\StammdatenFixture.cs" />
    <None Include="..\Fixtures\stammdaten-vollstaendig.json" Link="Fixtures\stammdaten-vollstaendig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
