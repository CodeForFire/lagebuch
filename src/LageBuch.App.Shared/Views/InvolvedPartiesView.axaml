<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             x:Class="LageBuch.App.Shared.Views.InvolvedPartiesView"
             x:DataType="vm:InvolvedPartiesViewModel">
  <!-- Same dock idiom as ForcesView: the fields run side by side on a wide window and stack on a
       phone. Orientation and widths are Style setters rather than attributes, because a local value
       in XAML outranks a Style setter and the narrow styles could never change them. -->
  <UserControl.Styles>
    <Style Selector="StackPanel#DockFields">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="TextBox#NewNameBox">
      <Setter Property="Width" Value="220" />
    </Style>
    <Style Selector="TextBox#NewPhoneBox">
      <Setter Property="Width" Value="170" />
    </Style>
    <Style Selector="TextBox#NewNotesBox">
      <Setter Property="Width" Value="320" />
    </Style>

    <Style Selector="Panel#WorkspaceRoot.narrow StackPanel#DockFields">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow TextBlock#InvolvedPartiesTitle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow TextBox#NewNameBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow TextBox#NewPhoneBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow TextBox#NewNotesBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow HeaderedContentControl.field">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow Button.dock-action">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
    </Style>
  </UserControl.Styles>

  <!-- Tab follows the screen, top to bottom (#695). The DockPanel needs its bottom-docked
       children declared before the list that fills the rest, and declaration order alone tabbed
       the dock before the list above it. Each child is its own tab group, ranked by TabIndex in
       the order it appears on screen. -->
  <DockPanel KeyboardNavigation.TabNavigation="Local">
    <TextBlock DockPanel.Dock="Top" x:Name="InvolvedPartiesTitle" Text="BETEILIGTE" Classes="overline"
               Margin="0,0,0,14" />

    <!-- The phone's way in to the form, at the bottom edge where the thumb already is. -->
    <Button KeyboardNavigation.TabIndex="2" DockPanel.Dock="Bottom" x:Name="OpenComposerButton" Classes="signal"
            Margin="0,12,0,0" HorizontalAlignment="Stretch"
            Height="{StaticResource ControlHeightTouch}"
            Content="+ BETEILIGTE/N AUFNEHMEN"
            IsVisible="{Binding ShowComposerButton}"
            Command="{Binding OpenComposerCommand}" />

    <!-- Input dock. Enter submits from every field; focus then goes back to NAME (#540). -->
    <Border KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1" x:Name="InputDock" DockPanel.Dock="Bottom" Margin="0,16,0,0"
            IsVisible="{Binding ShowComposer}"
            b:EntryForm.SubmitCommand="{Binding AddCommand}"
            b:EntryForm.FirstField="{Binding #NewNameBox}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <!-- Scrolls so a focused field stays reachable once Android's AdjustResize has given the
           bottom of the window to the soft keyboard. Never scrolls on a wide window. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6">
          <Grid x:Name="ComposerHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,4"
                IsVisible="{Binding IsNarrow}">
            <TextBlock Grid.Column="0" Text="BETEILIGTE/N AUFNEHMEN" Classes="overline" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="CloseComposerButton" Classes="ghost"
                    AutomationProperties.Name="Eingabe schließen"
                    ToolTip.Tip="Eingabe schließen"
                    Command="{Binding CloseComposerCommand}">
              <PathIcon Width="13" Height="13"
                        Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
            </Button>
          </Grid>
          <StackPanel x:Name="DockFields" Spacing="8">
            <HeaderedContentControl Classes="field required" Header="NAME"
                                    Classes.invalid="{Binding NewNameError, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBox x:Name="NewNameBox"
                       MaxLength="{x:Static vm:InvolvedPartiesViewModel.MaxNameLength}"
                       PlaceholderText="{x:Static md:AnonymizedExampleData.PersonDisplayNamePlaceholder}"
                       Text="{Binding NewName}" />
            </HeaderedContentControl>
            <!-- Plain text: a number is read out over the radio or typed into a phone, never
                 dialled from here (tel: launch is out of scope). -->
            <HeaderedContentControl Classes="field" Header="TELEFON">
              <TextBox x:Name="NewPhoneBox"
                       MaxLength="{x:Static vm:InvolvedPartiesViewModel.MaxPhoneLength}"
                       PlaceholderText="{x:Static md:AnonymizedExampleData.PhoneNumberPlaceholder}"
                       Text="{Binding NewPhone}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="NOTIZ">
              <!-- Freitext: kein Platzhalter, siehe #137 -->
              <TextBox x:Name="NewNotesBox"
                       MaxLength="{x:Static vm:InvolvedPartiesViewModel.MaxNotesLength}"
                       Text="{Binding NewNotes}" />
            </HeaderedContentControl>
            <Button x:Name="AddInvolvedPartyButton" Classes="signal dock-action" Content="HINZUFÜGEN"
                    Command="{Binding AddCommand}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
          </StackPanel>
          <TextBlock x:Name="DockErrorSummary" Classes="field-error"
                     Text="{Binding NewNameError}"
                     IsVisible="{Binding NewNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <TextBlock DockPanel.Dock="Top" x:Name="EmptyText" Text="Noch keine Beteiligten erfasst."
               Foreground="{StaticResource TextMutedBrush}"
               IsVisible="{Binding !Parties.Count}" />

    <!-- One card per person on every width: an address book is read entry by entry, and the same
         stacked card works on a 412dp phone. Stretch, never a centred MaxWidth column, so the
         list cannot change width while it scrolls. -->
    <Border KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0" x:Name="InvolvedPartiesPanel"
            Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
            IsVisible="{Binding Parties.Count}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="InvolvedPartiesList" ItemsSource="{Binding Parties}" Margin="8"
                      Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InvolvedPartyRow">
              <Border Classes="row-card">
                <Grid ColumnDefinitions="*,Auto">
                  <!-- Each field pushes on LostFocus: the row rebuilds after every accepted write,
                       so a per-keystroke push would rewrite the Einsatzdatei on every character
                       and throw focus out of the box (#33, same as ForcesView's Bemerkung). -->
                  <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="NAME" Classes="overline" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"
                             AutomationProperties.Name="Name"
                             MaxLength="{x:Static vm:InvolvedPartiesViewModel.MaxNameLength}"
                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding !IsReadOnly}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="TELEFON" Classes="overline" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="mono"
                             AutomationProperties.Name="Telefon"
                             MaxLength="{x:Static vm:InvolvedPartiesViewModel.MaxPhoneLength}"
                             Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding !IsReadOnly}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="NOTIZ" Classes="overline" FontSize="10"
                               VerticalAlignment="Top" Margin="0,8,12,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True"
                             AutomationProperties.Name="Notiz"
                             MaxLength="{x:Static vm:InvolvedPartiesViewModel.MaxNotesLength}"
                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding !IsReadOnly}" />
                    <!-- #702: the CO-Messung's Wohnung this person was found in. A Button and a
                         Flyout, not a ComboBox, for the reason ScbaView's Sicherheitstrupp picker
                         gives. Only shown once there is a Wohnung to pick or a link to show. -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="WOHNUNG" Classes="overline" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               IsVisible="{Binding HasDwellingPicker}" />
                    <Button Grid.Row="3" Grid.Column="1" x:Name="DwellingButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Content="{Binding DwellingButtonText}"
                            IsVisible="{Binding HasDwellingPicker}"
                            IsEnabled="{Binding !IsReadOnly}"
                            AutomationProperties.Name="Wohnung wählen">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DwellingChoices}" MinWidth="240">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DwellingChoice">
                                  <Button Classes="ghost" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left" Padding="8,5"
                                          Command="{Binding SelectCommand}">
                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="6">
                                      <TextBlock Grid.Column="0" Text="✓" FontWeight="Bold" IsVisible="{Binding IsCurrent}" />
                                      <TextBlock Grid.Column="1" Text="{Binding Display}" />
                                    </Grid>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="field-error"
                               Text="{Binding Error}"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </Grid>
                  <Button Grid.Column="1" Classes="icon-btn card-action" VerticalAlignment="Top"
                          Margin="8,0,0,0"
                          IsVisible="{Binding !IsReadOnly}"
                          Command="{Binding RemoveCommand}"
                          ToolTip.Tip="Beteiligte/n entfernen" AutomationProperties.Name="Beteiligte/n entfernen">
                    <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>
