<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Explicit API level: bare net8.0-android normalizes to android1.0, which
         Avalonia.Android/Xamarin.AndroidX (net8.0-android34.0) reject with NU1202. -->
    <TargetFramework>net8.0-android34.0</TargetFramework>
    <!-- Without OutputType=Exe a net8.0-android project builds as a library (.aar); the app head
         must be Exe so publish packages a launchable .apk. -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>de.codeforfire.lagebuch</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia.Android's generated Resource designer code isn't documented and would otherwise
         trip CS1591 under this repo's TreatWarningsAsErrors + GenerateDocumentationFile default. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.2.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.2" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.15.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.9.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LageBuch.App.Shared\LageBuch.App.Shared.csproj" />
    <ProjectReference Include="..\LageBuch.AppLogic\LageBuch.AppLogic.csproj" />
  </ItemGroup>

</Project>
