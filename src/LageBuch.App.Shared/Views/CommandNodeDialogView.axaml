<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             x:Class="LageBuch.App.Shared.Views.CommandNodeDialogView"
             x:DataType="vm:CommandNodeDialogViewModel">
  <!-- The Einsatzdaten dialog's shell (MaxWidth, not Width; 16px scrim inset), with the form in a
       ScrollViewer: six fields do not fit a landscape phone. Initial focus is left to the first tab
       stop, which is NAME, or STANDORT when the Einsatzleitung's post has no name. -->
  <Border Background="#B3070A10" Padding="16"
          b:Overlay.CancelCommand="{Binding CancelCommand}" b:Overlay.PrimaryCommand="{Binding SaveCommand}">
    <Border x:Name="CommandNodeDialogCard" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Stretch"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource OverlayShadow}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource SignalGradientBrush}"
                CornerRadius="12,12,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22,26,24" Spacing="12">
            <TextBlock x:Name="CommandNodeDialogTitle" Text="{Binding Title}" Classes="display" FontSize="20"
                       TextWrapping="Wrap" />
            <HeaderedContentControl Classes="field required" Header="NAME" IsVisible="{Binding ShowName}"
                                    ctrl:Field.Error="{Binding NameError}">
              <TextBox x:Name="CommandNodeNameBox" Text="{Binding Name}" MaxLength="200"
                       AutomationProperties.Name="Name" />
            </HeaderedContentControl>
            <!-- Where the node stands: its Abschnitt (an Unterabschnitt) or on its own (an Abschnitt),
                 and its place among its siblings. The board's picker idiom, a flyout of commands. -->
            <HeaderedContentControl Classes="field" Header="LIEGT IN" IsVisible="{Binding ShowParent}">
              <StackPanel Spacing="4">
                <ctrl:NodeChoicePicker x:Name="CommandNodeParentPicker" PickerName="Liegt in"
                                       Choices="{Binding ParentChoices}" Label="{Binding ParentLabel}" />
                <TextBlock x:Name="CommandNodeParentHint" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding ParentHint}"
                           IsVisible="{Binding ParentHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="EINORDNEN VOR" IsVisible="{Binding ShowPosition}">
              <ctrl:NodeChoicePicker x:Name="CommandNodePositionPicker" PickerName="Einordnen vor"
                                     Choices="{Binding PositionChoices}" Label="{Binding PositionLabel}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="AUFTRAG" IsVisible="{Binding ShowAuftrag}">
              <TextBox x:Name="CommandNodeAuftragBox" Text="{Binding Auftrag}" MaxLength="1000"
                       AutomationProperties.Name="Auftrag"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                       PlaceholderText="z. B. Brandbekämpfung Nordseite" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="STANDORT">
              <TextBox x:Name="CommandNodeStandortBox" Text="{Binding Standort}" MaxLength="200"
                       AutomationProperties.Name="Standort"
                       PlaceholderText="z. B. Hofeinfahrt Hauptstr. 12" />
            </HeaderedContentControl>
            <!-- The Stammdaten's Funkgruppen as suggestions, not a closed set: a channel the list
                 lacks stays enterable, so this is an AutoCompleteBox, as STICHWORT is. -->
            <HeaderedContentControl Classes="field suggest" Header="FUNKGRUPPE">
              <AutoCompleteBox x:Name="CommandNodeFunkgruppeBox" ItemsSource="{Binding FunkgruppeOptions}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxLength="200"
                               AutomationProperties.Name="Funkgruppe"
                               Text="{Binding Funkgruppe}" PlaceholderText="z. B. TMO FW_MUSTER 1000" />
            </HeaderedContentControl>
            <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
              <HeaderedContentControl Grid.Column="0" Classes="field" Header="RUFNAME">
                <TextBox x:Name="CommandNodeRufnameBox" Text="{Binding Rufname}" MaxLength="200"
                         AutomationProperties.Name="Rufname"
                         PlaceholderText="z. B. Florian Emmering" />
              </HeaderedContentControl>
              <HeaderedContentControl Grid.Column="1" Classes="field" Header="TELEFON">
                <TextBox x:Name="CommandNodeTelefonBox" Classes="mono" Text="{Binding Telefon}" MaxLength="50"
                         AutomationProperties.Name="Telefon" />
              </HeaderedContentControl>
            </Grid>
            <TextBlock x:Name="CommandNodeSaveError" Classes="field-error" TextWrapping="Wrap"
                       Text="{Binding SaveError}"
                       IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- Left, primary first (#694): the actions start under the fields they save. -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" Margin="0,8,0,0"
                        IsVisible="{Binding !IsDiscardConfirmOpen}">
              <Button x:Name="CommandNodeSaveButton" Classes="signal" Content="{Binding PrimaryText}"
                      Command="{Binding SaveCommand}" />
              <Button x:Name="CommandNodeCancelButton" Content="ABBRECHEN" Command="{Binding CancelCommand}" />
            </StackPanel>
            <!-- #652: ABBRECHEN or Esc after typing asks first, in place of the buttons. ABBRECHEN means
                 leave here too, as does a second Esc; ZURÜCK, focused, goes back to the form. -->
            <Border x:Name="CommandNodeDiscardPanel" Margin="0,8,0,0"
                    IsVisible="{Binding IsDiscardConfirmOpen}"
                    b:Overlay.IsInline="True"
                    b:Overlay.CancelCommand="{Binding ConfirmDiscardCommand}"
                    b:Overlay.InitialFocus="{Binding #CommandNodeKeepEditingButton}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="ÄNDERUNGEN VERWERFEN?" Classes="overline" />
                <TextBlock Text="Die Eingaben sind noch nicht gespeichert." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                  <Button x:Name="CommandNodeDiscardButton" Classes="signal" Content="ABBRECHEN"
                          Command="{Binding ConfirmDiscardCommand}" />
                  <Button x:Name="CommandNodeKeepEditingButton" Content="ZURÜCK"
                          Command="{Binding CancelDiscardCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
