<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:conv="clr-namespace:LageBuch.App.Shared.Converters"
             xmlns:dom="clr-namespace:LageBuch.Domain.CoMeasurement;assembly=LageBuch.Domain"
             x:Class="LageBuch.App.Shared.Views.CoMessprotokollView"
             x:DataType="vm:CoMessprotokollViewModel">
  <DockPanel>
    <!-- Header: Building selector + actions -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
      <ComboBox Grid.Column="0" ItemsSource="{Binding BuildingOptions}"
                SelectedItem="{Binding SelectedBuilding}"
                PlaceholderText="Haus auswählen..."
                IsEnabled="{Binding CanModify}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="dom:Building">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Content="HAUS HINZUFÜGEN"
              Command="{Binding AddBuildingCommand}"
              IsEnabled="{Binding !IsReadOnly}"
              Margin="8,0,0,0" />
      <Button Grid.Column="2" Content="HAUS ENTFERNEN"
              Command="{Binding RemoveBuildingCommand}"
              IsEnabled="{Binding CanModify}"
              Margin="8,0,0,0" />
    </Grid>

    <!-- Add Building Dialog -->
    <Border DockPanel.Dock="Top" 
            IsVisible="{Binding IsAddBuildingDialogOpen}"
            Background="#0F141D" 
            BorderBrush="{StaticResource HairlineBrush}" 
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" 
            Padding="14" Margin="0,0,0,14">
      <StackPanel Spacing="8">
        <TextBlock Text="NEUES HAUS HINZUFÜGEN" Classes="overline" />
        <StackPanel Spacing="2">
          <TextBlock Text="BEZEICHNUNG" Classes="overline" FontSize="10" />
          <TextBox Text="{Binding NewBuildingName}" PlaceholderText="z. B. Haus A" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="GESCHOOSSE" Classes="overline" FontSize="10" />
            <NumericUpDown Minimum="1" Maximum="50" Value="{Binding NewBuildingFloors}" FormatString="0" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="WOHNUNGEN/GESCHOSS" Classes="overline" FontSize="10" />
            <NumericUpDown Minimum="1" Maximum="30" Value="{Binding NewBuildingApartments}" FormatString="0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="signal" Content="HINZUFÜGEN" Command="{Binding ConfirmAddBuildingCommand}" />
          <Button Content="ABBRECHEN" Command="{Binding CancelAddBuildingCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Remove Building Confirmation -->
    <Border DockPanel.Dock="Top" 
            IsVisible="{Binding IsRemoveBuildingConfirmOpen}"
            Background="#0F141D" 
            BorderBrush="{StaticResource HairlineBrush}" 
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" 
            Padding="14" Margin="0,0,0,14">
      <StackPanel Spacing="8">
        <TextBlock Text="HAUS ENTFERNEN" Classes="overline" />
        <TextBlock Text="Möchten Sie das ausgewählte Haus wirklich entfernen? Alle zugehörigen Wohnungen werden ebenfalls gelöscht." TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="signal" Content="ENTFERNEN" Command="{Binding ConfirmRemoveBuildingCommand}" />
          <Button Content="ABBRECHEN" Command="{Binding CancelRemoveBuildingCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Empty state -->
    <TextBlock DockPanel.Dock="Top"
               Text="Keine Häuser erfasst. Klicken Sie auf 'HAUS HINZUFÜGEN' um zu beginnen."
               Foreground="{StaticResource TextMutedBrush}"
               IsVisible="{Binding !HasBuildings}"
               Margin="0,20,0,0" HorizontalAlignment="Center" />

    <!-- Dwelling Editor (below grid) -->
    <Border DockPanel.Dock="Bottom"
            IsEnabled="{Binding !IsReadOnly}"
            IsVisible="{Binding IsEditorOpen}"
            Background="#0F141D"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="14" Margin="0,0,0,14">
      <StackPanel Spacing="8">
        <TextBlock Text="WOHNUNG BEARBEITEN" Classes="overline" />
        
        <!-- Status buttons -->
        <TextBlock Text="STATUS" Classes="overline" FontSize="10" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Background="#FFC000" Content="Noch nicht abgesucht"
                  Command="{Binding SetEditorStatusNotSearchedCommand}" />
          <Button Background="#92D050" Content="Abgesucht – keine Personen"
                  Command="{Binding SetEditorStatusSearchedCommand}" />
          <Button Background="#FF0000" Content="Person(en) betroffen"
                  Command="{Binding SetEditorStatusAffectedCommand}" />
        </StackPanel>
        
        <!-- CO Value -->
        <StackPanel Spacing="2">
          <TextBlock Text="CO-WERT (ppm)" Classes="overline" FontSize="10" />
          <NumericUpDown Minimum="0" Maximum="9999" Value="{Binding SelectedCell.CoValue}"
                         FormatString="0" PlaceholderText="Kein Messwert" />
        </StackPanel>
        
        <!-- Resident Name -->
        <StackPanel Spacing="2">
          <TextBlock Text="NAME DER BEWOHNER" Classes="overline" FontSize="10" />
          <TextBox Text="{Binding SelectedCell.ResidentName}" PlaceholderText="Optional" />
        </StackPanel>
        
        <!-- Key Available -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="SCHLÜSSEL VORHANDEN" Classes="overline" FontSize="10" />
          <CheckBox IsChecked="{Binding SelectedCell.KeyAvailable}" />
        </StackPanel>
        
        <!-- Close button -->
        <Button Content="FERTIG" Command="{Binding CloseEditorCommand}" />
      </StackPanel>
    </Border>

    <!-- Matrix -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding HasBuildings}">
      <StackPanel>
        <!-- Column headers -->
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="88,0,0,4">
          <ItemsControl ItemsSource="{Binding ApartmentLabels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border MinWidth="140">
                  <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding MatrixRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FloorRowViewModel">
            <Grid ColumnDefinitions="80,Auto,*">
              <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DwellingCellViewModel">
                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                            Command="{Binding OpenEditorCommand}">
                      <Border MinWidth="140" CornerRadius="4"
                              Background="{Binding StatusBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding CoDisplay}" FontSize="11" FontWeight="SemiBold"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding StatusBrush, Converter={x:Static conv:StatusToForegroundValueConverter.Instance}}" />
                          <TextBlock Text="{Binding ResidentName}" FontSize="9" HorizontalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" MaxWidth="90"
                                     Foreground="{Binding StatusBrush, Converter={x:Static conv:StatusToForegroundValueConverter.Instance}}" />
                          <TextBlock Text="{Binding KeyDisplay}" FontSize="10" HorizontalAlignment="Center"
                                     Foreground="{Binding StatusBrush, Converter={x:Static conv:StatusToForegroundValueConverter.Instance}}" />
                        </StackPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Grid.Column="2" Text="{Binding Description}"
                         VerticalAlignment="Center" Margin="8,0,0,0"
                         Width="200" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</UserControl>
