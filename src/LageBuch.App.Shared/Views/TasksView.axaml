<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             x:Class="LageBuch.App.Shared.Views.TasksView"
             x:DataType="vm:TasksViewModel">
  <UserControl.Styles>
    <!-- Orientation as a Style, never Orientation="Horizontal" on the panel: a local value in
         XAML outranks a Style setter, so the narrow query below could not turn the dock upright
         and every field stayed on one squeezed line. A StackPanel rather than a WrapPanel because
         a vertical WrapPanel flows into columns; a vertical StackPanel gives one field per line
         and constrains each to the panel's width, which is what makes Width=NaN fill it. -->
    <Style Selector="StackPanel#DockFields">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="TextBlock.prio-high">
      <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.prio-medium">
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>
    <Style Selector="TextBlock.prio-low">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.due">
      <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Wide defaults as Styles, not Width= on the controls: a local value in XAML outranks a
         Style setter, so the narrow query below could never widen them. -->
    <Style Selector="StackPanel#EditFields">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="AutoCompleteBox#AssigneeBox, AutoCompleteBox#EditAssigneeBox">
      <Setter Property="Width" Value="150" />
    </Style>
    <Style Selector="TextBox#TimerBox">
      <Setter Property="Width" Value="70" />
    </Style>
    <Style Selector="TextBox#TaskNewTextBox, TextBox#EditTextBox">
      <Setter Property="Width" Value="320" />
    </Style>

    <!-- The narrow layout, keyed off the workspace's container. -->
    <ContainerQuery Name="Workspace" Query="max-width:640">
      <Style Selector="StackPanel#DockFields, StackPanel#EditFields">
        <Setter Property="Orientation" Value="Vertical" />
      </Style>
      <!-- The bottom bar already says AUFGABEN; the heading would only cost the filters room. -->
      <Style Selector="TextBlock#TasksTitle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border#TasksGridPanel">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border#TasksCardPanel">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <!-- The segments share the width out evenly (UniformGrid) and grow to a thumb's height. -->
      <Style Selector="ListBox.triage">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="ListBox.triage Border.seg">
        <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
      </Style>
      <Style Selector="AutoCompleteBox#AssigneeBox, AutoCompleteBox#EditAssigneeBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="TextBox#TimerBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="TextBox#TaskNewTextBox, TextBox#EditTextBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="HeaderedContentControl.field">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="Button.dock-action">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Grid.Column="0" x:Name="TasksTitle" Text="AUFGABEN" Classes="overline" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <RadioButton x:Name="TaskFilterOpen" GroupName="taskFilter" Content="OFFEN"
                     IsChecked="{Binding IsOpenFilter, Mode=TwoWay}" Margin="0,0,4,0" />
        <RadioButton x:Name="TaskFilterDone" GroupName="taskFilter" Content="ERLEDIGT"
                     IsChecked="{Binding IsDoneFilter, Mode=TwoWay}" Margin="0,0,4,0" />
        <RadioButton x:Name="TaskFilterAll" GroupName="taskFilter" Content="ALLE"
                     IsChecked="{Binding IsAllFilter, Mode=TwoWay}" />
      </StackPanel>
    </Grid>

    <!-- The phone's way in to the dock, at the bottom edge where the thumb already is. -->
    <Button DockPanel.Dock="Bottom" x:Name="OpenComposerButton" Classes="signal"
            Margin="0,12,0,0" HorizontalAlignment="Stretch"
            Height="{StaticResource ControlHeightTouch}"
            Content="+ NEUE AUFGABE"
            IsVisible="{Binding ShowComposerButton}"
            Command="{Binding OpenComposerCommand}" />

    <!-- Input dock. Enter submits from every field; focus then goes back to WICHTIGKEIT, the
         first field in reading order (#540). The view model keeps WICHTIGKEIT, DRINGLICHKEIT and
         ZUGETEILT between tasks, so Tab walks past them unchanged. -->
    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            IsVisible="{Binding ShowComposer}"
            b:EntryForm.SubmitCommand="{Binding AddTaskCommand}"
            b:EntryForm.FirstField="{Binding #ImportanceBox}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <!-- Scrolls so a focused field stays reachable once Android's AdjustResize has given the
           bottom of the window to the soft keyboard. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
        <!-- Only the phone's form needs a way back out; the wide dock is never in the way. -->
        <Grid x:Name="ComposerHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,4"
              IsVisible="{Binding IsNarrow}">
          <TextBlock Grid.Column="0" Text="NEUE AUFGABE" Classes="overline" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="CloseComposerButton" Classes="ghost"
                  AutomationProperties.Name="Eingabe schließen"
                  ToolTip.Tip="Eingabe schließen"
                  Command="{Binding CloseComposerCommand}">
            <PathIcon Width="13" Height="13"
                      Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
          </Button>
        </Grid>
        <StackPanel x:Name="DockFields" Spacing="12">
          <HeaderedContentControl Classes="field" Header="WICHTIGKEIT">
            <ListBox x:Name="ImportanceBox" Classes="triage" ItemsSource="{Binding ImportanceOptions}"
                     SelectedValue="{Binding NewImportance}" SelectedValueBinding="{Binding Value}"
                     AutomationProperties.Name="Wichtigkeit"
                     ItemTemplate="{StaticResource ImportanceSegment}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="DRINGLICHKEIT">
            <ListBox x:Name="UrgencyBox" Classes="triage" ItemsSource="{Binding UrgencyOptions}"
                     SelectedValue="{Binding NewUrgency}" SelectedValueBinding="{Binding Value}"
                     AutomationProperties.Name="Dringlichkeit"
                     ItemTemplate="{StaticResource UrgencySegment}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field suggest" Header="ZUGETEILT AN">
            <AutoCompleteBox x:Name="AssigneeBox" ItemsSource="{Binding AssigneeOptions}"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorNamePlaceholder}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             Text="{Binding NewAssignee}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="TIMER (MIN)"
                                    Classes.invalid="{Binding NewTimerMinutesError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBox x:Name="TimerBox" Text="{Binding NewTimerMinutes}" b:IntegerOnly.IsEnabled="True"
                     PlaceholderText="{x:Static md:AnonymizedExampleData.TimerMinutesPlaceholder}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field required" Header="AUFGABE"
                                    Classes.invalid="{Binding NewTextError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Freitext: kein Platzhalter, siehe #137 -->
            <TextBox x:Name="TaskNewTextBox" Text="{Binding NewText}" />
          </HeaderedContentControl>
          <Button x:Name="TaskAddButton" Classes="signal dock-action" Content="HINZUFÜGEN" Command="{Binding AddTaskCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </StackPanel>
        <!-- Was noch fehlt (#412): eine eigene Zeile, weil eine Meldung unter dem Feld
             selbst dieses so breit machen wuerde wie ihren Text und den Knopf aus dem
             Fenster schoebe. Die Felder sagen welche, diese Zeile sagt was. -->
        <TextBlock x:Name="DockErrorSummary" Classes="field-error"
                   Text="{Binding ErrorSummary}"
                   IsVisible="{Binding ErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Edit panel (#246): the dock's fields in the dock's place, filled from the row, shown
         only while a task is being corrected. Not inline cell editing: the grid keeps Wichtigkeit
         and Dringlichkeit in their colours, which is what it is read for. It keeps the overlay
         keyboard contract (#538) as an inline panel, as the ETB's does; closing hands focus back
         to the row's pencil. -->
    <Border DockPanel.Dock="Bottom" x:Name="TaskEditPanel" Margin="0,16,0,0"
            Background="#0F141D" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14"
            IsVisible="{Binding IsEditing}"
            b:Overlay.IsInline="True"
            b:Overlay.CancelCommand="{Binding CancelEditCommand}" b:Overlay.PrimaryCommand="{Binding SaveEditCommand}"
            b:Overlay.InitialFocus="{Binding #EditImportanceBox}" b:Overlay.FallbackFocus="{Binding #ImportanceBox}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="AUFGABE BEARBEITEN" Classes="overline" Margin="0,0,0,4" />
        <StackPanel x:Name="EditFields" Spacing="12">
          <HeaderedContentControl Classes="field" Header="WICHTIGKEIT">
            <ListBox x:Name="EditImportanceBox" Classes="triage" ItemsSource="{Binding ImportanceOptions}"
                     SelectedValue="{Binding EditImportance}" SelectedValueBinding="{Binding Value}"
                     AutomationProperties.Name="Wichtigkeit"
                     ItemTemplate="{StaticResource ImportanceSegment}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="DRINGLICHKEIT">
            <ListBox x:Name="EditUrgencyBox" Classes="triage" ItemsSource="{Binding UrgencyOptions}"
                     SelectedValue="{Binding EditUrgency}" SelectedValueBinding="{Binding Value}"
                     AutomationProperties.Name="Dringlichkeit"
                     ItemTemplate="{StaticResource UrgencySegment}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field suggest" Header="ZUGETEILT AN">
            <AutoCompleteBox x:Name="EditAssigneeBox" ItemsSource="{Binding AssigneeOptions}"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorNamePlaceholder}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             Text="{Binding EditAssignee}" />
          </HeaderedContentControl>
          <!-- The timer is not a field here: +5 MIN acts at once and the countdown beside it
               moves, so there is nothing to save and nothing to get wrong. -->
          <HeaderedContentControl Classes="field" Header="TIMER">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="EditRemaining" VerticalAlignment="Center" MinWidth="72"
                         Text="{Binding EditingTask.RemainingDisplay, FallbackValue=''}"
                         Classes.due="{Binding EditingTask.IsOverdue, FallbackValue=False}" />
              <Button x:Name="EditExtendTimerButton" Content="+5 MIN"
                      ToolTip.Tip="Timer um 5 Minuten verlängern"
                      Command="{Binding ExtendEditingTimerCommand}" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field required" Header="AUFGABE"
                                    Classes.invalid="{Binding EditTextError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Freitext: kein Platzhalter, siehe #137 -->
            <TextBox x:Name="EditTextBox" Text="{Binding EditText}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </HeaderedContentControl>
          <Button x:Name="SaveEditButton" Classes="signal dock-action" Content="SPEICHERN" Command="{Binding SaveEditCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
          <Button x:Name="CancelEditButton" Classes="dock-action" Content="ABBRECHEN" Command="{Binding CancelEditCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </StackPanel>
        <!-- Was noch fehlt (#412), as in the dock. -->
        <TextBlock x:Name="EditErrorSummary" Classes="field-error"
                   Text="{Binding EditErrorSummary}"
                   IsVisible="{Binding EditErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Panel>
    <Border x:Name="TasksGridPanel" Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <DataGrid x:Name="TasksGrid" b:RowKeys.IsEnabled="True" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedTask}"
                IsReadOnly="{Binding IsReadOnly}" CanUserSortColumns="False">
        <DataGrid.Columns>
          <!-- A live CheckBox rather than a DataGridCheckBoxColumn (#543): that column only toggles
               in edit mode, so ticking an Aufgabe off took F2, Space, Enter. Space on the row
               ticks it now, and the workspace offers it back for a few seconds. -->
          <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <CheckBox x:Name="TaskDoneBox" HorizontalAlignment="Center" MinWidth="0"
                          IsChecked="{Binding IsDone, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}"
                          b:RowKeys.Role="Toggle"
                          ToolTip.Tip="Erledigt (Leertaste)" AutomationProperties.Name="Aufgabe erledigt" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="WICHTIG" Width="120" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <TextBlock VerticalAlignment="Center" Margin="6,4" Text="{Binding ImportanceLabel}"
                           Classes.prio-high="{Binding IsImportanceHigh}"
                           Classes.prio-medium="{Binding IsImportanceMedium}"
                           Classes.prio-low="{Binding IsImportanceLow}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="DRINGL." Width="120" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <TextBlock VerticalAlignment="Center" Margin="6,4" Text="{Binding UrgencyLabel}"
                           Classes.prio-high="{Binding IsUrgencyHigh}"
                           Classes.prio-medium="{Binding IsUrgencyMedium}"
                           Classes.prio-low="{Binding IsUrgencyLow}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="TIMER" Width="110" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <TextBlock VerticalAlignment="Center" Margin="6,4" Text="{Binding RemainingDisplay}"
                           Classes.due="{Binding IsOverdue}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="ZUGETEILT AN" Binding="{Binding Assignee}" IsReadOnly="True" />
          <DataGridTemplateColumn Header="AUFGABE" Width="*" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <StackPanel Orientation="Vertical" Margin="6,4" Spacing="1">
                  <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CreatedDisplay}" Classes="overline" FontSize="9"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Enter or F2 on the row presses this (#543): the way into the edit panel (#246). -->
          <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <Button x:Name="TaskEditButton" Classes="icon-btn" HorizontalAlignment="Center"
                        Command="{Binding BeginEditCommand}" b:RowKeys.Role="Primary"
                        IsVisible="{Binding !IsDone}" ToolTip.Tip="Bearbeiten (Enter)"
                        AutomationProperties.Name="Aufgabe bearbeiten">
                  <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                </Button>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- The narrow layout: one card per task. The tick is a real touch target on the left, the
         task text is the body, and Wichtigkeit/Dringlichkeit/Timer keep the colours they carry in
         the grid — an overdue timer has to stay signal red wherever it is read. -->
    <Border x:Name="TasksCardPanel" Classes="narrow-only"
            Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="TasksCards" b:RowKeys.IsEnabled="True" ItemsSource="{Binding Rows}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskRow">
              <Border Classes="row-card">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Button Grid.Column="2" Classes="icon-btn card-action" VerticalAlignment="Top"
                          Command="{Binding BeginEditCommand}" b:RowKeys.Role="Primary"
                          IsVisible="{Binding !IsDone}" ToolTip.Tip="Bearbeiten (Enter)"
                          AutomationProperties.Name="Aufgabe bearbeiten">
                    <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                  </Button>
                  <CheckBox Grid.Column="0" VerticalAlignment="Top" MinWidth="0"
                            IsChecked="{Binding IsDone, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}"
                            b:RowKeys.Role="Toggle"
                            AutomationProperties.Name="Aufgabe erledigt" />
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="2">
                      <TextBlock Text="{Binding ImportanceLabel}"
                                 Classes.prio-high="{Binding IsImportanceHigh}"
                                 Classes.prio-medium="{Binding IsImportanceMedium}"
                                 Classes.prio-low="{Binding IsImportanceLow}" />
                      <TextBlock Text="{Binding UrgencyLabel}"
                                 Classes.prio-high="{Binding IsUrgencyHigh}"
                                 Classes.prio-medium="{Binding IsUrgencyMedium}"
                                 Classes.prio-low="{Binding IsUrgencyLow}" />
                      <TextBlock Text="{Binding RemainingDisplay}" Classes.due="{Binding IsOverdue}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Assignee}" Classes="secondary" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CreatedDisplay}" Classes="overline" FontSize="9"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    </Panel>
  </DockPanel>
</UserControl>
