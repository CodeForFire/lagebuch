<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             x:Class="LageBuch.App.Shared.Views.PdfExportOptionsView"
             x:DataType="vm:PdfExportOptionsViewModel">
  <Border Background="#B3070A10" Padding="40" Focusable="True" KeyDown="OnKeyDown">
    <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource OverlayShadow}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource SignalGradientBrush}"
                CornerRadius="12,12,0,0" />
        <StackPanel Margin="26,22,26,24" Spacing="10" IsEnabled="{Binding !IsBusy}">
          <TextBlock Text="PDF exportieren" Classes="display" FontSize="22" />
          <TextBlock Text="Welche Abschnitte sollen enthalten sein?" Classes="secondary" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PdfSectionOptionViewModel">
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,0,0,7" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="BusyBanner" Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource IncomingBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="10,8" Margin="0,8,0,0"
                  IsVisible="{Binding IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="⏳" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="PDF wird erstellt…" VerticalAlignment="Center" Classes="secondary" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="ABBRECHEN" Command="{Binding CancelCommand}" />
            <Button x:Name="ExportButton" Classes="signal" Content="EXPORTIEREN" Command="{Binding ExportCommand}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
