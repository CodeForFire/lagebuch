<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform sync layer: snapshot/command DTOs, the JSON mapper, the IIncidentSession
       abstraction, and the remote client. The SignalR/HTTP *client* is cross-platform (builds for
       the net8.0-android head too); only the Kestrel *server* is desktop-only, and it lives in the
       separate LageBuch.Sync.Hosting project. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LageBuch.Domain\LageBuch.Domain.csproj" />
  </ItemGroup>

  <!-- The reconcile pass (RemoteIncidentSession.ReconcileAsync) is internal so the tests can drive one
       deterministically instead of racing the poll timer. The client's tests live in the Hosting test
       project, because they need a real Kestrel host to talk to. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LageBuch.Sync.Hosting.Tests" />
  </ItemGroup>

</Project>
