<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v5 authoring for the Lagebuch MSI. Built in CI with:
    wix build packaging/windows/Lagebuch.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture de-DE -d Version=<v> -d PublishDir=<dir> -d IconFile=<ico> -d DocumentIconFile=<ico>
      -d BannerBmp=<bmp> -d DialogBmp=<bmp> -o out.msi

  The UpgradeCode is fixed forever: it is what lets a new version replace the old one instead of
  installing side by side. The ProductCode is auto-generated per build (Package/@Id defaults to "*").
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Lagebuch"
           Manufacturer="CodeForFire"
           Version="$(Version)"
           UpgradeCode="a03eaa1b-3d77-4ff0-a60a-5abe27c27b18"
           Scope="perMachine"
           Compressed="yes">

    <!--
      Block a downgrade with a clear message rather than a confusing installer error.

      AllowSameVersionUpgrades is what lets the final 0.6.0 replace a 0.6.0-beta.N install: the
      beta's ProductVersion is the numeric core (0.6.0), identical to the final's, and without this
      the two would sit side by side in Programs and Features. The documented cost is that it also
      permits a downgrade between builds whose first three version fields match — i.e. reinstalling
      a beta over the matching final, which is exactly what a tester who needs to go back wants.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Eine neuere Version von Lagebuch ist bereits installiert." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="LagebuchIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="LagebuchIcon" />

    <!-- Install into Program Files\Lagebuch. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Lagebuch" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- On by default; DESKTOPSHORTCUT=0 on the msiexec command line leaves the desktop alone. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" />

    <Feature Id="Main">
      <!-- Auto-harvest the entire published output into INSTALLFOLDER (WiX v5's heat replacement). -->
      <Files Include="$(PublishDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="FileAssociation" />
    </Feature>

    <!--
      Start-menu and desktop shortcut. A shortcut component needs its own keypath, hence the HKCU
      values. Windows offers no way for an installer to pin an unpackaged app to the taskbar or to
      Start's pinned area; what it can do is put Lagebuch where it is seen and start it at the end
      (see the UI below), so the Lagebuchführer pins the running window once.

      System.AppUserModel.ID is the ID the app claims for itself at startup
      (WindowsAppIdentity.UserModelId; WindowsAppIdentityTests holds the two together). With it, a
      pin made from the running window and these shortcuts are the same app on the taskbar.
    -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
      <Shortcut Id="LagebuchShortcut"
                Name="Lagebuch"
                Description="Einsatzdokumentation für die Feuerwehr"
                Target="[INSTALLFOLDER]LageBuch.App.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="LagebuchIcon">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="CodeForFire.Lagebuch" />
      </Shortcut>
      <RegistryValue Root="HKCU" Key="Software\CodeForFire\Lagebuch"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*" Condition="DESKTOPSHORTCUT = 1">
      <Shortcut Id="LagebuchDesktopShortcut"
                Name="Lagebuch"
                Description="Einsatzdokumentation für die Feuerwehr"
                Target="[INSTALLFOLDER]LageBuch.App.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="LagebuchIcon">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="CodeForFire.Lagebuch" />
      </Shortcut>
      <RegistryValue Root="HKCU" Key="Software\CodeForFire\Lagebuch"
                     Name="desktopshortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      Installer UI: Welcome, ready to install, progress, finish - WixUI_Minimal without its licence
      page, wired the way WixUI_Minimal wires its own dialogs. The finish page offers to start
      Lagebuch, ticked by default. A quiet install (winget, msiexec /qn) shows no UI and so starts
      nothing. -culture de-DE gives the stock dialogs their German text.

      WixShellExec runs from the finish dialog, i.e. in the non-elevated client process, so
      Lagebuch starts as the Lagebuchführer, not as the elevated installer.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Lagebuch jetzt starten" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Set in the UI sequence, where the finish dialog runs it, once INSTALLFOLDER is resolved;
         a <Property> value cannot reference another property (WIX1077). -->
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]LageBuch.App.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchLagebuch" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- Lagebuch's own artwork in place of WiX's placeholders; make-installer-bitmaps.sh renders
         both from the app icon. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(DialogBmp)" />

    <UI Id="LagebuchUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLagebuch" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <UIRef Id="WixUI_Common" />

    <!--
      Einsatzdateien open in Lagebuch on a double-click and show their own document icon. .lagebuch
      is what the app saves; .fwincident is what it saved before, and stays registered so an
      Einsatz from an older version still opens the same way. Both share one ProgId and so one
      icon and one open command.

      The ProgId is not advertised, so WiX writes it as plain registry values under
      HKLM\Software\Classes (perMachine) that this component owns and uninstall removes. The verb
      has to name the exe through a property: <Files> harvests the exe without an Id that a
      TargetFile could reference.
    -->
    <Component Id="FileAssociation" Directory="INSTALLFOLDER" Guid="*">
      <File Id="DocumentIcon" Source="$(DocumentIconFile)" Name="lagebuch-document.ico" KeyPath="yes" />
      <ProgId Id="Lagebuch.Einsatz" Description="Lagebuch-Einsatz" Icon="DocumentIcon" IconIndex="0">
        <Extension Id="lagebuch" ContentType="application/x-lagebuch">
          <Verb Id="open" TargetProperty="LAGEBUCHEXE" Argument="&quot;%1&quot;" />
        </Extension>
        <!-- No verb and no ContentType of its own: the verb lives on the ProgId and the MIME
             type's Extension value names one extension, so declaring either again writes the
             same registry value twice (WIX0091). Pointing at the ProgId is all it needs. -->
        <Extension Id="fwincident" />
      </ProgId>
    </Component>
    <SetProperty Id="LAGEBUCHEXE" Value="[INSTALLFOLDER]LageBuch.App.exe" After="CostFinalize" Sequence="execute" />
  </Package>
</Wix>
