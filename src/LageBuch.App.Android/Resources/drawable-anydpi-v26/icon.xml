<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon from API 26: an adaptive icon, so the launcher masks it to its own shape
     instead of shrinking the square PNG onto a plate. The <monochrome> layer is what Android 13+
     tints when the user turns on themed icons; without it the icon keeps its own colours.
     Below API 26 the same name resolves to drawable/icon.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/icon_background" />
  <foreground android:drawable="@drawable/icon_foreground" />
  <monochrome android:drawable="@drawable/icon_monochrome" />
</adaptive-icon>
