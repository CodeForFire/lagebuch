<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             x:Class="LageBuch.App.Shared.Views.TasksView"
             x:DataType="vm:TasksViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.prio-high">
      <Setter Property="Foreground" Value="#FF3D2E" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.prio-medium">
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>
    <Style Selector="TextBlock.prio-low">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.due">
      <Setter Property="Foreground" Value="#FF3D2E" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Grid.Column="0" Text="AUFGABEN" Classes="overline" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <RadioButton x:Name="TaskFilterOpen" GroupName="taskFilter" Content="OFFEN"
                     IsChecked="{Binding IsOpenFilter, Mode=TwoWay}" Margin="0,0,4,0" />
        <RadioButton x:Name="TaskFilterDone" GroupName="taskFilter" Content="ERLEDIGT"
                     IsChecked="{Binding IsDoneFilter, Mode=TwoWay}" Margin="0,0,4,0" />
        <RadioButton x:Name="TaskFilterAll" GroupName="taskFilter" Content="ALLE"
                     IsChecked="{Binding IsAllFilter, Mode=TwoWay}" />
      </StackPanel>
    </Grid>

    <!-- Input dock -->
    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <HeaderedContentControl Classes="field" Header="WICHTIGKEIT">
          <ComboBox Width="110" ItemsSource="{Binding ImportanceOptions}"
                    SelectedValue="{Binding NewImportance}" SelectedValueBinding="{Binding Value}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ImportanceOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </HeaderedContentControl>
        <HeaderedContentControl Classes="field" Header="DRINGLICHKEIT">
          <ComboBox Width="130" ItemsSource="{Binding UrgencyOptions}"
                    SelectedValue="{Binding NewUrgency}" SelectedValueBinding="{Binding Value}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:UrgencyOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </HeaderedContentControl>
        <HeaderedContentControl Classes="field" Header="ZUGETEILT">
          <AutoCompleteBox Width="150" ItemsSource="{Binding AssigneeOptions}"
                           PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorNamePlaceholder}"
                           FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                           Text="{Binding NewAssignee}" b:EnterSubmit.Command="{Binding AddTaskCommand}" />
        </HeaderedContentControl>
        <HeaderedContentControl Classes="field" Header="TIMER (MIN)">
          <TextBox Width="70" Text="{Binding NewTimerMinutes}" b:IntegerOnly.IsEnabled="True"
                   PlaceholderText="{x:Static md:AnonymizedExampleData.TimerMinutesPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </HeaderedContentControl>
        <HeaderedContentControl Classes="field" Header="AUFGABE">
          <!-- Freitext: kein Platzhalter, siehe #137 -->
          <TextBox x:Name="TaskNewTextBox" Width="320" Text="{Binding NewText}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </HeaderedContentControl>
        <Button x:Name="TaskAddButton" Classes="signal" Content="HINZUFÜGEN" Command="{Binding AddTaskCommand}"
                VerticalAlignment="Bottom" Margin="0,0,0,1" />
      </StackPanel>
    </Border>

    <Border Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <DataGrid x:Name="TasksGrid" ItemsSource="{Binding Rows}" IsReadOnly="{Binding IsReadOnly}" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="" Width="44"
              Binding="{Binding IsDone, Mode=TwoWay}" />
          <!-- Editable like the input dock's ComboBoxes (#246); the color-coded classes still
               reflect the row's current value. -->
          <DataGridTemplateColumn Header="WICHTIG" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <ComboBox Margin="6,4" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsReadOnly}"
                          ItemsSource="{Binding ImportanceOptions}"
                          SelectedValue="{Binding Importance}" SelectedValueBinding="{Binding Value}"
                          Classes.prio-high="{Binding IsImportanceHigh}"
                          Classes.prio-medium="{Binding IsImportanceMedium}"
                          Classes.prio-low="{Binding IsImportanceLow}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportanceOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="DRINGL." Width="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <ComboBox Margin="6,4" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsReadOnly}"
                          ItemsSource="{Binding UrgencyOptions}"
                          SelectedValue="{Binding Urgency}" SelectedValueBinding="{Binding Value}"
                          Classes.prio-high="{Binding IsUrgencyHigh}"
                          Classes.prio-medium="{Binding IsUrgencyMedium}"
                          Classes.prio-low="{Binding IsUrgencyLow}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:UrgencyOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="TIMER" Width="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,4" VerticalAlignment="Center">
                  <TextBlock VerticalAlignment="Center" Text="{Binding RemainingDisplay}"
                             Classes.due="{Binding IsOverdue}" />
                  <!-- Quick "+5 min" action (#246); disabled once done or for a task created
                       without a timer via CanExtendTimer. -->
                  <Button Padding="6,2" FontSize="11" Content="+5"
                          IsVisible="{Binding !IsReadOnly}"
                          Command="{Binding ExtendTimerCommand}"
                          ToolTip.Tip="5 Minuten hinzufügen" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- AutoCompleteBox like the input dock's ZUGETEILT field (#246): callsigns/Funktionen/
               personnel suggest, anything else stays free text. -->
          <DataGridTemplateColumn Header="ZUGETEILT" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <AutoCompleteBox Margin="6,4" IsEnabled="{Binding !IsReadOnly}"
                                 ItemsSource="{Binding AssigneeOptions}"
                                 FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                 Text="{Binding Assignee, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="AUFGABE" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <StackPanel Orientation="Vertical" Margin="6,4" Spacing="1">
                  <!-- Committing per keystroke would rewrite the whole incident file on every
                       character (#33 precedent) -- LostFocus pushes once, on leaving the field. -->
                  <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           IsEnabled="{Binding !IsReadOnly}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CreatedDisplay}" Classes="overline" FontSize="9"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
