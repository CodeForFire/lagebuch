<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             x:Class="LageBuch.App.Shared.Views.TaskDialogView"
             x:DataType="vm:TaskDialogViewModel">
  <Border Background="#B3070A10" Padding="40">
    <Border x:Name="TaskDialogCard" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource OverlayShadow}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource SignalGradientBrush}"
                CornerRadius="12,12,0,0" />
        <StackPanel Margin="26,22,26,24" Spacing="12">
          <TextBlock Text="TASK ERSTELLEN" Classes="display" FontSize="20" />
          <HeaderedContentControl Classes="field" Header="AUFGABE">
            <!-- Freitext: kein Platzhalter, siehe #137 -->
            <TextBox x:Name="TaskDialogText" Text="{Binding Text}" AcceptsReturn="False" />
          </HeaderedContentControl>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
            <HeaderedContentControl Grid.Column="0" Classes="field" Header="WICHTIGKEIT">
              <ComboBox Width="100" ItemsSource="{Binding ImportanceOptions}"
                        SelectedValue="{Binding Importance}" SelectedValueBinding="{Binding Value}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ImportanceOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Classes="field" Header="DRINGLICHKEIT">
              <ComboBox Width="110" ItemsSource="{Binding UrgencyOptions}"
                        SelectedValue="{Binding Urgency}" SelectedValueBinding="{Binding Value}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:UrgencyOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="2" Classes="field" Header="TIMER (MIN)">
              <TextBox Width="60" Text="{Binding TimerMinutes}" b:IntegerOnly.IsEnabled="True"
                       PlaceholderText="{x:Static md:AnonymizedExampleData.TimerMinutesPlaceholder}" />
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="3" Classes="field" Header="ZUGETEILT">
              <AutoCompleteBox ItemsSource="{Binding AssigneeOptions}"
                               PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorNamePlaceholder}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                               Text="{Binding Assignee}" />
            </HeaderedContentControl>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="TaskDialogCancelButton" Content="ABBRECHEN" Command="{Binding CancelCommand}" />
            <Button x:Name="TaskDialogSaveMoreButton" Classes="ghost"
                    Content="SPEICHERN &amp; WEITEREN TASK" Command="{Binding SaveAndCreateAnotherCommand}" />
            <Button x:Name="TaskDialogSaveButton" Classes="signal" Content="SPEICHERN"
                    Command="{Binding SaveCommand}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
