<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             x:Class="LageBuch.App.Shared.Views.MasterDataEditorView"
             x:DataType="vm:MasterDataEditorViewModel">
  <!-- Its own container rather than the shell's: this view is hosted directly by the render
       tests as well as by MainView, and a rail that only collapses when MainView happens to be
       its parent is a rail whose phone layout nothing can check. A 220px rail beside the detail
       leaves ~150px of editor on a 412dp phone, so below the breakpoint the two become a
       drill-down — the rail is the screen until a category is picked, and ← KATEGORIEN comes back
       to it. Wide windows keep both side by side exactly as before. -->
  <UserControl.Styles>
    <Style Selector="DockPanel#EditorBody">
      <Setter Property="Margin" Value="28,24" />
    </Style>
    <Style Selector="Border#CategoryRail">
      <Setter Property="Width" Value="220" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <!-- Grid.Column as a Style, not an attribute: a local value outranks a Style setter, so with
         Grid.Column="1" on the panel the narrow query could move it down a row but never out of
         the Auto column that was squeezing the title to nothing. -->
    <Style Selector="WrapPanel#EditorActions">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>

    <!-- Personal rows: the wide grid by default, the stacked phone form only inside the query.
         Style setters, not IsVisible attributes, or the query could never swap them. -->
    <Style Selector="Grid.person-narrow">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <ContainerQuery Name="Editor" Query="max-width:640">
      <Style Selector="Grid.person-wide">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Grid.person-narrow">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="Grid#PersonnelHeader">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="DockPanel#EditorBody">
        <Setter Property="Margin" Value="12,16" />
      </Style>
      <!-- Whichever of the two is on screen gets the whole width: the rail by spanning both
           columns, the detail because the hidden rail's Auto column measures zero. -->
      <Style Selector="Border#CategoryRail">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
      <Style Selector="Button#BackToCategoriesButton">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="TextBlock#EditorTitle">
        <Setter Property="FontSize" Value="20" />
      </Style>
      <!-- An Auto column never shrinks, so the four actions ran off the right edge rather than
           wrapping. On a phone they take a row of their own under the title. -->
      <Style Selector="WrapPanel#EditorActions">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,10,0,0" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <Panel Container.Name="Editor" Container.Sizing="Width">
    <DockPanel x:Name="EditorBody">
      <!-- Header -->
      <Grid x:Name="EditorHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto" Margin="0,0,0,18">
        <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemSpacing="12" LineSpacing="6" VerticalAlignment="Center">
          <TextBlock x:Name="EditorTitle" Text="STAMMDATEN" Classes="display" FontSize="26" />
          <Border x:Name="DirtyDot" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                  Background="#241608" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                  Padding="8,3" IsVisible="{Binding IsDirty}">
            <TextBlock Text="Nicht gespeichert" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource AmberBrush}" />
          </Border>
          <Border x:Name="FileErrorBanner" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                  Background="#2A1013" BorderBrush="#F87171" BorderThickness="1" Padding="8,3"
                  IsVisible="{Binding FileError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding FileError}" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" />
          </Border>
          <!-- Hinweis, kein Fehler: Wachen/Funkrufnamen aus einer älteren Datei, zu denen kein
               Fahrzeug und keine Person gehört, werden nicht übernommen und hier benannt. -->
          <Border x:Name="FileNoticeBanner" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                  Background="#241608" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" Padding="8,3"
                  IsVisible="{Binding FileNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding FileNotice}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" MaxWidth="520" />
          </Border>
          <!-- Fahrzeuge sind eindeutig (#76 follow-up): doppelte Funkrufnamen blockieren das
               Speichern, die Meldung nennt die Konflikte. -->
          <Border x:Name="VehicleConflictsBanner" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                  Background="#2A1013" BorderBrush="#F87171" BorderThickness="1" Padding="8,3"
                  IsVisible="{Binding VehicleConflicts, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding VehicleConflicts}" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" />
          </Border>
          <!-- An address Lagebuch would refuse to open would be a dead button in the Kontakte tab.
               Same shape as the Funkrufname notice beside it: it names the person and blocks
               saving until the address is fixed. -->
          <Border x:Name="PersonnelConflictsBanner" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                  Background="#2A1013" BorderBrush="#F87171" BorderThickness="1" Padding="8,3"
                  IsVisible="{Binding PersonnelConflicts, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding PersonnelConflicts}" FontSize="11" FontWeight="SemiBold"
                       Foreground="#F87171" TextWrapping="Wrap" MaxWidth="520" />
          </Border>
        </WrapPanel>
        <WrapPanel x:Name="EditorActions" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
          <Button x:Name="ImportButton" Content="IMPORTIEREN" Command="{Binding ImportCommand}" />
          <Button x:Name="ExportButton" Content="EXPORTIEREN" Command="{Binding ExportCommand}" />
          <Button x:Name="DiscardButton" Content="VERWERFEN" Command="{Binding DiscardCommand}" />
          <Button x:Name="SaveButton" Classes="signal" Content="SPEICHERN" Command="{Binding SaveCommand}" />
        </WrapPanel>
      </Grid>

      <!-- Master-detail. Auto, not a literal 220: the rail's own width is a Style now, so a
           phone can widen it to the whole screen, and a hidden rail leaves an empty column. -->
      <Grid ColumnDefinitions="Auto,*">
        <Border x:Name="CategoryRail" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" Padding="6"
                IsVisible="{Binding ShowCategories}">
          <DockPanel>
            <!-- Docked outside the scroll region below. The Checklisten are the one part of this
                 rail a brigade can grow without bound, so an "add" button living at the end of
                 them would be the first thing to scroll out of reach on exactly the configuration
                 that needs it — and this rail also renders on the Android head. The hairline turns
                 the slack above the button into a footer rather than a gap. -->
            <!-- Button before the rule: a DockPanel gives the FIRST Dock="Bottom" child the
                 bottom-most strip, so declaring the rule first would draw it under the button. -->
            <Button x:Name="AddChecklistButton" DockPanel.Dock="Bottom"
                    Content="+ NEUE CHECKLISTE" HorizontalAlignment="Stretch"
                    Margin="0,6,0,0" Command="{Binding AddChecklistCommand}" />
            <Border DockPanel.Dock="Bottom" Height="1" Margin="0,8,0,0"
                    Background="{StaticResource HairlineBrush}" />

            <!-- ONE scroll region for the whole rail. Two lists in a 220px column each scrolling
                 themselves is how the Checklisten ended up with their own scrollbar for a single
                 entry, and a row clipped mid-card: whichever list lost the flexible row got a
                 ~90px viewport. Here both lists size to their content and this ScrollViewer does
                 all the scrolling.
                 It is load-bearing. The lists below are set to Disabled, which means they clip
                 rather than scroll — so if anything ever hands the rail a finite height without a
                 ScrollViewer (a MaxHeight, a fixed-height host), rows vanish silently. -->
            <ScrollViewer x:Name="RailScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <!-- Two groups, because the rail holds two kinds of thing: the app's own categories,
                   and the Checklisten this brigade wrote. Only the second is labelled — the screen
                   title already says what the first group is.
                   Both lists bind SelectedItem to the same SelectedSection; that property ignores a
                   null write, which is what stops the list without the selection from clearing it.
                   See MasterDataEditorViewModel.SelectedSection. -->
              <StackPanel>
                <!-- Disabled, not Hidden. Hidden leaves the list able to scroll, so it would
                     silently swallow the wheel, a touch pan and the BringIntoView that arrow-keying
                     raises, with no scrollbar to show where the content went. Disabled makes the
                     list's own PART_ScrollViewer report Extent == Viewport, so its wheel handler
                     early-outs without marking the event handled and RailScroll sees it, and
                     BringDescendantIntoView returns false for an offset that cannot move — which
                     is what lets the focused row scroll into view out here instead.
                     Note what actually gives each list its full height: the infinite constraint
                     from RailScroll plus the non-virtualizing panel below. Disabled is what stops
                     the list building a scrollable extent of its own. -->
                <ListBox x:Name="CategoryList"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         AutomationProperties.Name="Kategorien"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <!-- The default VirtualizingStackPanel sizes itself from the effective viewport,
                       which is empty on the first pass: it reports ~25px per item until a later
                       layout pass corrects it, wobbling on open and under-realizing rows in
                       headless render tests. It also leaves containers unrealized, and an
                       unrealized ListBoxItem cannot be brought into view. Both lists here are
                       short — eight fixed sections, and the handful of Checklisten a brigade
                       keeps — so neither needs virtualizing. -->
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditorSection">
                      <!-- ListBoxItem already pads 14,12; repeating the horizontal half made the
                           rail the only list in the app whose text starts 26px in instead of 20.
                           The vertical 4 stays: it keeps the row's hit target at 51px, above the
                           48dp touch-target minimum the Android head needs. -->
                      <TextBlock Text="{Binding Title}" Padding="0,4" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- Group heading: the HomeView idiom, an overline plus a hairline rule. -->
                <Grid ColumnDefinitions="Auto,*" Margin="6,10,6,8">
                  <TextBlock Grid.Column="0" Text="CHECKLISTEN" Classes="overline" FontSize="10"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="1" Height="1" Background="{StaticResource HairlineBrush}"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <!-- A brigade may keep none; that is an ordinary state, not an error. These two are
                     alternatives, never both: a collapsed control takes no space in a StackPanel,
                     so they no longer need to share a Grid row in order to overlap. -->
                <TextBlock x:Name="NoChecklistsText" Text="Noch keine Checkliste."
                           Classes="secondary" FontSize="12" TextWrapping="Wrap"
                           Margin="6,0" IsVisible="{Binding !Checklists.Count}" />

                <!-- Collapsed rather than left empty: an empty list is still a tab stop. -->
                <ListBox x:Name="ChecklistList"
                         ItemsSource="{Binding Checklists}"
                         SelectedItem="{Binding SelectedSection}"
                         AutomationProperties.Name="Checklisten"
                         IsVisible="{Binding Checklists.Count}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditorSection">
                      <TextBlock Text="{Binding Title}" Padding="0,4" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="#0C1119"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" Padding="16" ClipToBounds="True"
                IsVisible="{Binding ShowDetail}">
          <DockPanel>
          <!-- The way back out of a category on a phone. Hidden by default through the Style at
               the top of this file, never IsVisible="False" here: a local value would outrank the
               query that has to bring it back. -->
          <Button DockPanel.Dock="Top" x:Name="BackToCategoriesButton" Classes="ghost narrow-only"
                  HorizontalAlignment="Left" Margin="0,0,0,12"
                  Content="&#x2190; KATEGORIEN"
                  AutomationProperties.Name="Zurück zu den Kategorien"
                  Command="{Binding BackToCategoriesCommand}" />
          <ContentControl Content="{Binding SelectedSection}">
            <ContentControl.DataTemplates>

              <!-- Operational defaults (timers/durations) -->
              <DataTemplate x:DataType="vm:SettingsSection">
                <ScrollViewer>
                  <StackPanel Spacing="12" MaxWidth="440" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Rückmeldung an ILS – Erstmeldung nach" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding IlsReminderIntervalMinutes}"
                                     Minimum="1" Maximum="120" Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Min." Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Rückmeldung an ILS – Intervall" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding IlsReminderFollowUpIntervalMinutes}"
                                     Minimum="1" Maximum="120" Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Min." Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Rückzugsdruck" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding ReturnPressureBar}"
                                     Minimum="0" Maximum="400" Increment="5" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="bar" Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>

              <!-- String-list / checklist editor -->
              <DataTemplate x:DataType="vm:EditableListSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Column headers (#137): each row is unlabeled otherwise. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="{Binding ColumnHeader}" Classes="overline" FontSize="10" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MasterDataItem">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
                            <TextBox Grid.Column="0" Text="{Binding Value}" />
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="1" Classes="icon-btn" Margin="6,0,0,0" ToolTip.Tip="Nach oben"
                                    AutomationProperties.Name="Nach oben"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                            </Button>
                            <Button Grid.Column="2" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Nach unten"
                                    AutomationProperties.Name="Nach unten"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Button>
                            <Button Grid.Column="3" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Entfernen"
                                    AutomationProperties.Name="Entfernen"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Checkliste template editor (Aufbau/Abbau): text + mandatory, reorderable -->
              <DataTemplate x:DataType="vm:ChecklistTemplateSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />

                  <!-- The list's name. The overline keeps the context the rail label used to
                       carry when it read "Checkliste Aufbau" rather than just "Aufbau". Editing
                       here renames the rail entry and the Navigation row as you type. -->
                  <TextBlock DockPanel.Dock="Top" Text="CHECKLISTE" Classes="overline"
                             FontSize="10" Margin="0,0,0,4" />
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <TextBox Grid.Column="0" x:Name="ChecklistTitleBox" Text="{Binding Title}"
                             PlaceholderText="Name der Checkliste" Margin="0,0,8,0" />
                    <Button Grid.Column="1" x:Name="DeleteChecklistButton" Content="LÖSCHEN"
                            VerticalAlignment="Center"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteChecklistCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>

                  <!-- Column headers (#137): each row is unlabeled otherwise. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="TEXT" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="PFLICHT" Classes="overline" FontSize="10" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChecklistTemplateRow">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
                            <TextBox Grid.Column="0" Text="{Binding Text}" Margin="0,0,6,0" />
                            <CheckBox Grid.Column="1" Content="Pflicht" IsChecked="{Binding IsMandatory}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="2" Classes="icon-btn" Margin="0,0,0,0" ToolTip.Tip="Nach oben"
                                    AutomationProperties.Name="Nach oben"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                            </Button>
                            <Button Grid.Column="3" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Nach unten"
                                    AutomationProperties.Name="Nach unten"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Button>
                            <Button Grid.Column="4" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Entfernen"
                                    AutomationProperties.Name="Entfernen"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Navigation: the Einsatz sidebar's order and what it shows. Rows are derived
                   (the modules this build has, plus every Checkliste), so there is nothing to add
                   or remove here; only reorder, and switch on or off. -->
              <DataTemplate x:DataType="vm:NavigationSection">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="overline" FontSize="10" Margin="0,0,0,4"
                             Text="REITER IM EINSATZ" />
                  <TextBlock DockPanel.Dock="Top" Margin="0,0,0,14" TextWrapping="Wrap"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Text="Reihenfolge und Sichtbarkeit der Seitenleiste. Das ETB ist immer sichtbar." />
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavRow">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                      IsEnabled="{Binding CanHide}"
                                      ToolTip.Tip="Das ETB ist immer sichtbar."
                                      AutomationProperties.Name="Sichtbar"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="2" Classes="icon-btn" ToolTip.Tip="Nach oben"
                                    AutomationProperties.Name="Nach oben"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                            </Button>
                            <Button Grid.Column="3" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Nach unten"
                                    AutomationProperties.Name="Nach unten"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Links editor: name + URL + group (#518), reorderable -->
              <DataTemplate x:DataType="vm:LinksSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Column headers (#137): each row is unlabeled otherwise. The trailing columns
                       are fixed to the row's icon buttons for the reason given on the vehicles
                       header below: "Auto" would size to this Grid's own empty cells. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,28,32,32" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="NAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="URL" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="2" Text="GRUPPE" Classes="overline" FontSize="10"
                               ToolTip.Tip="Optional — gleichnamige Links stehen im Einsatz unter einer Überschrift" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkRow">
                          <Grid ColumnDefinitions="*,*,*,28,32,32" Margin="0,0,0,6">
                            <TextBox Grid.Column="0"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.LinkNamePlaceholder}"
                                     Text="{Binding Name}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.LinkUrlPlaceholder}"
                                     Text="{Binding Url}" Margin="0,0,6,0" />
                            <!-- Free text with the known groups as suggestions, like the vehicles'
                                 Wache: a new group is simply typed. -->
                            <Grid Grid.Column="2" Margin="0,0,6,0">
                              <AutoCompleteBox x:Name="LinkGroupBox"
                                               PlaceholderText="{x:Static md:AnonymizedExampleData.LinkGroupPlaceholder}"
                                               ItemsSource="{Binding GroupOptions}"
                                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                               Text="{Binding Group}" />
                              <!-- Chevron affordance (#259), see OperatorPromptView for rationale. -->
                              <PathIcon Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,9,0" IsHitTestVisible="False"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Grid>
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="3" Classes="icon-btn" Margin="0,0,0,0" ToolTip.Tip="Nach oben"
                                    AutomationProperties.Name="Nach oben"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                            </Button>
                            <Button Grid.Column="4" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Nach unten"
                                    AutomationProperties.Name="Nach unten"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Button>
                            <Button Grid.Column="5" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Entfernen"
                                    AutomationProperties.Name="Entfernen"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Vehicles editor (#76): Wache + Funkrufname + Sitzplätze, reorderable. -->
              <DataTemplate x:DataType="vm:VehiclesSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Column headers (#137): each row is unlabeled otherwise.
                       The trailing three columns use fixed widths matching the row template's
                       icon-btn buttons (28px, plus each subsequent button's 4px left margin) —
                       "Auto" would size to this Grid's own (empty) content instead of the row
                       template's buttons, leaving the header and row Grids to disagree on width
                       and dragging SITZPLÄTZE/ZF/EIGEN out of alignment with their columns. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,150,70,70,28,32,32" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="WACHE" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="FUNKRUFNAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="2" Text="SITZPLÄTZE" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="3" Text="ZF" Classes="overline" FontSize="10"
                               ToolTip.Tip="Zugführerfahrzeug" />
                    <TextBlock Grid.Column="4" Text="EIGEN" Classes="overline" FontSize="10"
                               ToolTip.Tip="Eigenes Fahrzeug" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VehicleRow">
                          <Grid ColumnDefinitions="*,*,150,70,70,28,32,32" Margin="0,0,0,6">
                            <!-- AutoCompleteBox statt ComboBox: Vorschläge aus den Stammdaten,
                                 aber Freitext bleibt möglich (Fremdwehren), wie im Kräfte-Dock. -->
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                              <AutoCompleteBox PlaceholderText="{x:Static md:AnonymizedExampleData.BrigadePlaceholder}"
                                               ItemsSource="{Binding WacheOptions}"
                                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                               Text="{Binding Wache}" />
                              <!-- Chevron affordance (#259), see OperatorPromptView for rationale. -->
                              <PathIcon Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,9,0" IsHitTestVisible="False"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,6,0">
                              <AutoCompleteBox PlaceholderText="{x:Static md:AnonymizedExampleData.CallSignPlaceholder}"
                                               ItemsSource="{Binding CallSignOptions}"
                                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                               Text="{Binding CallSign}" />
                              <PathIcon Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,9,0" IsHitTestVisible="False"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Grid>
                            <NumericUpDown Grid.Column="2" Width="90" Minimum="0" Maximum="99" Increment="1"
                                           FormatString="0" Value="{Binding Seats}" VerticalAlignment="Center" />
                            <!-- Marks a command vehicle (ELW/KdoW) that carries the Zugführer: unlike
                                 Officer/Mannschaft this is not seat-derived, so it needs its own flag. -->
                            <CheckBox Grid.Column="3" IsChecked="{Binding HasZugfuehrer}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Zugführerfahrzeug" />
                            <!-- Own vehicle or a neighbouring brigade's (#458). -->
                            <CheckBox Grid.Column="4" IsChecked="{Binding IsOwn}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Eigenes Fahrzeug"
                                      AutomationProperties.Name="Eigenes Fahrzeug" />
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="5" Classes="icon-btn" Margin="0,0,0,0" ToolTip.Tip="Nach oben"
                                    AutomationProperties.Name="Nach oben"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                            </Button>
                            <Button Grid.Column="6" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Nach unten"
                                    AutomationProperties.Name="Nach unten"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Button>
                            <Button Grid.Column="7" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Entfernen"
                                    AutomationProperties.Name="Entfernen"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Trupp-Typen editor (#398): the crew size and Einsatzzeit live on the row, so
                   renaming a type can no longer silently drop its rule. -->
              <DataTemplate x:DataType="vm:TruppTypesSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Fixed trailing widths matching the row template's icon-btn buttons, as in the
                       Fahrzeuge template above: "Auto" would size to this Grid's own empty content. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,110,150,28,32,32" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="TYP" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="STÄRKE" Classes="overline" FontSize="10"
                               ToolTip.Tip="Personen im Trupp: 2, oder 3 mit zweitem Truppmann" />
                    <TextBlock Grid.Column="2" Text="EINSATZZEIT" Classes="overline" FontSize="10"
                               ToolTip.Tip="Vorgeschlagene Einsatzzeit bei der Anmeldung" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TruppTypeRow">
                          <Grid ColumnDefinitions="*,110,150,28,32,32" Margin="0,0,0,6">
                            <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding Name}"
                                     PlaceholderText="Angriffstrupp" />
                            <!-- Bounds are bound, not written in: a Trupp has as many positions as
                                 TruppRole has, and the control must never drift from it. -->
                            <NumericUpDown Grid.Column="1" Width="90" Increment="1" FormatString="0"
                                           Minimum="{Binding MinMemberCount}"
                                           Maximum="{Binding MaxMemberCount}"
                                           Value="{Binding MemberCount}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="2" Width="110" Minimum="1" Increment="1"
                                           Maximum="{Binding MaxDurationLimitMinutes}"
                                           FormatString="0" Value="{Binding MaxDurationMinutes}"
                                           VerticalAlignment="Center" />
                            <!-- ReflectionBinding: see the Fahrzeuge template for why a compiled
                                 $parent path cannot resolve here. -->
                            <Button Grid.Column="3" Classes="icon-btn" ToolTip.Tip="Nach oben"
                                    AutomationProperties.Name="Nach oben"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                            </Button>
                            <Button Grid.Column="4" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Nach unten"
                                    AutomationProperties.Name="Nach unten"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Button>
                            <Button Grid.Column="5" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Entfernen"
                                    AutomationProperties.Name="Entfernen"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Funktionen editor (#470): a row is a name plus how often the Funktion may be
                   held, so this is a typed section rather than the plain name list — the mode used
                   to be dropped on load and defaulted again on save. -->
              <DataTemplate x:DataType="vm:RolesSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Fixed trailing widths matching the row template's icon-btn buttons, as in the
                       Trupp-Typen template above: "Auto" would size to this Grid's own empty content. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,180,28,32,32" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="ROLLE" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="EINDEUTIGKEIT" Classes="overline" FontSize="10"
                               ToolTip.Tip="Wie oft die Funktion besetzt werden darf" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoleRow">
                          <Grid ColumnDefinitions="*,180,28,32,32" Margin="0,0,0,6">
                            <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding Name}"
                                     PlaceholderText="Einsatzleiter" />
                            <!-- Options rather than bare ComboBoxItems: an enum cannot be matched
                                 against a ComboBoxItem's content text, so SelectedItem would have
                                 nothing to select and the picker would render blank. The item
                                 template carries the German label, the way the Aufgaben dialog's
                                 Wichtigkeit picker does. -->
                            <ComboBox Grid.Column="1" ItemsSource="{Binding UniquenessOptions}"
                                      SelectedValue="{Binding Uniqueness}"
                                      SelectedValueBinding="{Binding Value}"
                                      AutomationProperties.Name="Eindeutigkeit">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:UniquenessOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- ReflectionBinding: see the Fahrzeuge template for why a compiled
                                 $parent path cannot resolve here. -->
                            <Button Grid.Column="2" Classes="icon-btn" ToolTip.Tip="Nach oben"
                                    AutomationProperties.Name="Nach oben"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                            </Button>
                            <Button Grid.Column="3" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Nach unten"
                                    AutomationProperties.Name="Nach unten"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                            </Button>
                            <Button Grid.Column="4" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Entfernen"
                                    AutomationProperties.Name="Entfernen"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Personnel editor -->
              <DataTemplate x:DataType="vm:PersonnelSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Column headers (#137): each field is unlabeled otherwise, and a PlaceholderText
                       disappears once the field is filled. Two lines, because each person takes two:
                       a seventh and eighth column would run off the right edge of a narrow window
                       (#146). The grid is the card's own, column for column, and the margin is the
                       card's padding plus its border, so every label sits over its field. -->
                  <Grid x:Name="PersonnelHeader" DockPanel.Dock="Top" Margin="13,0,13,6"
                        ColumnDefinitions="*,*,110,120,150,70,28" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock Grid.Column="0" Text="NACHNAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="VORNAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="2" Text="ROLLE" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="3" Text="RUFNAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="4" Text="TELEFON" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="5" Text="EIGEN" Classes="overline" FontSize="10"
                               ToolTip.Tip="Eigenes Personal" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="E-MAIL"
                               Classes="overline" FontSize="10" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Text="NOTIZ / ZUSTÄNDIGKEIT"
                               Classes="overline" FontSize="10" />
                  </Grid>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonRow">
                          <!-- One card per person, so the two lines read as one entry rather than as
                               four loose rows of boxes. -->
                          <Border Classes="row-card">
                            <Panel>
                              <Grid Classes="person-wide" ColumnDefinitions="*,*,110,120,150,70,28"
                                    RowDefinitions="Auto,Auto" RowSpacing="6">
                                <TextBox Grid.Column="0" AutomationProperties.Name="Nachname"
                                         PlaceholderText="{x:Static md:AnonymizedExampleData.PersonLastNamePlaceholder}"
                                         Text="{Binding LastName}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" AutomationProperties.Name="Vorname"
                                         PlaceholderText="{x:Static md:AnonymizedExampleData.PersonFirstNamePlaceholder}"
                                         Text="{Binding FirstName}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="2" AutomationProperties.Name="Rolle"
                                         PlaceholderText="{x:Static md:AnonymizedExampleData.RolePlaceholder}"
                                         Text="{Binding Role}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="3" AutomationProperties.Name="Rufname"
                                         PlaceholderText="{x:Static md:AnonymizedExampleData.CallSignPlaceholder}"
                                         Text="{Binding CallSign}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="4" AutomationProperties.Name="Telefon"
                                         PlaceholderText="{x:Static md:AnonymizedExampleData.PhoneNumberPlaceholder}"
                                         Text="{Binding Phone}" Margin="0,0,6,0" />
                                <!-- Only own personnel are offered as Lagebuchführer (#458). -->
                                <CheckBox Grid.Column="5" IsChecked="{Binding IsOwn}"
                                          VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Eigenes Personal"
                                          AutomationProperties.Name="Eigenes Personal" />
                                <Button Grid.Column="6" Classes="icon-btn" ToolTip.Tip="Entfernen"
                                        AutomationProperties.Name="Entfernen"
                                        Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                        CommandParameter="{Binding}">
                                  <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </Button>
                                <!-- Two name columns wide, so an address is not cut off. -->
                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" AutomationProperties.Name="E-Mail"
                                         PlaceholderText="{x:Static md:AnonymizedExampleData.EmailPlaceholder}"
                                         Text="{Binding Email}" Margin="0,0,6,0" />
                                <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4"
                                         AutomationProperties.Name="Notiz / Zuständigkeit"
                                         PlaceholderText="{x:Static md:AnonymizedExampleData.PersonNotePlaceholder}"
                                         Text="{Binding Note}" Margin="0,0,6,0" />
                              </Grid>

                              <!-- The phone form of the same row: ColumnDefinitions is not a styled
                                   property, so the query cannot reshape the grid above and swaps in
                                   this stacked one instead, as ForcesView swaps its grid for cards.
                                   Every field carries its own label, since the header is gone. -->
                              <Grid Classes="person-narrow" ColumnDefinitions="*,*" ColumnSpacing="8"
                                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <HeaderedContentControl Grid.Row="0" Grid.Column="0" Classes="field" Header="NACHNAME">
                                  <TextBox Text="{Binding LastName}" AutomationProperties.Name="Nachname"
                                           PlaceholderText="{x:Static md:AnonymizedExampleData.PersonLastNamePlaceholder}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Row="0" Grid.Column="1" Classes="field" Header="VORNAME">
                                  <TextBox Text="{Binding FirstName}" AutomationProperties.Name="Vorname"
                                           PlaceholderText="{x:Static md:AnonymizedExampleData.PersonFirstNamePlaceholder}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Row="1" Grid.Column="0" Classes="field" Header="ROLLE">
                                  <TextBox Text="{Binding Role}" AutomationProperties.Name="Rolle"
                                           PlaceholderText="{x:Static md:AnonymizedExampleData.RolePlaceholder}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Row="1" Grid.Column="1" Classes="field" Header="RUFNAME">
                                  <TextBox Text="{Binding CallSign}" AutomationProperties.Name="Rufname"
                                           PlaceholderText="{x:Static md:AnonymizedExampleData.CallSignPlaceholder}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Row="2" Grid.ColumnSpan="2" Classes="field" Header="TELEFON">
                                  <TextBox Text="{Binding Phone}" AutomationProperties.Name="Telefon"
                                           PlaceholderText="{x:Static md:AnonymizedExampleData.PhoneNumberPlaceholder}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Row="3" Grid.ColumnSpan="2" Classes="field" Header="E-MAIL">
                                  <TextBox Text="{Binding Email}" AutomationProperties.Name="E-Mail"
                                           PlaceholderText="{x:Static md:AnonymizedExampleData.EmailPlaceholder}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Row="4" Grid.ColumnSpan="2" Classes="field"
                                                        Header="NOTIZ / ZUSTÄNDIGKEIT">
                                  <TextBox Text="{Binding Note}" TextWrapping="Wrap"
                                           AutomationProperties.Name="Notiz / Zuständigkeit"
                                           PlaceholderText="{x:Static md:AnonymizedExampleData.PersonNotePlaceholder}" />
                                </HeaderedContentControl>
                                <CheckBox Grid.Row="5" Grid.Column="0" IsChecked="{Binding IsOwn}"
                                          Content="Eigenes Personal" VerticalAlignment="Center" />
                                <Button Grid.Row="5" Grid.Column="1" Classes="icon-btn card-action" HorizontalAlignment="Right"
                                        ToolTip.Tip="Entfernen" AutomationProperties.Name="Entfernen"
                                        Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                        CommandParameter="{Binding}">
                                  <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </Button>
                              </Grid>
                            </Panel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

            </ContentControl.DataTemplates>
          </ContentControl>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>

    <!-- Discard-guard overlay, resolved by ViewLocator to ConfirmDialogView -->
    <ContentControl Content="{Binding PendingConfirm}"
                    IsVisible="{Binding PendingConfirm, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Panel>
</UserControl>
