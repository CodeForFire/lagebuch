<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LageBuch.Domain\LageBuch.Domain.csproj" />
    <ProjectReference Include="..\LageBuch.Sync\LageBuch.Sync.csproj" />
    <ProjectReference Include="..\LageBuch.Persistence\LageBuch.Persistence.csproj" />
  </ItemGroup>
  <!-- No reference to LageBuch.Documents here: it pulls in QuestPDF, which doesn't support Android
       (QuestPDF/QuestPDF#1432) and only produced build warnings there (issue #184). PDF rendering is
       reached through IIncidentPdfExporter instead; only the desktop head (LageBuch.App) implements
       it with the real QuestPDF-backed exporter. -->

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LageBuch.AppLogic.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
