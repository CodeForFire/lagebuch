<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             x:Class="LageBuch.App.Shared.Views.TaskDialogView"
             x:DataType="vm:TaskDialogViewModel">
  <Border Background="#B3070A10" Padding="40">
    <Border x:Name="TaskDialogCard" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource OverlayShadow}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource SignalGradientBrush}"
                CornerRadius="12,12,0,0" />
        <StackPanel Margin="26,22,26,24" Spacing="12">
          <TextBlock Text="TASK ERSTELLEN" Classes="display" FontSize="20" />
          <TextBox x:Name="TaskDialogText" Watermark="Aufgabe" Text="{Binding Text}"
                   AcceptsReturn="False" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox Width="120" ItemsSource="{Binding ImportanceOptions}"
                      SelectedValue="{Binding Importance}" SelectedValueBinding="{Binding Value}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ImportanceOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Width="130" ItemsSource="{Binding UrgencyOptions}"
                      SelectedValue="{Binding Urgency}" SelectedValueBinding="{Binding Value}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:UrgencyOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Width="80" Watermark="MIN" Text="{Binding TimerMinutes}"
                     b:IntegerOnly.IsEnabled="True" />
            <AutoCompleteBox Width="170" Watermark="Zugeteilt" ItemsSource="{Binding AssigneeOptions}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             Text="{Binding Assignee}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="TaskDialogCancelButton" Content="ABBRECHEN" Command="{Binding CancelCommand}" />
            <Button x:Name="TaskDialogSaveMoreButton" Classes="ghost"
                    Content="SPEICHERN &amp; WEITEREN TASK" Command="{Binding SaveAndCreateAnotherCommand}" />
            <Button x:Name="TaskDialogSaveButton" Classes="signal" Content="SPEICHERN"
                    Command="{Binding SaveCommand}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
