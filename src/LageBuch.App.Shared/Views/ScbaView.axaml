<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             x:Class="LageBuch.App.Shared.Views.ScbaView"
             x:DataType="vm:ScbaViewModel">
  <UserControl.Styles>
    <!-- Field widths as Styles, not Width= on the controls: a local value in XAML outranks a
         Style setter, so the narrow query below could never widen them. -->
    <!-- The Druckkontrolle's answer to a press it could not record (#539): red for nothing to
         record, amber for a reading that is asked about once before it goes in. -->
    <Style Selector="TextBlock.pressureError">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.pressureWarning">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="NumericUpDown#PressureInput.invalid">
      <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="AutoCompleteBox#CallSignBox">
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector="ComboBox#TruppTypeBox">
      <Setter Property="Width" Value="150" />
    </Style>
    <Style Selector="AutoCompleteBox#TruppfuehrerBox">
      <Setter Property="Width" Value="170" />
    </Style>
    <Style Selector="AutoCompleteBox#TruppmannBox">
      <Setter Property="Width" Value="170" />
    </Style>
    <Style Selector="AutoCompleteBox#ZweiterTruppmannBox">
      <Setter Property="Width" Value="170" />
    </Style>

    <Style Selector="TextBlock.scbaStatus">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.scbaStatus.alarm">
      <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
    </Style>
    <Style Selector="TextBlock.scbaStatus.control">
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>
    <!-- WrapPanel has no ItemSpacing/LineSpacing in Avalonia 11, so the dock spaces its children. -->
    <Style Selector="WrapPanel#RegistrationDock > :is(Control)">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <!-- Field label inside a stacked cell. Small and dim so the value still reads first. -->
    <Style Selector="TextBlock.cellLabel">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- The narrow layout, keyed off the workspace's container. This grid is the widest in the
         app — its fixed columns alone total 1025px and it wants 1205px — so there is nothing to
         squeeze: a phone reads the same Trupps as cards. -->
    <ContainerQuery Name="Workspace" Query="max-width:640">
      <!-- Wide enough that only one fits a phone's content column, which is how a horizontal
           WrapPanel is told "one field per line". -->
      <Style Selector="AutoCompleteBox#CallSignBox">
        <Setter Property="Width" Value="356" />
      </Style>
      <Style Selector="ComboBox#TruppTypeBox">
        <Setter Property="Width" Value="356" />
      </Style>
      <Style Selector="AutoCompleteBox#TruppfuehrerBox">
        <Setter Property="Width" Value="356" />
      </Style>
      <Style Selector="AutoCompleteBox#TruppmannBox">
        <Setter Property="Width" Value="356" />
      </Style>
      <Style Selector="AutoCompleteBox#ZweiterTruppmannBox">
        <Setter Property="Width" Value="356" />
      </Style>
      <Style Selector="TextBlock#ScbaTitle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border#ScbaGridPanel">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border#ScbaCardPanel">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="WrapPanel#RegistrationDock > :is(Control)">
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style Selector="Button.dock-action">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="ScbaTitle" Text="ATEMSCHUTZÜBERWACHUNG" Classes="overline"
               Margin="0,0,0,14" VerticalAlignment="Center" />

    <!-- Registration dock: announce a Trupp on standby. The air clock starts later, via "UNTER PA".
         The next-pressure-control reminder lives in the global incident header so it's visible
         from every tab. -->
    <!-- The phone's way in to the dock. A Trupp under air is what must stay in sight, so the
         eight-field Bereitstellen form only appears when it is actually being filled in. -->
    <Button DockPanel.Dock="Bottom" x:Name="OpenComposerButton" Classes="signal"
            Margin="0,12,0,0" HorizontalAlignment="Stretch"
            Height="{StaticResource ControlHeightTouch}"
            Content="+ TRUPP BEREITSTELLEN"
            IsVisible="{Binding ShowComposerButton}"
            Command="{Binding OpenComposerCommand}" />

    <!-- Enter submits from every field; focus then goes back to FUNKRUFNAME (#540). -->
    <Border x:Name="InputDock" DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            IsVisible="{Binding ShowComposer}"
            b:EntryForm.SubmitCommand="{Binding AddTruppCommand}"
            b:EntryForm.FirstField="{Binding #CallSignBox}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <!-- Scrolls so a focused field stays reachable once Android's AdjustResize has given the
           bottom of the window to the soft keyboard. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
        <!-- Only the phone's form needs a way back out; the wide dock is never in the way. -->
        <Grid x:Name="ComposerHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,4"
              IsVisible="{Binding IsNarrow}">
          <TextBlock Grid.Column="0" Text="TRUPP BEREITSTELLEN" Classes="overline" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="CloseComposerButton" Classes="ghost"
                  AutomationProperties.Name="Eingabe schließen"
                  ToolTip.Tip="Eingabe schließen"
                  Command="{Binding CloseComposerCommand}">
            <PathIcon Width="13" Height="13"
                      Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
          </Button>
        </Grid>
        <WrapPanel x:Name="RegistrationDock" Orientation="Horizontal">
          <!-- Suggestion list, not a closed set: an ad-hoc or mutual-aid call sign must stay
               enterable, so this is an AutoCompleteBox rather than a ComboBox (#92). This is the
               vehicle/unit the Trupp rides with, hence leading the form (#78). -->
          <HeaderedContentControl Classes="field suggest" Header="FUNKRUFNAME">
            <AutoCompleteBox x:Name="CallSignBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.CallSignPlaceholder}"
                             ItemsSource="{Binding CallSignOptions}"
                             FilterMode="ContainsOrdinal"
                             MinimumPrefixLength="0"
                             Text="{Binding NewCallSign}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field required" Header="TRUPP-ART"
                                    Classes.invalid="{Binding NewDesignationError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ComboBox x:Name="TruppTypeBox" ItemsSource="{Binding TruppTypeOptions}"
                      SelectedItem="{Binding NewDesignation}" />
          </HeaderedContentControl>
          <!-- One box per position rather than a single free-text field: a Trupp is two people,
               or three where its Stammdaten-Eintrag says so, and the third box only appears when the
               selected Trupp-Typ calls for it (#398). Crew names
               use the ad-hoc "whoever is entering data right now" persona, not the Stammdaten roster
               persona (#137). -->
          <HeaderedContentControl Classes="field suggest required" Header="TRUPPFÜHRER"
                                    Classes.invalid="{Binding NewTruppfuehrerError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <AutoCompleteBox x:Name="TruppfuehrerBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorNamePlaceholder}"
                             ItemsSource="{Binding PersonOptions}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             Text="{Binding NewTruppfuehrer}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field suggest required" Header="TRUPPMANN"
                                    Classes.invalid="{Binding NewTruppmannError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <AutoCompleteBox x:Name="TruppmannBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorNamePlaceholderAlt}"
                             ItemsSource="{Binding PersonOptions}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             Text="{Binding NewTruppmann}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field suggest required" Header="2. TRUPPMANN" IsVisible="{Binding RequiresThirdMember}"
                                    Classes.invalid="{Binding NewZweiterTruppmannError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <AutoCompleteBox x:Name="ZweiterTruppmannBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorNamePlaceholderThird}"
                             ItemsSource="{Binding PersonOptions}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             Text="{Binding NewZweiterTruppmann}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field required" Header="EINSTIEGSDRUCK"
                                    Classes.invalid="{Binding NewEntryPressureError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="100" Minimum="1" Maximum="400" Value="{Binding NewEntryPressure}"
                             FormatString="0" />
              <TextBlock Text="bar" Classes="secondary" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="EINSATZZEIT">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- Maximum bound, not written in: it has to match the Stammdaten editor's own
                   Einsatzzeit spinner, or a Trupp-Typ configured above this could not be registered
                   at the Einsatzzeit its row specifies. -->
              <NumericUpDown Width="100" Minimum="1" Maximum="{Binding MaxDurationLimitMinutes}"
                             Value="{Binding NewMaxDurationMinutes}" FormatString="0" />
              <TextBlock Text="Min. max." Classes="secondary" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="ABFRAGE-INTERVALL">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="100" Minimum="1" Maximum="60" Value="{Binding NewControlIntervalMinutes}"
                             FormatString="0" />
              <TextBlock Text="Min. Abfrage" Classes="secondary" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedContentControl>
          <Button x:Name="AddTruppButton" Classes="signal dock-action" Content="BEREITSTELLEN" Command="{Binding AddTruppCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </WrapPanel>
        <!-- Was noch fehlt (#412): eine eigene Zeile, weil eine Meldung unter dem Feld
             selbst dieses so breit machen wuerde wie ihren Text und den Knopf aus dem
             Fenster schoebe. Die Felder sagen welche, diese Zeile sagt was. -->
        <TextBlock x:Name="DockErrorSummary" Classes="field-error"
                   Text="{Binding ErrorSummary}"
                   IsVisible="{Binding ErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Panel>
    <Border x:Name="ScbaGridPanel" Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <!-- Rows size to their content here, unlike the other grids. A Trupp is two people, or three
           where its Trupp-Typ calls for it, each on its own line, so the shared 40px RowHeight from
           Styles.axaml would clip the last crew member. -->
      <!-- x:Name + SelectedItem: a jump from the header's Atemschutz bars selects the Trupp in the
           view model and the code-behind scrolls this grid to it (#422). -->
      <DataGrid x:Name="TruppGrid" ItemsSource="{Binding Trupps}" IsReadOnly="True" CanUserSortColumns="False"
                SelectedItem="{Binding SelectedTrupp}"
                RowHeight="NaN">
        <DataGrid.Columns>
          <!-- Ten columns needed ~1460px and overflowed on a normal window, so related values are
               stacked into one cell each: Trupp over its call sign, the two clock values together,
               and current pressure over the next-check countdown, and the Sicherheitstrupp under
               the Trupp it belongs to. The fixed columns total 1025px and MANNSCHAFT adds its
               180px floor, so the grid wants 1205px and still fits a 1280px ELW screen — which is
               what the layout test pins. Fixed widths mean content growth can no longer squeeze
               the crew column, and an eighth column would have to buy its width from the crew or
               from the action buttons. -->
          <DataGridTemplateColumn Header="TRUPP" Width="190">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScbaTruppRow">
                <StackPanel VerticalAlignment="Center" Margin="12,6">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding CallSign}" Classes="mono" FontSize="11.5"
                             IsVisible="{Binding CallSign, Converter={x:Static ObjectConverters.IsNotNull}}"
                             TextTrimming="CharacterEllipsis" />
                  <!-- FwDV 7's Sicherheitstrupp (#399) stacks here rather than taking a column of
                       its own: eight columns already need every pixel of a 1280px ELW screen, and
                       the width for a ninth would have to come out of the crew or the action
                       buttons. Vertical space is the one thing this grid has spare — rows are
                       already two or three crew lines tall. A picker, not a label, because the
                       standby crew really is relieved and replaced mid-Einsatz; and the amber line
                       warns without ever blocking, exactly like RolesView's UnknownRoleHint. -->
                  <!-- A button and a Flyout, deliberately not a ComboBox. Designating a
                       Sicherheitstrupp writes to the incident, and that write comes straight back
                       through Changed to rebuild this row and its entries. A ComboBox does that
                       inside its own SelectionModel batch, which still holds indices into the list
                       being rebuilt — it crashed with an IndexOutOfRange out of EndBatchUpdate.
                       A command runs after the flyout has dismissed, with no selection model in
                       the picture. Same Button.Flyout idiom as ForcesView's Stärke editor. -->
                  <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="Si." Classes="cellLabel" />
                    <Button Grid.Column="1" x:Name="SafetyTruppButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="8,4" FontSize="12"
                            Content="{Binding SafetyTruppButtonText}"
                            IsEnabled="{Binding CanAssignSafetyTrupp}"
                            AutomationProperties.Name="Sicherheitstrupp wählen">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <ItemsControl ItemsSource="{Binding SafetyTruppChoices}" MinWidth="170">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:SafetyTruppChoice">
                                <Button Classes="ghost" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Padding="8,5"
                                        Command="{Binding SelectCommand}"
                                        ToolTip.Tip="{Binding Detail}">
                                  <Grid ColumnDefinitions="14,Auto,*" ColumnSpacing="6">
                                    <!-- The entry in force is marked rather than styled, so it
                                         still reads at a glance on the ELW's dimmed screen. -->
                                    <TextBlock Grid.Column="0" Text="✓" FontWeight="Bold"
                                               IsVisible="{Binding IsCurrent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Display}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                               Classes="cellLabel" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <TextBlock x:Name="SafetyTruppHintText" Text="{Binding SafetyTruppHint}"
                             FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"
                             TextWrapping="Wrap" IsVisible="{Binding HasSafetyTruppHint}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- MinWidth matters: this is the only star-sized column, so it absorbs every other
               column's content growth. Without a floor it collapses to the DataGrid's 20px
               minimum on a narrow window and the crew silently disappears. Scrolling the grid
               is the right trade-off; hiding who is under air is not. -->
          <DataGridTemplateColumn Header="MANNSCHAFT" Width="*" MinWidth="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScbaTruppRow">
                <ItemsControl ItemsSource="{Binding MemberLines}" VerticalAlignment="Center"
                              Margin="12,6" ToolTip.Tip="{Binding MembersDetail}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="ZEIT" Width="135">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScbaTruppRow">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                      VerticalAlignment="Center" Margin="12,6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Start" Classes="cellLabel" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StartTimeDisplay}" Classes="mono" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Einsatz" Classes="cellLabel" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElapsedDisplay}" Classes="mono" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Restzeit stays a column of its own and is alarm-coloured: it is the value that says
               whether the crew has to turn around now. -->
          <DataGridTemplateColumn Header="RESTZEIT" Width="125">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScbaTruppRow">
                <TextBlock Text="{Binding RemainingDisplay}" VerticalAlignment="Center" Margin="12,0"
                           FontWeight="SemiBold" Classes="scbaStatus" Classes.alarm="{Binding IsAlarm}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="DRUCK" Width="145">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScbaTruppRow">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                      VerticalAlignment="Center" Margin="12,6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="akt." Classes="cellLabel" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PressureDisplay}" Classes="mono" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Abfrage" Classes="cellLabel" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ControlRemainingDisplay}"
                             Classes="mono" Classes.control="{Binding IsControlDue}" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="STATUS" Width="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScbaTruppRow">
                <TextBlock Text="{Binding StatusDisplay}" VerticalAlignment="Center" Margin="12,0"
                           FontWeight="SemiBold" Classes="scbaStatus"
                           Classes.alarm="{Binding IsAlarm}" Classes.control="{Binding IsControlDue}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="AKTION" Width="300">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScbaTruppRow">
                <StackPanel Spacing="2" Margin="8,4" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Einstiegsdruck is captured at Bereitstellen now, so this is purely the
                         Druckkontrolle input while under air (Im Einsatz or Rückzug). Enter records
                         it like DRUCK (#539). ClipValueToMinMax is load-bearing: without it a typed
                         value above Maximum never reaches the binding, and the press recorded the
                         previous one; see CoMessprotokollView's CO-WERT for the same trap. -->
                    <NumericUpDown x:Name="PressureInput" Width="104" Minimum="0" Maximum="400"
                                   ClipValueToMinMax="True" Value="{Binding PressureInput}"
                                   FormatString="0" PlaceholderText="{Binding PressurePlaceholder}"
                                   AutomationProperties.Name="Druck in bar"
                                   Classes.invalid="{Binding HasPressureError}"
                                   b:EnterSubmit.Command="{Binding RecordPressureCommand}"
                                   IsEnabled="{Binding !IsReturned}" />
                    <Button Classes="signal" Content="IM EINSATZ" Command="{Binding StartCommand}"
                            IsVisible="{Binding IsWaiting}" />
                    <Button Content="DRUCK" Command="{Binding RecordPressureCommand}"
                            IsVisible="{Binding IsActive}" />
                    <Button Classes="signal" Content="RÜCKZUG" Command="{Binding WithdrawCommand}"
                            IsVisible="{Binding IsActive}" />
                    <Button Content="DRUCK" Command="{Binding RecordPressureCommand}"
                            IsVisible="{Binding IsWithdrawing}" />
                    <Button Classes="signal" Content="ABGENOMMEN" Command="{Binding MarkRemovedCommand}"
                            IsVisible="{Binding IsWithdrawing}" />
                  </StackPanel>
                  <TextBlock Classes="pressureError" Text="{Binding PressureError}"
                             IsVisible="{Binding HasPressureError}" />
                  <TextBlock Classes="pressureWarning" Text="{Binding PressureWarning}"
                             IsVisible="{Binding HasPressureWarning}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- The narrow layout: one card per Trupp. Restzeit is the hero — it is the number that says
         whether the crew has to turn around now — and keeps the alarm colouring it has in the
         grid. Everything else follows in the order it gets read out over the radio. -->
    <Border x:Name="ScbaCardPanel" Classes="narrow-only"
            Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ScbaCards" ItemsSource="{Binding Trupps}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ScbaTruppRow">
              <Border Classes="row-card">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Classes="scbaStatus"
                               Classes.alarm="{Binding IsAlarm}" Classes.control="{Binding IsControlDue}" />
                  </Grid>
                  <TextBlock Text="{Binding CallSign}" Classes="mono" FontSize="11.5"
                             IsVisible="{Binding CallSign, Converter={x:Static ObjectConverters.IsNotNull}}"
                             TextTrimming="CharacterEllipsis" />

                  <!-- The one value a Lagebuchführer looks for first. -->
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="RESTZEIT" Classes="overline" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding RemainingDisplay}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Medium"
                               Classes="scbaStatus" Classes.alarm="{Binding IsAlarm}" />
                  </Grid>

                  <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="2">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Start" Classes="cellLabel" />
                      <TextBlock Text="{Binding StartTimeDisplay}" Classes="mono" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Einsatz" Classes="cellLabel" />
                      <TextBlock Text="{Binding ElapsedDisplay}" Classes="mono" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="akt." Classes="cellLabel" />
                      <TextBlock Text="{Binding PressureDisplay}" Classes="mono" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Abfrage" Classes="cellLabel" />
                      <TextBlock Text="{Binding ControlRemainingDisplay}" Classes="mono"
                                 Classes.control="{Binding IsControlDue}" />
                    </StackPanel>
                  </WrapPanel>

                  <ItemsControl ItemsSource="{Binding MemberLines}" ToolTip.Tip="{Binding MembersDetail}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- FwDV 7's Sicherheitstrupp. Same command-driven flyout as the grid; no x:Name
                       here, because the grid's SafetyTruppButton is found by name in tests and a
                       second control answering to it would make that search ambiguous. -->
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="Si." Classes="cellLabel" />
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="8,4" FontSize="12"
                            Content="{Binding SafetyTruppButtonText}"
                            IsEnabled="{Binding CanAssignSafetyTrupp}"
                            AutomationProperties.Name="Sicherheitstrupp wählen">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <ItemsControl ItemsSource="{Binding SafetyTruppChoices}" MinWidth="170">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:SafetyTruppChoice">
                                <Button Classes="ghost" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Padding="8,5"
                                        Command="{Binding SelectCommand}"
                                        ToolTip.Tip="{Binding Detail}">
                                  <Grid ColumnDefinitions="14,Auto,*" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="✓" FontWeight="Bold"
                                               IsVisible="{Binding IsCurrent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Display}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                               Classes="cellLabel" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding SafetyTruppHint}"
                             FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"
                             TextWrapping="Wrap" IsVisible="{Binding HasSafetyTruppHint}" />

                  <!-- The Druckkontrolle input and whatever the Trupp's state allows next. -->
                  <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                    <NumericUpDown x:Name="PressureInput" Width="120" Minimum="0" Maximum="400"
                                   ClipValueToMinMax="True" Value="{Binding PressureInput}"
                                   FormatString="0" PlaceholderText="{Binding PressurePlaceholder}"
                                   AutomationProperties.Name="Druck in bar"
                                   Classes.invalid="{Binding HasPressureError}"
                                   b:EnterSubmit.Command="{Binding RecordPressureCommand}"
                                   IsEnabled="{Binding !IsReturned}" />
                    <Button Classes="signal" Content="IM EINSATZ" Command="{Binding StartCommand}"
                            IsVisible="{Binding IsWaiting}" />
                    <Button Content="DRUCK" Command="{Binding RecordPressureCommand}"
                            IsVisible="{Binding IsActive}" />
                    <Button Classes="signal" Content="RÜCKZUG" Command="{Binding WithdrawCommand}"
                            IsVisible="{Binding IsActive}" />
                    <Button Content="DRUCK" Command="{Binding RecordPressureCommand}"
                            IsVisible="{Binding IsWithdrawing}" />
                    <Button Classes="signal" Content="ABGENOMMEN" Command="{Binding MarkRemovedCommand}"
                            IsVisible="{Binding IsWithdrawing}" />
                  </WrapPanel>
                  <TextBlock Classes="pressureError" Text="{Binding PressureError}"
                             IsVisible="{Binding HasPressureError}" />
                  <TextBlock Classes="pressureWarning" Text="{Binding PressureWarning}"
                             IsVisible="{Binding HasPressureWarning}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    </Panel>
  </DockPanel>
</UserControl>
