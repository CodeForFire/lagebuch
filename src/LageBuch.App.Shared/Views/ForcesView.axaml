<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             x:Class="LageBuch.App.Shared.Views.ForcesView"
             x:DataType="vm:ForcesViewModel">
  <!-- Keyed off the workspace's container (IncidentWorkspaceView's root Panel); a query resolves
       its container by name anywhere below it. Field widths live in Styles rather than as Width=
       on the control, because a local value in XAML outranks a Style setter and the query could
       never widen it — one dock serves both layouts. -->
  <UserControl.Styles>
    <!-- Orientation as a Style, never Orientation="Horizontal" on the panel: a local value in
         XAML outranks a Style setter, so the narrow query below could not turn the dock upright
         and every field stayed on one squeezed line. A StackPanel rather than a WrapPanel because
         a vertical WrapPanel flows into columns; a vertical StackPanel gives one field per line
         and constrains each to the panel's width, which is what makes Width=NaN fill it. -->
    <Style Selector="StackPanel#DockFields">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <!-- The readout's size is a Style, not FontSize= on the TextBlocks, so the narrow query can
         shrink it; a local attribute would outrank the setter and silently win. -->
    <Style Selector="TextBlock#TotalStrengthPrefixText">
      <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="TextBlock#TotalStrengthGesamtText">
      <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="TextBlock#TotalScbaText">
      <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="ComboBox#VehicleBox">
      <Setter Property="Width" Value="190" />
    </Style>
    <Style Selector="TextBox#BrigadeBox">
      <Setter Property="Width" Value="160" />
    </Style>
    <Style Selector="TextBox#CallSignBox">
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector="TextBox#ScbaBox">
      <Setter Property="Width" Value="90" />
    </Style>
    <Style Selector="ComboBox#StatusBox">
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector="TextBox#NotesBox">
      <Setter Property="Width" Value="170" />
    </Style>

    <ContainerQuery Name="Workspace" Query="max-width:640">
      <Style Selector="StackPanel#DockFields">
        <Setter Property="Orientation" Value="Vertical" />
      </Style>
      <!-- The bottom bar already says KRÄFTE; dropping the heading gives the Gesamtstärke tile
           the whole line, which it needs at 388px. -->
      <Style Selector="TextBlock#ForcesTitle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="TextBlock#TotalStrengthPrefixText">
        <Setter Property="FontSize" Value="19" />
      </Style>
      <Style Selector="TextBlock#TotalStrengthGesamtText">
        <Setter Property="FontSize" Value="19" />
      </Style>
      <Style Selector="TextBlock#TotalScbaText">
        <Setter Property="FontSize" Value="19" />
      </Style>
      <Style Selector="Border#ForcesGridPanel">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border#ForcesCardPanel">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <!-- Explicit rather than NaN: a ComboBox does not stretch to fill its slot, and this one
           shares an inner row with the clear-selection button, so NaN leaves it the width of its
           longest Funkrufname. 300 fills the line and leaves the button its place. -->
      <Style Selector="ComboBox#VehicleBox">
        <Setter Property="Width" Value="300" />
      </Style>
      <Style Selector="TextBox#BrigadeBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="TextBox#CallSignBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="TextBox#ScbaBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="ComboBox#StatusBox">
        <Setter Property="Width" Value="356" />
      </Style>
      <Style Selector="TextBox#NotesBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="HeaderedContentControl.field">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="Button.dock-action">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Grid.Column="0" x:Name="ForcesTitle" Text="EINGESETZTE KRÄFTE" Classes="overline" VerticalAlignment="Top" />
      <!-- Total strength readout im ZF/GF/Mannschaft/Gesamt-Format (#76, #216), AGT-Anteil daneben.
           Gesamt is bold+underlined by binding it as a separate TextBlock after the plain prefix
           (see ForcesViewModel.TotalStrengthPrefixText); no Run/Inlines idiom exists here to bold
           part of one TextBlock's text. -->
      <Border Grid.Column="1" Background="#0F141D" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusMd}" Padding="18,8">
        <!-- A WrapPanel, not a StackPanel: the readout is ~380px wide and a phone's content column
             is 388, so on any smaller Stichwort or a landscape split it has to fall onto a second
             line rather than run off the edge. -->
        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="4" VerticalAlignment="Center">
          <TextBlock Text="GESAMTSTÄRKE" Classes="overline" FontSize="10" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <TextBlock x:Name="TotalStrengthPrefixText" Classes="metric"
                       Foreground="{StaticResource SignalBrush}" Text="{Binding TotalStrengthPrefixText}" />
            <TextBlock x:Name="TotalStrengthGesamtText" Classes="metric" FontWeight="Bold"
                       TextDecorations="Underline"
                       Foreground="{StaticResource SignalBrush}" Text="{Binding TotalPersonnel}" />
          </StackPanel>
          <Border Width="1" Background="{StaticResource HairlineBrush}" Margin="4,2" />
          <TextBlock Text="DAVON AGT" Classes="overline" FontSize="10" VerticalAlignment="Center" />
          <TextBlock x:Name="TotalScbaText" Classes="metric"
                     Foreground="{StaticResource SignalBrush}" Text="{Binding TotalScba}" />
        </WrapPanel>
      </Border>
    </Grid>

    <!-- The phone's way in to the dock, at the bottom edge where the thumb already is. -->
    <Button DockPanel.Dock="Bottom" x:Name="OpenComposerButton" Classes="signal"
            Margin="0,12,0,0" HorizontalAlignment="Stretch"
            Height="{StaticResource ControlHeightTouch}"
            Content="+ EINHEIT AUFNEHMEN"
            IsVisible="{Binding ShowComposerButton}"
            Command="{Binding OpenComposerCommand}" />

    <!-- Input dock -->
    <!-- Enter submits from every field, a closed FAHRZEUG included, so a vehicle is ↓ and Enter.
         Focus then goes back to FAHRZEUG; FEUERWEHR keeps its value for the next unit of the same
         Feuerwehr and is selected when Tab reaches it (#540). -->
    <Border x:Name="InputDock" DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            IsVisible="{Binding ShowComposer}"
            b:EntryForm.SubmitCommand="{Binding AddForceCommand}"
            b:EntryForm.FirstField="{Binding #VehicleBox}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <!-- The duplicate-callsign hint used to sit at the end of the horizontal fields row below,
           where a narrower-than-test-harness window would clip it; it now gets its own full-width
           line so it always has room to wrap instead. -->
      <!-- Scrolls so a focused field stays reachable once Android's AdjustResize has given the
           bottom of the window to the soft keyboard. Never scrolls on a wide window. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
        <!-- Only the phone's form needs a way back out; the wide dock is never in the way. -->
        <Grid x:Name="ComposerHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,4"
              IsVisible="{Binding IsNarrow}">
          <TextBlock Grid.Column="0" Text="EINHEIT AUFNEHMEN" Classes="overline" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="CloseComposerButton" Classes="ghost"
                  AutomationProperties.Name="Eingabe schließen"
                  ToolTip.Tip="Eingabe schließen"
                  Command="{Binding CloseComposerCommand}">
            <PathIcon Width="13" Height="13"
                      Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
          </Button>
        </Grid>
        <StackPanel x:Name="DockFields" Spacing="8">
          <!-- Fahrzeuge aller Wachen (#215): wählt man eines, werden Feuerwehr, Funkrufname und
               Stärke vorbelegt und die beiden ersten Felder gesperrt (readonly), damit die Zeile
               nicht vom Stammdaten-Fahrzeug abweicht. Der X-Button hebt die Auswahl wieder auf. -->
          <HeaderedContentControl Classes="field" Header="FAHRZEUG">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ComboBox x:Name="VehicleBox"
                        ItemsSource="{Binding VehicleOptions}"
                        SelectedItem="{Binding SelectedVehicle}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="md:Vehicle">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding CallSign}" />
                      <TextBlock Text="{Binding Wache}" Classes="secondary" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="ClearVehicleButton" Classes="icon-btn" IsVisible="{Binding IsVehicleSelected}"
                      Command="{Binding ClearVehicleCommand}"
                      ToolTip.Tip="Fahrzeugauswahl aufheben" AutomationProperties.Name="Fahrzeugauswahl aufheben">
                <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
              </Button>
            </StackPanel>
          </HeaderedContentControl>
          <!-- Plain text on purpose: vehicles from the Stammdaten are picked via FAHRZEUG above,
               so these two fields only serve vehicles that are NOT in the master data (Fremdwehren,
               mutual aid from outside the Landkreis). A suggestion list here would just re-offer
               what the dropdown already has. Readonly while a Fahrzeug is selected, since its Wache
               derived this field (#215). -->
          <HeaderedContentControl Classes="field required" Header="FEUERWEHR / WACHE"
                                  Classes.invalid="{Binding NewBrigadeError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBox x:Name="BrigadeBox"
                     IsEnabled="{Binding !IsVehicleSelected}"
                     PlaceholderText="{x:Static md:AnonymizedExampleData.BrigadePlaceholder}"
                     Text="{Binding NewBrigade}" />
          </HeaderedContentControl>
          <!-- Same reasoning as Feuerwehr/Wache above: free text for vehicles outside the Stammdaten,
               readonly while a Fahrzeug is selected. Required together with the Wache (#220): a
               Kraft is a Fahrzeug from den Stammdaten oder eine Wache samt Funkrufname. -->
          <HeaderedContentControl Classes="field required" Header="FUNKRUFNAME"
                                  Classes.invalid="{Binding NewCallSignError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBox x:Name="CallSignBox"
                     IsEnabled="{Binding !IsVehicleSelected}"
                     PlaceholderText="{x:Static md:AnonymizedExampleData.SecondCallSignPlaceholder}"
                     Text="{Binding NewCallSign}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="STÄRKE ZF / GF / MANN"
                                  Classes.invalid="{Binding NewStrengthError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Einfache Felder statt Spinner (#76-Rework): Ziffernfilter per Behavior, leer heißt
                 0 und lässt den Platzhalter stehen. Kein Beispiel-Platzhalter: das Label sagt bereits,
                 was gezählt wird, eine erfundene Zahl könnte für eine echte gehalten werden. -->
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBox x:Name="ZugfuehrerBox" Width="60"
                       Text="{Binding NewZugfuehrerCount}" b:IntegerOnly.IsEnabled="True" />
              <TextBox x:Name="OfficerBox" Width="60"
                       Text="{Binding NewOfficerCount}" b:IntegerOnly.IsEnabled="True" />
              <TextBox x:Name="MannschaftBox" Width="60"
                       Text="{Binding NewMannschaftCount}" b:IntegerOnly.IsEnabled="True" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="DAVON AGT"
                                  Classes.invalid="{Binding NewScbaCountError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBox x:Name="ScbaBox"
                     Text="{Binding NewScbaCount}" b:IntegerOnly.IsEnabled="True" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="STATUS">
            <ComboBox x:Name="StatusBox"
                      ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding NewStatus}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="BEMERKUNG">
            <!-- Freitext: kein Platzhalter, siehe #137 -->
            <TextBox x:Name="NotesBox" Text="{Binding NewNotes}" />
          </HeaderedContentControl>
          <Button x:Name="AddForceButton" Classes="signal dock-action" Content="HINZUFÜGEN" Command="{Binding AddForceCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </StackPanel>
        <!-- Was noch fehlt (#412), auf einer eigenen Zeile wie der Hinweis darunter: unter den
             Feldern selbst würde jede Meldung ihr Feld so breit machen wie ihren Text und
             HINZUFÜGEN aus dem Fenster schieben. Die Felder sagen welche, diese Zeile sagt was.
             Rot, weil sie die Aufnahme verhindert — der Hinweis darunter ist bernsteinfarben,
             weil er das nicht tut. -->
        <TextBlock x:Name="DockErrorSummary" Classes="field-error"
                   Text="{Binding ErrorSummary}"
                   IsVisible="{Binding ErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- Ein Fahrzeug ist einzig: steht sein Funkrufname schon in der Liste, verweigert das Flag
             die Aufnahme (Freitext-Duplikat), und der Dropdown blendet Vergebene ohnehin aus. -->
        <TextBlock x:Name="DuplicateHint" Text="Fahrzeug ist bereits aufgenommen"
                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsDuplicateCallSign}" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Panel>
    <Border x:Name="ForcesGridPanel" Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <DataGrid x:Name="ForcesGrid" b:RowKeys.IsEnabled="True" ItemsSource="{Binding Forces}" IsReadOnly="True" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="FEUERWEHR" Binding="{Binding Brigade}" Width="*" />
          <DataGridTextColumn Header="FUNKRUFNAME" Binding="{Binding CallSign}" />
          <!-- Stärke im 1/1/2-Format; die Zahlen bleiben nach dem Eintrag korrigierbar (#76),
               gebündelt in einem Editor, damit eine Korrektur ein Protokolleintrag bleibt.
               Verlauf zeigt die Wert-Historie der Einheit. -->
          <DataGridTemplateColumn Header="STÄRKE" Width="190">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ForceRow">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,4" VerticalAlignment="Center">
                  <!-- Gesamt split out as its own run, bold+underlined, same idiom as the header
                       tile's TotalStrengthPrefixText/TotalPersonnel split (#233): no Run/Inlines
                       idiom exists here to bold part of one TextBlock's text. -->
                  <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StrengthPrefixText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" TextDecorations="Underline"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- Vector icon, not a Unicode glyph: the button font (Oswald) carries neither
                       ✎ nor ✕, so a text affordance only appeared where the OS happened to have a
                       fallback. Same idiom as the ETB grid's row actions. -->
                  <Button Classes="icon-btn" IsVisible="{Binding !IsReadOnly}"
                          b:RowKeys.Role="Primary"
                          ToolTip.Tip="Stärke korrigieren (Enter)" AutomationProperties.Name="Stärke korrigieren">
                    <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Spacing="8" MinWidth="180">
                          <!-- One KeyBinding covers all four fields below: Avalonia checks a
                               control's KeyBindings while the KeyDown bubbles up from whichever
                               descendant has focus, so this doesn't need repeating per TextBox. -->
                          <StackPanel.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ApplyStrengthEditCommand}" />
                          </StackPanel.KeyBindings>
                          <TextBlock Text="Stärke korrigieren" Classes="overline" />
                          <HeaderedContentControl Classes="field" Header="ZUGFÜHRER (ZF)">
                            <TextBox Text="{Binding ZugfuehrerCount}" b:IntegerOnly.IsEnabled="True" />
                          </HeaderedContentControl>
                          <HeaderedContentControl Classes="field" Header="FÜHRUNGSKRÄFTE (GF)">
                            <TextBox Text="{Binding OfficerCount}" b:IntegerOnly.IsEnabled="True" />
                          </HeaderedContentControl>
                          <HeaderedContentControl Classes="field" Header="MANN">
                            <TextBox Text="{Binding MannschaftCount}" b:IntegerOnly.IsEnabled="True" />
                          </HeaderedContentControl>
                          <HeaderedContentControl Classes="field" Header="DAVON AGT">
                            <TextBox Text="{Binding ScbaCount}" b:IntegerOnly.IsEnabled="True" />
                          </HeaderedContentControl>
                          <Button Classes="signal" Content="ÜBERNEHMEN"
                                  Command="{Binding ApplyStrengthEditCommand}" />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Button Content="Verlauf" Padding="6,2" IsVisible="{Binding HasHistory}">
                    <Button.Flyout>
                      <!-- Opened: nothing in this read-only list is focusable, so without
                           grabbing focus here, Escape's built-in Flyout light-dismiss has no
                           focused element inside the popup to route the key press through, and
                           the flyout is stuck open until a click outside it. -->
                      <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnHistoryFlyoutOpened">
                        <ItemsControl ItemsSource="{Binding EditLines}" Margin="4" Focusable="True">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" Margin="0,2" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="AGT" Binding="{Binding ScbaCount}" />
          <!-- Status and Bemerkung are live controls rather than printed text: both move while the
               Einsatz runs, so they have to stay changeable after the row was added. Template
               columns keep them one click away instead of behind DataGrid's edit mode. -->
          <DataGridTemplateColumn Header="STATUS" Width="170">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ForceRow">
                <ComboBox Margin="6,4" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding Status}"
                          IsEnabled="{Binding !IsReadOnly}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Committing per keystroke rewrote the whole incident file on every character typed
               (#33) and, since the row rebuilds on each commit, threw focus out of the box after
               every character. UpdateSourceTrigger=LostFocus pushes once, when the operator
               actually leaves the field. Mirrors RolesView's Handynummer fix. -->
          <DataGridTemplateColumn Header="BEMERKUNG" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ForceRow">
                <!-- Freitext: kein Platzhalter, siehe #137; die Spaltenüberschrift ist das Label. -->
                <TextBox Margin="6,4"
                         Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding !IsReadOnly}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Eine aufgenommene Einheit lässt sich wieder komplett zurücknehmen (#76 follow-up):
               die Zeile samt Wert-Historie verschwindet, der ETB protokolliert die Entfernung.
               Im abgeschlossenen Einsatz ist die Spalte leer.
               Auto width like the ETB grid's action column: the fixed 44px this column used to
               carry left only 12px once DataGridCell's 12,0 padding and the button's margin were
               taken off, so the button was squeezed to its padding and drew nothing at all. -->
          <DataGridTemplateColumn>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ForceRow">
                <Button Classes="icon-btn" Margin="6,4"
                        IsVisible="{Binding !IsReadOnly}"
                        Command="{Binding RemoveCommand}"
                        b:RowKeys.Role="Remove"
                        ToolTip.Tip="Einheit entfernen (Entf)" AutomationProperties.Name="Einheit entfernen">
                  <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- The narrow layout: the same units, read as cards. The Funkrufname leads because that is
         what a Kommandant calls over the radio; Status and Bemerkung stay live controls, because
         both move while the Einsatz runs. -->
    <Border x:Name="ForcesCardPanel" Classes="narrow-only"
            Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ForcesCards" b:RowKeys.IsEnabled="True" ItemsSource="{Binding Forces}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ForceRow">
              <Border Classes="row-card">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="mono" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding CallSign}" />
                    <Button Grid.Column="1" Classes="icon-btn card-action"
                            IsVisible="{Binding !IsReadOnly}"
                            Command="{Binding RemoveCommand}"
                            b:RowKeys.Role="Remove"
                            ToolTip.Tip="Einheit entfernen (Entf)" AutomationProperties.Name="Einheit entfernen">
                      <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                    </Button>
                  </Grid>
                  <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{Binding Brigade}" />
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="STÄRKE" Classes="overline" FontSize="10" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding StrengthPrefixText}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" TextDecorations="Underline"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="AGT" Classes="overline" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScbaCount}" VerticalAlignment="Center" />
                  </StackPanel>
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding StatusOptions}"
                            SelectedItem="{Binding Status}"
                            IsEnabled="{Binding !IsReadOnly}" />
                  <!-- Freitext: kein Platzhalter, siehe #137; LostFocus for the same reason as the
                       grid's column — a commit per keystroke rewrites the Einsatzdatei (#33). -->
                  <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           IsEnabled="{Binding !IsReadOnly}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    </Panel>
  </DockPanel>
</UserControl>
