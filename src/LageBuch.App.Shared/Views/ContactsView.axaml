<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             x:Class="LageBuch.App.Shared.Views.ContactsView"
             x:DataType="vm:ContactsViewModel">
  <!-- Wide defaults are Style setters, not attributes: a local value outranks every setter, so the
       phone query below could never move or resize anything written inline. -->
  <UserControl.Styles>
    <Style Selector="TextBox#ContactSearchBox">
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <!-- The actions sit to the right of the name and the Notiz on a wide window... -->
    <Style Selector="DockPanel.contact-actions">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.RowSpan" Value="2" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <Style Selector="Button.contact-call">
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    </Style>
    <!-- The slot keeps its width when the button inside is hidden, so a row without an address
         does not shift its number out of line with the rows above and below. -->
    <Style Selector="Panel.contact-mail-slot">
      <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    </Style>
    <Style Selector="Button.contact-mail">
      <Setter Property="Width" Value="{StaticResource ControlHeight}" />
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    </Style>

    <ContainerQuery Name="Workspace" Query="max-width:640">
      <Style Selector="TextBlock#ContactsTitle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="TextBox#ContactSearchBox">
        <Setter Property="Margin" Value="0" />
      </Style>
      <!-- ...and drop to a row of their own on a phone, where the number stretches into a
           thumb-sized target instead of squeezing the name out of the card. -->
      <Style Selector="DockPanel.contact-actions">
        <Setter Property="Grid.Row" Value="2" />
        <Setter Property="Grid.RowSpan" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,10,0,0" />
      </Style>
      <!-- A raised surface on a phone: with no pointer to hover, a transparent number would read
           as plain text nobody thinks to tap. -->
      <Style Selector="Button.contact-call">
        <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      </Style>
      <Style Selector="Panel.contact-mail-slot">
        <Setter Property="Width" Value="{StaticResource ControlHeightTouch}" />
      </Style>
      <Style Selector="Button.contact-mail">
        <Setter Property="Width" Value="{StaticResource ControlHeightTouch}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <DockPanel>
    <!-- One line for title and search (#262): a band of its own would push the list down by a
         control height on a tab whose whole point is finding one row. Star column, never a fixed
         width in an Auto one, so the box can shrink on a phone (#146). -->
    <!-- The search column is capped, not the box: a capped box would either centre itself in a
         wide column or, left-aligned, shrink to its text. Capped, it sits beside the title where
         the eye starts reading instead of a screen's width away from the list it filters. -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MaxWidth="576" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" x:Name="ContactsTitle" Text="KONTAKTE" Classes="overline"
                 VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="ContactSearchBox" b:WorkspaceFocus.IsStart="True" MinWidth="130" VerticalAlignment="Center"
               Text="{Binding FilterText}"
               PlaceholderText="Name, Funktion, Zuständigkeit oder Nummer"
               AutomationProperties.Name="Kontakte durchsuchen"
               IsVisible="{Binding Contacts.Count}">
        <TextBox.InnerLeftContent>
          <PathIcon Width="14" Height="14" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                    Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
        </TextBox.InnerLeftContent>
        <!-- InnerRightContent, not a sibling: as a sibling the count and the button would widen
             the row and shove the focused box left under the caret on the first keystroke. -->
        <TextBox.InnerRightContent>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsFiltered}">
            <TextBlock x:Name="MatchCountText" Classes="mono" FontSize="12" VerticalAlignment="Center"
                       Text="{Binding MatchCountText}" />
            <Button x:Name="ClearContactSearchButton" Classes="icon-btn" ToolTip.Tip="Suche zurücksetzen"
                    AutomationProperties.Name="Suche zurücksetzen"
                    Command="{Binding ClearFilterCommand}">
              <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
            </Button>
          </StackPanel>
        </TextBox.InnerRightContent>
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Escape" Command="{Binding ClearFilterCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </Grid>

    <Border DockPanel.Dock="Top" x:Name="ErrorBanner" Background="{StaticResource AmberWashBrush}" Margin="0,0,0,14"
            BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusSm}" Padding="14,10"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Grid.Column="0" Width="15" Height="15" VerticalAlignment="Top" Margin="0,0,12,0"
                  Foreground="{StaticResource AmberBrush}"
                  Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
        <TextBlock Grid.Column="1" x:Name="ErrorMessageText" Text="{Binding ErrorMessage}"
                   FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource AmberBrush}" />
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top" x:Name="EmptyText"
               Text="Keine Kontakte hinterlegt — Personal steht in den Stammdaten."
               Foreground="{StaticResource TextSecondaryBrush}"
               IsVisible="{Binding !Contacts.Count}" />

    <Border x:Name="ContactsPanel"
            Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
            IsVisible="{Binding Contacts.Count}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Panel Margin="8">
          <!-- Distinct from EmptyText above: the Stammdaten do hold people, this search just found
               none. Inside the panel so the frame doesn't collapse mid-keystroke. TextSecondary,
               not TextMuted: that token is 50% alpha, and this line is all that explains the
               empty list (#439 moved content lines off it for the same reason). -->
          <TextBlock x:Name="NoMatchesText" Text="{Binding NoMatchesMessage}" Margin="6"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     IsVisible="{Binding !VisibleContacts.Count}" />
          <!-- ItemsControl, not ItemsRepeater: a Landkreis roster is tens of people, not
               thousands. Capped so the actions stay within eye travel of the name on a 1920px
               ELW monitor, but by a capped column, never a left-aligned MaxWidth on the list:
               that sizes the list to its widest card, and filtering changes the widest card on
               every keystroke, so the number column would jump while the Lagebuchführer types. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="1100" />
            </Grid.ColumnDefinitions>
            <ItemsControl x:Name="ContactsList" ItemsSource="{Binding VisibleContacts}"
                          IsVisible="{Binding VisibleContacts.Count}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContactRow">
                  <Border Classes="row-card">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                      <!-- #441: the Funkrufname is how the person is called on the radio, so it
                           stays on the name line; a WrapPanel lets it drop below on a phone. -->
                      <WrapPanel Grid.Row="0" Grid.Column="0" ItemSpacing="10" LineSpacing="2"
                                 VerticalAlignment="Center">
                        <TextBlock x:Name="ContactName" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                   b:HighlightedText.Segments="{Binding NameSegments}" />
                        <TextBlock Text="{Binding Person.Role}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Classes="mono" Text="{Binding Person.CallSign}" VerticalAlignment="Center" />
                        <!-- #458: somebody from a neighbouring brigade. A quiet tag, not a colour: it
                             explains a surprise ("why can't I pick them as Lagebuchführer?") rather
                             than warning about anything. -->
                        <Border x:Name="ForeignTag" IsVisible="{Binding IsForeign}" VerticalAlignment="Center"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}" Padding="6,1">
                          <TextBlock Text="fremd" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                      </WrapPanel>
  
                      <!-- The Zuständigkeit is the answer the search exists to find, so it is primary
                           text, not a muted caption, and a hit inside it lights up. In a Grid cell,
                           not a StackPanel: a wrapping TextBlock in a horizontal StackPanel measures
                           at infinite width and never wraps. -->
                      <TextBlock Grid.Row="1" Grid.Column="0" x:Name="ContactNote" Margin="0,4,0,0"
                                 FontSize="14" TextWrapping="Wrap"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 b:HighlightedText.Segments="{Binding NoteSegments}"
                                 IsVisible="{Binding NoteSegments.Count}" />
  
                      <!-- The number is the button's own text: one control both shows it and dials
                           it, and it stays readable where no dialer is registered. The glyph, not
                           only the tooltip, says "this leaves Lagebuch" (#262) — Android has no
                           hover. Mail is an icon: an address is rarely read out, and a second
                           labelled button per row is what drowned the Notiz before. -->
                      <DockPanel Classes="contact-actions" LastChildFill="True">
                        <Panel DockPanel.Dock="Right" Classes="contact-mail-slot" Margin="4,0,0,0">
                          <Button Classes="icon-btn contact-mail"
                                  IsVisible="{Binding Person.HasEmail}"
                                  Command="{ReflectionBinding $parent[ItemsControl].DataContext.MailCommand}"
                                  CommandParameter="{Binding Person}"
                                  ToolTip.Tip="{Binding Person.Email, StringFormat='E-Mail an {0} verfassen'}"
                                  AutomationProperties.Name="{Binding Person.Email, StringFormat='E-Mail an {0} verfassen'}">
                            <PathIcon Width="16" Height="16"
                                      Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
                          </Button>
                        </Panel>
                        <!-- Named explicitly: the content is a panel, so no name is derived from it. -->
                        <Button Classes="ghost contact-call" HorizontalContentAlignment="Left"
                                IsVisible="{Binding Person.HasPhone}"
                                AutomationProperties.Name="{Binding Person.Phone, StringFormat='{}{0} wählen'}"
                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.CallCommand}"
                                CommandParameter="{Binding Person}"
                                ToolTip.Tip="In der Telefon-App wählen — verlässt Lagebuch">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
                            <TextBlock Text="{Binding Person.Phone}" Classes="mono" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                          </StackPanel>
                        </Button>
                      </DockPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Panel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>
