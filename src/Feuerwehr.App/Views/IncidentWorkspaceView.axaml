<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Feuerwehr.AppLogic.ViewModels;assembly=Feuerwehr.AppLogic"
             x:Class="Feuerwehr.App.Views.IncidentWorkspaceView"
             x:DataType="vm:IncidentWorkspaceViewModel">
  <Panel>
    <DockPanel Margin="10">
      <!-- Header -->
      <StackPanel DockPanel.Dock="Top" Spacing="2">
        <TextBlock Text="Einsatzdokumentation" FontSize="18" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding IncidentNumberDisplay, StringFormat='Einsatznr: {0}'}" />
          <TextBlock Text="{Binding IlsNumberDisplay, StringFormat='ILS: {0}'}" />
          <TextBlock Text="{Binding StatusDisplay, StringFormat='Status: {0}'}" />
        </StackPanel>
        <Border x:Name="ReadOnlyBanner" Background="#FFE0B2" Padding="6" CornerRadius="4"
                IsVisible="{Binding IsReadOnly}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding ReadOnlyReason}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="ContinueEditingButton" Content="Weiter bearbeiten"
                    Command="{Binding ContinueEditingCommand}"
                    IsVisible="{Binding CanContinueEditing}" />
          </StackPanel>
        </Border>
        <!-- ILS reminder timer (only present when editable: Reminder != null) -->
        <Border x:Name="ReminderBar" Background="#E3F2FD" Padding="6" CornerRadius="4" Margin="0,4,0,0"
                IsVisible="{Binding HasReminder}">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                      DataContext="{Binding Reminder}">
            <TextBlock Text="Rückmeldung an ILS:" FontWeight="SemiBold" VerticalAlignment="Center" />

            <!-- Idle: choose interval + start -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        IsVisible="{Binding !IsRunning}">
              <NumericUpDown Value="{Binding IntervalMinutes}" Minimum="1" Maximum="120" Increment="1"
                             Width="110" FormatString="0" />
              <TextBlock Text="Min." VerticalAlignment="Center" />
              <Button x:Name="ReminderStartButton" Content="Timer starten" Command="{Binding StartCommand}" />
            </StackPanel>

            <!-- Running, not due: countdown + stop -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        IsVisible="{Binding IsRunning}">
              <TextBlock Text="{Binding RemainingDisplay, StringFormat='in {0}'}"
                         IsVisible="{Binding !IsDue}" VerticalAlignment="Center" />
              <Button x:Name="ReminderStopButton" Content="Stopp" Command="{Binding StopCommand}"
                      IsVisible="{Binding !IsDue}" />
            </StackPanel>

            <!-- Due: alert + acknowledge -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        IsVisible="{Binding IsDue}">
              <TextBlock Text="fällig!" FontWeight="Bold" Foreground="#B71C1C" VerticalAlignment="Center" />
              <Button x:Name="ReminderAckButton" Content="Erledigt" Command="{Binding AcknowledgeCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <!-- Footer -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button x:Name="CloseButton" Content="Einsatz abschließen" Command="{Binding CloseIncidentCommand}" />
        <Button x:Name="ExportButton" Content="PDF exportieren" Command="{Binding ExportPdfCommand}" />
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding LastSavedAt, StringFormat='Gespeichert: {0:HH:mm:ss}'}" />
      </StackPanel>
      <!-- Tabs -->
      <TabControl x:Name="ModuleTabs">
        <TabItem Header="Checkliste"><ContentControl Content="{Binding Checklist}" /></TabItem>
        <TabItem Header="ETB"><ContentControl Content="{Binding Etb}" /></TabItem>
        <TabItem Header="Funktionen"><ContentControl Content="{Binding Roles}" /></TabItem>
        <TabItem Header="Kräfte"><ContentControl Content="{Binding Forces}" /></TabItem>
      </TabControl>
    </DockPanel>
    <!-- Continue-editing operator prompt overlay -->
    <ContentControl Content="{Binding PendingPrompt}"
                    IsVisible="{Binding PendingPrompt, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Panel>
</UserControl>
