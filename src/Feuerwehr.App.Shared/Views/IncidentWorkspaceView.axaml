<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Feuerwehr.AppLogic.ViewModels;assembly=Feuerwehr.AppLogic"
             x:Class="Feuerwehr.App.Shared.Views.IncidentWorkspaceView"
             x:DataType="vm:IncidentWorkspaceViewModel">
  <Panel>
    <DockPanel>
      <!-- ===================== Status header ===================== -->
      <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
              Padding="24,16">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Title block -->
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="EINSATZDOKUMENTATION" Classes="overline" />
              <TextBlock Text="Lagebuch" Classes="display" FontSize="24" />
            </StackPanel>

            <!-- Status chips -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border x:Name="EinsatznummerChip" Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusSm}" Padding="14,8">
                <StackPanel>
                  <TextBlock Text="EINSATZNUMMER" Classes="overline" FontSize="9" />
                  <TextBlock Classes="mono" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"
                             Text="{Binding IncidentNumberInput}" />
                </StackPanel>
              </Border>
              <Border x:Name="StatusChip" Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusSm}" Padding="14,8">
                <StackPanel>
                  <TextBlock Text="STATUS" Classes="overline" FontSize="9" />
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{StaticResource ActiveBrush}" />
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Medium" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding StatusDisplay}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- Multi-device sharing (#52): expose this open incident to other devices over the
               network (loopback, LAN, or a tailnet) — the status line shows the address to dial. -->
          <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CanHost}">
            <Button Classes="ghost" Content="{Binding ShareButtonText}" Command="{Binding ToggleSharingCommand}" />
            <TextBlock Classes="body" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding ShareStatus}"
                       IsVisible="{Binding ShareStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- The PIN a joining device must enter; read it out to whoever is connecting (#64). -->
            <Border VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                    Background="#241608" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                    Padding="8,3"
                    IsVisible="{Binding SharePin, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="PIN" Classes="overline" FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource AmberBrush}" />
                <TextBlock Text="{Binding SharePin}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource AmberBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Joined-client disconnect banner (#52 §7): auto-reconnect is running; input is greyed
               out until it succeeds. "Zur Startseite" lets the user give up without waiting. -->
          <Border x:Name="DisconnectedBanner" Background="#241608"
                  BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="14,10"
                  IsVisible="{Binding !IsConnected}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="⚠" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"
                         Foreground="{StaticResource AmberBrush}" />
              <TextBlock Grid.Column="1" Text="Verbindung getrennt — verbinde neu…" FontWeight="SemiBold"
                         Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="2" x:Name="LeaveToHomeButton" Content="ZUR STARTSEITE"
                      Command="{Binding LeaveToHomeCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Read-only banner -->
          <Border x:Name="ReadOnlyBanner" Background="#241608"
                  BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="14,10"
                  IsVisible="{Binding IsReadOnly}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="🔒" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ReadOnlyReason}" FontWeight="SemiBold"
                         Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
              <Button x:Name="ContinueEditingButton" Content="WEITER BEARBEITEN"
                      Command="{Binding ContinueEditingCommand}"
                      IsVisible="{Binding CanContinueEditing}" />
            </StackPanel>
          </Border>

          <!-- ILS reminder bar -->
          <Border x:Name="ReminderBar" Background="#0B1A2A"
                  BorderBrush="{StaticResource IncomingBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="14,8"
                  IsVisible="{Binding HasReminder}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                        DataContext="{Binding Reminder}">
              <TextBlock Text="⏱" FontSize="15" VerticalAlignment="Center"
                         Foreground="{StaticResource IncomingBrush}" />
              <TextBlock Text="RÜCKMELDUNG AN ILS" Classes="overline" FontSize="10"
                         Foreground="{StaticResource IncomingBrush}" VerticalAlignment="Center" />

              <!-- Idle: interval + start -->
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                          IsVisible="{Binding !IsRunning}">
                <NumericUpDown Value="{Binding IntervalMinutes}" Minimum="1" Maximum="120" Increment="1"
                               Width="118" FormatString="0" />
                <TextBlock Text="Min." Classes="secondary" VerticalAlignment="Center" />
                <Button x:Name="ReminderStartButton" Content="TIMER STARTEN" Command="{Binding StartCommand}" />
              </StackPanel>

              <!-- Running, not due: countdown + stop. The remaining time is the hero of the bar —
                   large tactical monospace (stable digit width as it ticks every second) behind a
                   quiet "NOCH" kicker and a hairline, rather than a small lowercase "in 11:32". -->
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                          IsVisible="{Binding IsRunning}">
                <Border Width="1" Height="22" Background="{StaticResource HairlineBrush}"
                        IsVisible="{Binding !IsDue}" VerticalAlignment="Center" />
                <TextBlock Text="NOCH" Classes="overline" FontSize="9"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           IsVisible="{Binding !IsDue}" VerticalAlignment="Center" />
                <TextBlock x:Name="ReminderCountdownText" Classes="mono" FontSize="21" FontWeight="Medium"
                           Foreground="{StaticResource IncomingBrush}"
                           Text="{Binding RemainingDisplay}"
                           IsVisible="{Binding !IsDue}" VerticalAlignment="Center" />
                <Button x:Name="ReminderStopButton" Content="STOPP" Command="{Binding StopCommand}"
                        IsVisible="{Binding !IsDue}" />
              </StackPanel>

              <!-- Due: alert + acknowledge -->
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                          IsVisible="{Binding IsDue}">
                <Border Background="{StaticResource SignalGradientBrush}" CornerRadius="{StaticResource RadiusSm}"
                        Padding="10,4" BoxShadow="0 0 16 -2 #99FF3D2E">
                  <TextBlock Text="FÄLLIG!" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                             LetterSpacing="1.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="ReminderAckButton" Classes="signal" Content="ERLEDIGT" Command="{Binding AcknowledgeCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Atemschutz pressure-control reminder (soonest-due Trupp across all tabs) -->
          <Border x:Name="ScbaControlBar" Background="#241608"
                  BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="14,8"
                  IsVisible="{Binding Scba.HasControlReminder}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                        DataContext="{Binding Scba}">
              <TextBlock Text="⏱" FontSize="15" VerticalAlignment="Center"
                         Foreground="{StaticResource AmberBrush}" />
              <TextBlock Text="ATEMSCHUTZ" Classes="overline" FontSize="10"
                         Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="ScbaControlText" Text="{Binding NextControlDisplay}" FontWeight="SemiBold"
                         Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
              <Border Background="{StaticResource SignalGradientBrush}" CornerRadius="{StaticResource RadiusSm}"
                      Padding="10,4" BoxShadow="0 0 16 -2 #99FF3D2E"
                      IsVisible="{Binding IsAnyControlDue}">
                <TextBlock Text="DRUCKABFRAGE!" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                           LetterSpacing="1.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Atemschutz Rückzugsalarm: unmissable red banner + audible alarm (life-safety) -->
          <Border x:Name="ScbaAlarmBar" Background="{StaticResource SignalGradientBrush}"
                  BorderBrush="{StaticResource SignalHotBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="16,12"
                  BoxShadow="0 0 22 -2 #CCFF3D2E"
                  IsVisible="{Binding Scba.IsAnyAlarm}">
            <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding Scba}">
              <TextBlock Grid.Column="0" Text="🚨" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" Text="{Binding AlarmDisplay}"
                         FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                         LetterSpacing="1" Foreground="#FFFFFF" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="ALARM QUITTIEREN" Command="{Binding AcknowledgeAlarmCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- ===================== Action footer ===================== -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBarBrush}"
              BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
              Padding="24,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" IsEnabled="{Binding IsInputEnabled}">
            <Button x:Name="CloseButton" Content="EINSATZ ABSCHLIESSEN" Command="{Binding CloseIncidentCommand}" />
            <!-- PDF export renders from the local file, so it's host-only (hidden on a joined client). -->
            <Button x:Name="ExportButton" Classes="signal" Content="PDF EXPORTIEREN" Command="{Binding ExportPdfCommand}"
                    IsVisible="{Binding CanExport}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource ActiveBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="mono" FontSize="12" VerticalAlignment="Center"
                       Text="{Binding LastSavedAt, StringFormat='gespeichert {0:HH:mm:ss}'}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===================== Module tabs ===================== -->
      <!-- 24px left gutter so the nav rail shares the same left edge as the header bars
           and footer actions. The content area keeps its own inner padding, preserving
           the gap between rail and content. -->
      <!-- Greyed out while a joined client is reconnecting — it can't send commands until the link is back. -->
      <Border Background="{StaticResource AppBackgroundBrush}" Padding="24,0,0,0" IsEnabled="{Binding IsInputEnabled}">
        <TabControl x:Name="ModuleTabs">
          <TabControl.Background>
            <SolidColorBrush Color="Transparent" />
          </TabControl.Background>
          <TabItem Header="CHECKLISTE">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Checklist}" />
            </Border>
          </TabItem>
          <TabItem Header="ETB">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Etb}" />
            </Border>
          </TabItem>
          <TabItem Header="FUNKTIONEN">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Roles}" />
            </Border>
          </TabItem>
          <TabItem Header="KRÄFTE">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Forces}" />
            </Border>
          </TabItem>
          <TabItem Header="ATEMSCHUTZ">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Scba}" />
            </Border>
          </TabItem>
        </TabControl>
      </Border>
    </DockPanel>

    <!-- Continue-editing operator prompt overlay -->
    <ContentControl Content="{Binding PendingPrompt}"
                    IsVisible="{Binding PendingPrompt, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Confirmation overlay (e.g. closing the incident) -->
    <ContentControl Content="{Binding PendingConfirm}"
                    IsVisible="{Binding PendingConfirm, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Panel>
</UserControl>
