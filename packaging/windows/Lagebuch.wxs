<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v5 authoring for the Lagebuch MSI. Built in CI with:
    wix build packaging/windows/Lagebuch.wxs -arch x64 -d Version=<v> -d PublishDir=<dir> -d IconFile=<ico>
      -d DocumentIconFile=<ico> -o out.msi

  The UpgradeCode is fixed forever: it is what lets a new version replace the old one instead of
  installing side by side. The ProductCode is auto-generated per build (Package/@Id defaults to "*").
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Lagebuch"
           Manufacturer="CodeForFire"
           Version="$(Version)"
           UpgradeCode="a03eaa1b-3d77-4ff0-a60a-5abe27c27b18"
           Scope="perMachine"
           Compressed="yes">

    <!--
      Block a downgrade with a clear message rather than a confusing installer error.

      AllowSameVersionUpgrades is what lets the final 0.6.0 replace a 0.6.0-beta.N install: the
      beta's ProductVersion is the numeric core (0.6.0), identical to the final's, and without this
      the two would sit side by side in Programs and Features. The documented cost is that it also
      permits a downgrade between builds whose first three version fields match — i.e. reinstalling
      a beta over the matching final, which is exactly what a tester who needs to go back wants.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Eine neuere Version von Lagebuch ist bereits installiert." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="LagebuchIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="LagebuchIcon" />

    <!-- Install into Program Files\Lagebuch. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Lagebuch" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main">
      <!-- Auto-harvest the entire published output into INSTALLFOLDER (WiX v5's heat replacement). -->
      <Files Include="$(PublishDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="FileAssociation" />
    </Feature>

    <!-- Start-menu shortcut. A shortcut component needs its own keypath, hence the HKCU value. -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
      <Shortcut Id="LagebuchShortcut"
                Name="Lagebuch"
                Description="Einsatzdokumentation für die Feuerwehr"
                Target="[INSTALLFOLDER]LageBuch.App.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="LagebuchIcon" />
      <RegistryValue Root="HKCU" Key="Software\CodeForFire\Lagebuch"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      Einsatzdateien open in Lagebuch on a double-click and show their own document icon. .lagebuch
      is what the app saves; .fwincident is what it saved before, and stays registered so an
      Einsatz from an older version still opens the same way. Both share one ProgId and so one
      icon and one open command.

      The ProgId is not advertised, so WiX writes it as plain registry values under
      HKLM\Software\Classes (perMachine) that this component owns and uninstall removes. The verb
      has to name the exe through a property: <Files> harvests the exe without an Id that a
      TargetFile could reference.
    -->
    <Component Id="FileAssociation" Directory="INSTALLFOLDER" Guid="*">
      <File Id="DocumentIcon" Source="$(DocumentIconFile)" Name="lagebuch-document.ico" KeyPath="yes" />
      <ProgId Id="Lagebuch.Einsatz" Description="Lagebuch-Einsatz" Icon="DocumentIcon" IconIndex="0">
        <Extension Id="lagebuch" ContentType="application/x-lagebuch">
          <Verb Id="open" TargetProperty="LAGEBUCHEXE" Argument="&quot;%1&quot;" />
        </Extension>
        <!-- No verb and no ContentType of its own: the verb lives on the ProgId and the MIME
             type's Extension value names one extension, so declaring either again writes the
             same registry value twice (WIX0091). Pointing at the ProgId is all it needs. -->
        <Extension Id="fwincident" />
      </ProgId>
    </Component>
    <SetProperty Id="LAGEBUCHEXE" Value="[INSTALLFOLDER]LageBuch.App.exe" After="CostFinalize" Sequence="execute" />
  </Package>
</Wix>
