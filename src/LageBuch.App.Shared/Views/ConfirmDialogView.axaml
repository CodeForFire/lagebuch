<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             x:Class="LageBuch.App.Shared.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">
  <!-- MaxWidth, not Width, and Stretch rather than Center: a hard Width clips on a phone
       instead of shrinking — the card wanted its Width plus 80px of scrim against a 412dp
       screen. Avalonia centres a Stretch element that MaxWidth has made narrower than its
       slot, so a wide window looks exactly as it did. The scrim inset drops 40 -> 16 for the
       same reason; on a desktop the card never comes near either. -->
  <Border Background="#B3070A10" Padding="16"
          b:Overlay.CancelCommand="{Binding CancelCommand}" b:Overlay.InitialFocus="{Binding #CancelButton}">
    <Border MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Stretch"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource OverlayShadow}">
      <DockPanel>
        <!-- Accent header strip -->
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource SignalGradientBrush}"
                CornerRadius="12,12,0,0" />
        <StackPanel Margin="26,22,26,24" Spacing="10">
          <TextBlock Text="{Binding Title}" Classes="display" FontSize="22" />
          <TextBlock Text="{Binding Message}" Classes="secondary" TextWrapping="Wrap" />
          <CheckBox x:Name="OptionCheckBox" IsVisible="{Binding HasOption}"
                    IsChecked="{Binding IsOptionChecked}" Content="{Binding OptionLabel}" />
          <!-- Nested under the option it refines, and only enabled while that one is ticked. -->
          <CheckBox x:Name="SubOptionCheckBox" Margin="28,-4,0,0" IsVisible="{Binding HasSubOption}"
                    IsEnabled="{Binding IsOptionChecked}"
                    IsChecked="{Binding IsSubOptionChecked}" Content="{Binding SubOptionLabel}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="ABBRECHEN" Command="{Binding CancelCommand}" />
            <Button x:Name="ConfirmButton" Classes="signal" Content="{Binding ConfirmLabel}"
                    Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
