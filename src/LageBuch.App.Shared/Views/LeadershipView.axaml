<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             x:Class="LageBuch.App.Shared.Views.LeadershipView"
             x:DataType="vm:LeadershipViewModel">
  <!-- The FÜHRUNG board: the A3 Führungs-sheet crews keep next to the laptop, live. The
       Einsatzleitung on top with the partner Einsatzleitungen and Fachberater beside it, a card per
       Bereitstellung and Abschnitt below (Unterabschnitte nested), then the units nobody has placed.
       Every decision is the view model's; the code-behind only carries drag and drop. -->
  <UserControl.Styles>
    <!-- The org chart. Widths and alignments are Styles, never attributes: a local value outranks a
         Style setter, so the narrow styles below could not make one full-width column (#685). A
         card is 320 wide, room for the Einsatzleitung's names and buttons side by side; the chart is
         as wide as its rows and scrolls sideways in ChartScroll, like the A3 sheet. -->
    <Style Selector="Border#NodeCard">
      <Setter Property="Width" Value="320" />
    </Style>
    <Style Selector="ctrl|OrgChart">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="ScrollViewer#ChartScroll">
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="StackPanel#OrgChart > ItemsControl">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="StackPanel.org-branch > ContentControl">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.org-branch > ItemsControl">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="ItemsControl.board-chips">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" ItemWidth="260" ItemSpacing="8" LineSpacing="8" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Border#ElCard">
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    </Style>

    <Style Selector="Border.board-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- An Unterabschnitt hangs below its Abschnitt a shade lighter, so the level reads at a glance. -->
    <Style Selector="Border.board-card.unterabschnitt">
      <Setter Property="Background" Value="{StaticResource SurfaceTopBrush}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <!-- The card a dragged unit would land in, set by the code-behind during a drag. -->
    <!-- Focus cyan, not signal red: red is alarm and error in this app. The padding gives back the
         extra pixel of border, so nothing inside shifts while the pointer passes over. -->
    <Style Selector="Border.board-card.drop-target">
      <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="11,9" />
    </Style>
    <Style Selector="Border.board-card.unterabschnitt.drop-target">
      <Setter Property="Padding" Value="9,7" />
    </Style>
    <!-- A unit dropped on the Einsatzleitung stays where it is and becomes its Führungsfahrzeug
         (#888), which the same cyan frame alone would not tell from a move. So the card says so and
         lights the row that changes. The hint shares its row with "Einsatzleitung", so it has text
         only while it is shown and the card keeps its height; a hidden one is not read out. -->
    <Style Selector="TextBlock.el-drop-hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource FocusBrush}" />
    </Style>
    <Style Selector="Border#ElCard.drop-target TextBlock.el-drop-hint">
      <Setter Property="Text" Value="WIRD FÜHRUNGSFAHRZEUG" />
    </Style>
    <Style Selector="Border#ElCard.drop-target SelectableTextBlock#ElFahrzeug">
      <Setter Property="Foreground" Value="{StaticResource FocusBrush}" />
    </Style>
    <!-- What is held, dimmed where it came from: no drag picture follows the pointer, so this is
         how the Lagebuchführer sees which unit or card is in hand. -->
    <Style Selector="Grid.unit-row.dragged">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Border.board-card.dragged">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Why a place refuses: amber like the board's other hints, not red, since nothing went wrong. -->
    <Style Selector="Border.drop-refusal">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="16,0,16,16" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{StaticResource SurfaceTopBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>
    <Style Selector="Border.drop-refusal > TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>

    <!-- Moving a card. Over a card's head it lands before that card, which a bar down the card's
         left edge shows: the cards stand side by side, so a line above the head read as "into".
         The code-behind puts "drop-before" on the card whose head is the target. The bar lies in
         the card's padding over its content, so it moves nothing; a shadow outside the card was
         clipped to the card's bounds. Two strips show only while a card is dragged (into an
         Abschnitt, last at the top level), each in the place of a row of buttons, so the chart
         does not move when the drag starts. -->
    <Style Selector="Border.node-drop-before">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.drop-before-bar">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-12,-4,0,-4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{StaticResource FocusBrush}" />
    </Style>
    <Style Selector="Border.board-card.unterabschnitt > Panel > Border.drop-before-bar">
      <Setter Property="Margin" Value="-10,-2,0,-2" />
    </Style>
    <Style Selector="Border.board-card.drop-before > Panel > Border.drop-before-bar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.node-drop-strip">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="StackPanel#BoardRoot.dragging-node Border.node-drop-end">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="StackPanel#BoardRoot.dragging-node Border.node-drop-into.abschnitt">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="StackPanel#BoardRoot.dragging-node WrapPanel.card-actions.abschnitt, StackPanel#BoardRoot.dragging-node WrapPanel.board-actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.node-drop-strip.drop-target">
      <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
    </Style>

    <Style Selector="TextBlock.card-name, SelectableTextBlock.card-name">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Read across a command post on a dimmed screen: the body font, not the condensed display one,
         at 11 and with only a little tracking. The display font at 10, widely tracked, blurred into
         a grey line (field report). -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- What a card or a Funktion is, in the words it was recorded with: mixed case, so no tracking. -->
    <Style Selector="TextBlock.card-kind">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.unit-title, SelectableTextBlock.unit-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.field-value, SelectableTextBlock.field-value">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.board-hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>
    <!-- A Funkgruppe the level above lacks (#878) reads amber, like the board's other hints. -->
    <Style Selector="SelectableTextBlock.field-value.not-shared">
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>

    <!-- Why AUFLÖSEN is off. The desktop says it in the button's tooltip; a phone has no hover, so
         the narrow layout shows it under the button instead. Hidden by a Style, not an attribute, so
         the narrow style below can turn it on. -->
    <Style Selector="TextBlock.dissolve-reason">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- A Funkgruppe: with the pointer on it, every other card that has the same one lights up
         violet (LinkBrush) and fades back out. At rest the chip is the same size in LinkFaded, its
         padding given back by the margin, so lighting up moves nothing. Which lines light is the
         view model's (LeadershipViewModel.HighlightFunkgruppe). -->
    <Style Selector="Border.funk-chip">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{StaticResource LinkFadedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LinkFadedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="Margin" Value="-4,-2" />
      <Setter Property="BoxShadow" Value="{StaticResource LinkGlowOff}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.28" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.28" Easing="CubicEaseOut" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.45" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- An ItemsControl clips to its bounds, which cut the chip's outset border and glow off. -->
    <Style Selector="ItemsControl.funk-lines">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Border.funk-chip > SelectableTextBlock">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.28" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.funk-chip.linked">
      <Setter Property="Background" Value="{StaticResource LinkWashBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LinkBrush}" />
      <Setter Property="BoxShadow" Value="{StaticResource LinkGlow}" />
    </Style>
    <!-- After the not-shared amber: while lit, a line reads in the link colour like the others. -->
    <Style Selector="Border.funk-chip.linked > SelectableTextBlock">
      <Setter Property="Foreground" Value="{StaticResource LinkInkBrush}" />
    </Style>

    <Style Selector="Button.board-action">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- The grip is the only place a drag starts, so it is a target, not a 9px icon: the full
         height of its row and wider than the dots, which light up under the pointer. -->
    <Style Selector="Border.unit-grip">
      <Setter Property="Width" Value="20" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Cursor" Value="SizeAll" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.unit-grip > PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.unit-grip:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceTopBrush}" />
    </Style>
    <Style Selector="Border.unit-grip:pointerover > PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <!-- A closed Einsatz is a record: nothing to pick up. -->
    <Style Selector="Border.unit-grip:disabled">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.unit-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceTopBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- The phone: one full-width column, the chart as an indented tree with elbow lines and no
         sideways scrolling, no grips (a touch drag scrolls; the picker moves a unit), and
         thumb-sized actions. -->
    <Style Selector="Panel#WorkspaceRoot.narrow ctrl|OrgChildrenPanel">
      <Setter Property="IsCompact" Value="True" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow ctrl|OrgPeersPanel">
      <Setter Property="IsCompact" Value="True" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow ScrollViewer#ChartScroll">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow Border#NodeCard">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow ctrl|OrgChart">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow StackPanel#OrgChart > ItemsControl">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow StackPanel.org-branch > ContentControl">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow StackPanel.org-branch > ItemsControl">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow ItemsControl.board-chips">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow Border.unit-grip">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- On a phone the picker is the only way to move a unit: a thumb target. -->
    <Style Selector="Panel#WorkspaceRoot.narrow ctrl|NodeChoicePicker.unit-picker Button#PickerButton">
      <Setter Property="Width" Value="{StaticResource ControlHeightTouch}" />
      <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow TextBlock.dissolve-reason.blocked">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow Button.board-action">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One branch of the org chart: a Bereitstellung or Abschnitt card, its Unterabschnitte below
         it in a row joined by lines. The cards themselves come from the BoardNodeCard DataTemplate;
         an Unterabschnitt has no children of its own, so the list below it is that plain card. -->
    <DataTemplate x:Key="NodeBranchTemplate" x:DataType="vm:BoardNodeCard">
      <StackPanel Classes="org-branch">
        <ContentControl x:Name="BranchHead" Content="{Binding}" />
        <ItemsControl x:Name="BranchChildren" ItemsSource="{Binding Children}" IsVisible="{Binding Children.Count}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <ctrl:OrgChildrenPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- One unit: on a card a row of the units table, in the strip a chip. The grip starts a drag on
         the desktop; the picker moves the unit anywhere, and is the phone's only way. -->
    <DataTemplate x:Key="UnitRowTemplate" x:DataType="vm:BoardUnitRow">
      <Grid Classes="unit-row" Classes.dragged="{Binding IsDragged}" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="BoardGrip" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="BoardStrength" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="BoardAgt" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="BoardMove" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Classes="unit-grip" x:Name="UnitGrip"
                ToolTip.Tip="Ziehen, um die Einheit zu verschieben, oder rechts den Abschnitt wählen"
                AutomationProperties.Name="Einheit verschieben">
          <PathIcon Width="9" Height="14"
                    Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" />
        </Border>
        <!-- The Funkrufname is the unit's name on the sheet: never trimmed, wrapped if it must. -->
        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" x:Name="UnitTitle" Classes="unit-title"
                   Text="{Binding Title}" ToolTip.Tip="{Binding Title}" />
        <!-- No Wache under it: the Funkrufname already names the Wache ("FFB 1/40/1"). The strength
             keeps its own line, so a long Funkrufname above it still fits on one. -->
        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="UnitStrength" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding StrengthText}" ToolTip.Tip="Zugführer / Gruppenführer / Mannschaft / Gesamt" />
        <TextBlock Grid.Row="1" Grid.Column="3" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right"
                   MinWidth="22" TextAlignment="Right"
                   Text="{Binding ScbaCount}" ToolTip.Tip="davon Atemschutzgeräteträger" />
        <!-- An icon, not the node's name: the card it sits on already says that. -->
        <ctrl:NodeChoicePicker Grid.Row="1" Grid.Column="4" x:Name="UnitNodePicker" Classes="unit-picker"
                               IsIconOnly="True" VerticalAlignment="Center"
                               Choices="{Binding NodeChoices}" Label="{Binding NodeLabel}" />
        <!-- #825: shown in every Bereitstellungsraum by its status alone, until one is picked. -->
        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" x:Name="UnitWaitingHint" Classes="board-hint"
                   Text="{x:Static vm:BoardUnitRow.WaitingText}" IsVisible="{Binding IsWaitingByStatus}"
                   ToolTip.Tip="Der Status sagt Bereitstellungsraum, die Einheit steht aber in keinem. Raum im Auswahlfeld wählen oder hineinziehen." />
      </Grid>
    </DataTemplate>

    <!-- A Funktion on a card: what it is, then who holds it. -->
    <!-- One Funkgruppe of a node, marked against the level above (#878): a check when that level
         has it too, an amber x when it does not, nothing while the kind is not checked. The mark
         takes the first column so a long group still wraps. -->
    <DataTemplate x:Key="FunkgruppeChipTemplate" x:DataType="vm:FunkgruppeLine">
      <Border Classes="funk-chip" Classes.linked="{Binding Highlight.IsHighlighted}"
              PointerEntered="OnFunkgruppePointerEntered" PointerExited="OnFunkgruppePointerExited">
        <SelectableTextBlock Classes="field-value" Classes.not-shared="{Binding IsMarkedNotShared}"
                             Text="{Binding Text}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FunkgruppeLineTemplate" x:DataType="vm:FunkgruppeLine">
      <Grid ColumnDefinitions="14,*" ColumnSpacing="4">
        <PathIcon Grid.Column="0" Width="11" Height="11" VerticalAlignment="Center"
                  Foreground="{StaticResource TextSecondaryBrush}" IsVisible="{Binding IsMarkedShared}"
                  AutomationProperties.Name="{Binding MarkName}"
                  Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
        <PathIcon Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                  Foreground="{StaticResource AmberBrush}" IsVisible="{Binding IsMarkedNotShared}"
                  AutomationProperties.Name="{Binding MarkName}"
                  Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
        <ContentControl Grid.Column="1" ClipToBounds="False" Content="{Binding}" ContentTemplate="{StaticResource FunkgruppeChipTemplate}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PersonRowTemplate" x:DataType="vm:BoardPersonRow">
      <StackPanel Spacing="0">
        <TextBlock Classes="card-kind" Text="{Binding Role}" TextTrimming="CharacterEllipsis" />
        <SelectableTextBlock Classes="field-value" Text="{Binding Text}" />
      </StackPanel>
    </DataTemplate>

    <!-- A Führungsunterstützung: the person row, then what can be done to it. The buttons sit under
         the name, so a long Funktion and name keep the card's width (and a phone's). -->
    <DataTemplate x:Key="AssistantRowTemplate" x:DataType="vm:BoardPersonRow">
      <StackPanel Spacing="4">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PersonRowTemplate}" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
          <Button x:Name="EditAssistantButton" Classes="board-action" Content="ÄNDERN"
                  ToolTip.Tip="Name, Funkrufname oder Handynummer korrigieren"
                  AutomationProperties.Name="{Binding EditAutomationName}"
                  Command="{Binding EditCommand}" />
          <Button x:Name="TransferAssistantButton" Classes="board-action" Content="ÜBERTRAGEN"
                  ToolTip.Tip="Funktion an eine andere Person übergeben"
                  AutomationProperties.Name="{Binding TransferAutomationName}"
                  Command="{Binding TransferCommand}" />
        </WrapPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <!-- The top row's Einsatzleitung Feuerwehr. -->
    <DataTemplate DataType="vm:ElCard" x:DataType="vm:ElCard">
      <Border x:Name="ElCard" Classes="board-card" ctrl:OrgChildrenPanel.IsAnchor="True">
        <StackPanel Spacing="9">
          <StackPanel Spacing="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBlock Grid.Column="0" Classes="card-kind" Text="Einsatzleitung" />
              <TextBlock Grid.Column="1" x:Name="ElDropHint" Classes="el-drop-hint" />
            </Grid>
            <SelectableTextBlock Classes="card-name" Text="Feuerwehr" />
          </StackPanel>

          <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Classes="field-label" Text="EL" />
            <SelectableTextBlock Grid.Column="1" Classes="field-value" x:Name="ElLeiterText"
                       Text="{Binding Leiter.Text, FallbackValue='—', TargetNullValue='—'}" />
            <Button Grid.Column="2" x:Name="LeadershipSetElButton" Classes="board-action" Content="FESTLEGEN"
                    ToolTip.Tip="EL festlegen" AutomationProperties.Name="EL festlegen"
                    Command="{Binding SetLeiterCommand}" />
          </Grid>

          <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Classes="field-label" Text="MELDER" />
            <SelectableTextBlock Grid.Column="1" Classes="field-value" x:Name="ElMelderText"
                       Text="{Binding Melder.Text, FallbackValue='—', TargetNullValue='—'}" />
            <Button Grid.Column="2" x:Name="LeadershipSetElMelderButton" Classes="board-action" Content="FESTLEGEN"
                    ToolTip.Tip="Melder festlegen" AutomationProperties.Name="Melder der Einsatzleitung festlegen"
                    Command="{Binding SetMelderCommand}" />
          </Grid>

          <!-- Label above the list, as FÜHRUNGSSTUFE below: "FÜHRUNGSUNTERSTÜTZUNG" needs the
               card's width, not the 96px label column. -->
          <StackPanel x:Name="ElAssistants" Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBlock Grid.Column="0" Classes="field-label" Text="FÜHRUNGSUNTERSTÜTZUNG" />
              <Button Grid.Column="1" x:Name="AddAssistantButton" Classes="board-action" Content="+ HINZUFÜGEN"
                      ToolTip.Tip="Führungsunterstützung hinzufügen"
                      AutomationProperties.Name="Führungsunterstützung hinzufügen"
                      Command="{Binding AddAssistantCommand}" />
            </Grid>
            <SelectableTextBlock Classes="field-value" Text="—"
                       IsVisible="{Binding !Assistants.Count}" />
            <ItemsControl x:Name="ElAssistantRows" ItemsSource="{Binding Assistants}"
                          ItemTemplate="{StaticResource AssistantRowTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <!-- A second Leiter or Melder typed on FUNKTIONEN without an Abschnitt (an EAL beside the
               EL): shown, so nobody the Bericht prints is missing from the board. -->
          <Grid x:Name="ElFurther" ColumnDefinitions="96,*" ColumnSpacing="6" IsVisible="{Binding HasFurther}">
            <TextBlock Grid.Column="0" Classes="field-label" Text="WEITERE" VerticalAlignment="Top" Margin="0,4,0,0" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Further}" ItemTemplate="{StaticResource PersonRowTemplate}" />
          </Grid>

          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="STANDORT" />
            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="field-value" Text="{Binding Standort, TargetNullValue='—'}" />
            <!-- The Führungsfahrzeug's Funkrufname (#829). -->
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="FAHRZEUG" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="field-value" x:Name="ElFahrzeug"
                       Text="{Binding Fuehrungsfahrzeug, TargetNullValue='—'}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="RUFNAME" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="field-value" Text="{Binding Rufname, TargetNullValue='—'}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="TELEFON" />
            <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="field-value" Text="{Binding Telefon, TargetNullValue='—'}" />
            <!-- One Funkgruppe per line (#828): up to three of each kind. -->
            <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" Text="TMO" VerticalAlignment="Top" />
            <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="field-value" Text="—" IsVisible="{Binding !TmoLines.Count}" />
            <ItemsControl Grid.Row="4" Grid.Column="1" x:Name="ElTmo" Classes="funk-lines" ItemsSource="{Binding TmoLines}"
                          ItemTemplate="{StaticResource FunkgruppeChipTemplate}" />
            <TextBlock Grid.Row="5" Grid.Column="0" Classes="field-label" Text="DMO" VerticalAlignment="Top" />
            <SelectableTextBlock Grid.Row="5" Grid.Column="1" Classes="field-value" Text="—" IsVisible="{Binding !DmoLines.Count}" />
            <ItemsControl Grid.Row="5" Grid.Column="1" x:Name="ElDmo" Classes="funk-lines" ItemsSource="{Binding DmoLines}"
                          ItemTemplate="{StaticResource FunkgruppeChipTemplate}" />
          </Grid>

          <Button Classes="board-action" HorizontalAlignment="Left" Content="ERREICHBARKEIT BEARBEITEN"
                  ToolTip.Tip="Standort, Führungsfahrzeug, Rufname, Telefon und Funkgruppen bearbeiten"
                  Command="{Binding EditPostCommand}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- All Fachberater on one card, at the end of the top row. -->
    <DataTemplate DataType="vm:FachberaterGroup" x:DataType="vm:FachberaterGroup">
      <Border x:Name="FachberaterCard" Classes="board-card">
        <StackPanel Spacing="8">
          <StackPanel Spacing="1">
            <TextBlock Classes="card-kind" Text="Beratung" />
            <SelectableTextBlock Classes="card-name" Text="Fachberater" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding People}" ItemTemplate="{StaticResource PersonRowTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A Bereitstellung, Abschnitt, Unterabschnitt or partner Einsatzleitung. Children use the same
         template, so an Unterabschnitt card is drawn inside its Abschnitt's. -->
    <DataTemplate DataType="vm:BoardNodeCard" x:DataType="vm:BoardNodeCard">
      <Border Classes="board-card" x:Name="NodeCard" Classes.unterabschnitt="{Binding IsUnterabschnitt}"
              Classes.dragged="{Binding IsDragged}">
        <Panel>
        <!-- One shared-size scope per card, so the SUMME row lines up with the units table above it. -->
        <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
          <!-- The card's head is also where a dragged card lands to be placed before this one; the
               grip picks the card itself up (a partner's has none: disabled, so the grip style hides it). -->
          <Border x:Name="NodeCardHeader" Classes="node-drop-before">
          <DockPanel>
          <Border DockPanel.Dock="Left" Classes="unit-grip node-grip" x:Name="NodeGrip" Margin="0,2,6,0"
                  IsEnabled="{Binding IsMovable}"
                  ToolTip.Tip="Ziehen, um den Abschnitt zu verschieben, oder unter BEARBEITEN einordnen"
                  AutomationProperties.Name="Abschnitt verschieben">
            <!-- The grip fills the head; its dots stay beside the card's kind, where they were. -->
            <PathIcon Width="9" Height="14" VerticalAlignment="Top" Margin="0,5,0,0"
                      Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" />
          </Border>
          <StackPanel Spacing="1">
          <!-- Auflösen sits apart from the other actions, at the card's head: it ends the node. -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <StackPanel Grid.Column="0" Spacing="1">
              <TextBlock Classes="card-kind" Text="{Binding KindLabel}" />
              <SelectableTextBlock Classes="card-name" x:Name="NodeCardName" Text="{Binding Name}" />
              <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding Auftrag}"
                         IsVisible="{Binding Auftrag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="board-action" Content="AUFLÖSEN" VerticalAlignment="Top"
                    Command="{Binding DissolveCommand}"
                    ToolTip.Tip="{Binding DissolveBlockedReason}" ToolTip.ShowOnDisabled="True" />
          </Grid>
          <TextBlock x:Name="DissolveBlockedText" Classes="dissolve-reason" Margin="0,2,0,0" Text="{Binding DissolveBlockedReason}"
                     Classes.blocked="{Binding DissolveBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <!-- The node's Funkgruppen (#828, #878), one per line, each marked against the level
               above; the hint says which kind has none in common. These rows sit below AUFLÖSEN,
               not beside it: beside it the value column was too narrow for "FW_FFB (KW: 2062)". -->
          <Grid ColumnDefinitions="76,*" Margin="0,3,0,0" IsVisible="{Binding HasTmo}">
            <TextBlock Grid.Column="0" Classes="field-label" Text="TMO" VerticalAlignment="Top" />
            <ItemsControl Grid.Column="1" x:Name="NodeTmo" Classes="funk-lines" ItemsSource="{Binding TmoLines}"
                          ItemTemplate="{StaticResource FunkgruppeLineTemplate}" />
          </Grid>
          <Grid ColumnDefinitions="76,*" Margin="0,3,0,0" IsVisible="{Binding HasDmo}">
            <TextBlock Grid.Column="0" Classes="field-label" Text="DMO" VerticalAlignment="Top" />
            <ItemsControl Grid.Column="1" x:Name="NodeDmo" Classes="funk-lines" ItemsSource="{Binding DmoLines}"
                          ItemTemplate="{StaticResource FunkgruppeLineTemplate}" />
          </Grid>
          <TextBlock x:Name="NodeFunkHint" Classes="board-hint" Margin="0,3,0,0" Text="{Binding FunkHint}"
                     IsVisible="{Binding FunkHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Grid ColumnDefinitions="76,*" Margin="0,3,0,0"
                IsVisible="{Binding Rufname, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Grid.Column="0" Classes="field-label" Text="RUFNAME" />
            <SelectableTextBlock Grid.Column="1" Classes="field-value" Text="{Binding Rufname}" />
          </Grid>
          <Grid ColumnDefinitions="76,*" Margin="0,3,0,0"
                IsVisible="{Binding Standort, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Grid.Column="0" Classes="field-label" Text="STANDORT" />
            <SelectableTextBlock Grid.Column="1" Classes="field-value" Text="{Binding Standort}" />
          </Grid>
          <Grid ColumnDefinitions="76,*" Margin="0,3,0,0"
                IsVisible="{Binding Fuehrungsfahrzeug, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Grid.Column="0" Classes="field-label" Text="FAHRZEUG" />
            <SelectableTextBlock Grid.Column="1" Classes="field-value" x:Name="NodeFahrzeug" Text="{Binding Fuehrungsfahrzeug}" />
          </Grid>
          <Grid ColumnDefinitions="76,*" Margin="0,3,0,0"
                IsVisible="{Binding Telefon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Grid.Column="0" Classes="field-label" Text="TELEFON" />
            <SelectableTextBlock Grid.Column="1" Classes="field-value" Text="{Binding Telefon}" />
          </Grid>
          </StackPanel>
          </DockPanel>
          </Border>


          <Grid ColumnDefinitions="76,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="{Binding LeiterLabel}" />
            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="field-value"
                       Text="{Binding Leiter.Text, FallbackValue='—', TargetNullValue='—'}" />
            <Button Grid.Row="0" Grid.Column="2" Classes="board-action" Content="FESTLEGEN"
                    ToolTip.Tip="{Binding SetLeiterTip}" AutomationProperties.Name="{Binding SetLeiterTip}"
                    Command="{Binding SetLeiterCommand}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="MELDER" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="field-value"
                       Text="{Binding Melder.Text, FallbackValue='—', TargetNullValue='—'}" />
            <Button Grid.Row="1" Grid.Column="2" Classes="board-action" Content="FESTLEGEN"
                    ToolTip.Tip="Melder festlegen" AutomationProperties.Name="Melder festlegen"
                    Command="{Binding SetMelderCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource PersonRowTemplate}"
                        IsVisible="{Binding Members.Count}" />

          <!-- The units table. Shown whenever the card has a sum, so an Abschnitt whose units all sit
               in Unterabschnitte still heads its SUMME row with EINHEITEN / STÄRKE / AGT, and
               whenever it has rows, which a Bereitstellungsraum's waiting units are without a sum. -->
          <StackPanel Spacing="5" IsVisible="{Binding HasUnitTable}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BoardGrip" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BoardStrength" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BoardAgt" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BoardMove" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Classes="field-label" Text="EINHEITEN" />
              <TextBlock Grid.Column="2" Classes="field-label" Text="STÄRKE" HorizontalAlignment="Right"
                         ToolTip.Tip="Zugführer / Gruppenführer / Mannschaft / Gesamt" />
              <TextBlock Grid.Column="3" Classes="field-label" Text="AGT" HorizontalAlignment="Right"
                         ToolTip.Tip="Atemschutzgeräteträger" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Units}" ItemTemplate="{StaticResource UnitRowTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <!-- What the card adds up to. An Abschnitt's Unterabschnitte hang below it on the chart, so
               while it has any the label says it counts them ("SUMME INKL. UA"). -->
          <Border x:Name="NodeStrengthTotal" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
                  Padding="0,5,0,0" IsVisible="{Binding HasStrengthTotal}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BoardGrip" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BoardStrength" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BoardAgt" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BoardMove" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" x:Name="NodeStrengthLabel" Classes="field-label" Text="{Binding StrengthLabel}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" x:Name="NodeStrengthTotalText" Classes="mono" HorizontalAlignment="Right"
                         FontWeight="SemiBold" Text="{Binding StrengthTotal}"
                         ToolTip.Tip="Zugführer / Gruppenführer / Mannschaft / Gesamt, Unterabschnitte eingerechnet" />
              <TextBlock Grid.Column="3" x:Name="NodeScbaTotalText" Classes="mono" HorizontalAlignment="Right"
                         MinWidth="22" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding ScbaTotal}"
                         ToolTip.Tip="davon Atemschutzgeräteträger" />
            </Grid>
          </Border>

          <TextBlock Classes="board-hint" Text="{Binding Hint}"
                     IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- The card's actions, and over them on an Abschnitt while a card is dragged the strip to
               hang it underneath. One cell, so the strip takes the row's place instead of pushing
               the chart down under the pointer the moment a drag starts. -->
          <Grid>
            <WrapPanel Classes="card-actions" Classes.abschnitt="{Binding IsAbschnitt}"
                       Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
              <Button Classes="board-action" Content="BEARBEITEN" Command="{Binding EditCommand}" />
              <Button Classes="board-action" Content="+ UNTERABSCHNITT" IsVisible="{Binding IsAbschnitt}"
                      ToolTip.Tip="Unterabschnitt bilden" Command="{Binding AddUnterabschnittCommand}" />
              <Button Classes="board-action" Content="+ FUNKTION"
                      ToolTip.Tip="Funktion hinzufügen" Command="{Binding AddMemberCommand}" />
            </WrapPanel>
            <Border x:Name="NodeIntoStrip" Classes="node-drop-strip node-drop-into" Classes.abschnitt="{Binding IsAbschnitt}">
              <TextBlock Classes="secondary" FontSize="11" VerticalAlignment="Center" Text="hier als Unterabschnitt einordnen" />
            </Border>
          </Grid>
        </StackPanel>
        <!-- A dragged card would land before this one: see Border.drop-before-bar. -->
        <Border x:Name="DropBeforeBar" Classes="drop-before-bar" IsHitTestVisible="False" />
        </Panel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- The board, and over its foot the reason a place refuses what is held over it. -->
  <Panel>
  <ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="BoardRoot" Spacing="14" Background="Transparent" Classes.dragging-node="{Binding IsDraggingNode}"
                IsEnabled="{Binding !IsReadOnly}" DragDrop.AllowDrop="{Binding !IsReadOnly}">

      <!-- Why the last board command was refused (a peer dissolved the node a moment ago). -->
      <TextBlock x:Name="LeadershipActionError" Classes="field-error"
                 Text="{Binding ActionError}"
                 IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- The Leitstelle the Einsatzleitung reports to, at the head of the sheet. -->
      <Border x:Name="DispatchCentreBadge" HorizontalAlignment="Left" Background="{StaticResource SurfaceTopBrush}"
              BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusSm}" Padding="12,4">
        <TextBlock Classes="mono" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DispatchCentreName}" />
      </Border>

      <!-- The org chart, as on the A3 sheet: the Einsatzleitung with its peers beside it (dashed),
           then a line down to each Bereitstellung and Abschnitt, and from each Abschnitt down to its
           Unterabschnitte. Wider than the window it scrolls sideways on its own, so the rest of the
           board keeps the window's width. The lines come from the element right above each list. -->
      <ScrollViewer x:Name="ChartScroll" VerticalScrollBarVisibility="Disabled">
        <ctrl:OrgChart x:Name="OrgChartLines" LineBrush="{StaticResource BorderStrongBrush}">
        <StackPanel x:Name="OrgChart">
          <ItemsControl x:Name="TopRowCards" ItemsSource="{Binding TopRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <ctrl:OrgPeersPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl x:Name="SectionCards" ItemsSource="{Binding Sections}" IsVisible="{Binding Sections.Count}"
                        ItemTemplate="{StaticResource NodeBranchTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <ctrl:OrgChildrenPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
        </ctrl:OrgChart>
      </ScrollViewer>

      <!-- The add buttons, and over them while a card is dragged the strip to put it last, as an
           Abschnitt of its own: one cell, as on a card, so nothing moves when the drag starts. -->
      <Grid>
      <WrapPanel x:Name="BoardActions" Classes="board-actions" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
        <Button x:Name="LeadershipAddAbschnittButton" Classes="signal board-action" Content="+ ABSCHNITT"
                ToolTip.Tip="Abschnitt bilden" Command="{Binding AddAbschnittCommand}" />
        <Button x:Name="AddBereitstellungButton" Classes="board-action" Content="+ BEREITSTELLUNG"
                ToolTip.Tip="Bereitstellungsraum bilden" Command="{Binding AddBereitstellungCommand}" />
        <Button x:Name="AddRettungsdienstButton" Classes="board-action" Content="+ RETTUNGSDIENST"
                ToolTip.Tip="{Binding RettungsdienstTip}" ToolTip.ShowOnDisabled="True"
                Command="{Binding AddPartnerCommand}" CommandParameter="Rettungsdienst" />
        <Button x:Name="AddPolizeiButton" Classes="board-action" Content="+ POLIZEI"
                ToolTip.Tip="{Binding PolizeiTip}" ToolTip.ShowOnDisabled="True"
                Command="{Binding AddPartnerCommand}" CommandParameter="Polizei" />
        <Button x:Name="AddPartnerButton" Classes="board-action" Content="+ WEITERE"
                ToolTip.Tip="Einsatzleitung einer weiteren Organisation bilden"
                Command="{Binding AddPartnerCommand}" />
        <Button x:Name="AddFachberaterButton" Classes="board-action" Content="+ FACHBERATER"
                ToolTip.Tip="Fachberater hinzufügen" Command="{Binding AddFachberaterCommand}" />
      </WrapPanel>
      <Border x:Name="NodeEndStrip" Classes="node-drop-strip node-drop-end">
        <TextBlock Classes="secondary" FontSize="11" VerticalAlignment="Center" Text="hier als letzten Abschnitt einordnen" />
      </Border>
      </Grid>

      <ItemsControl x:Name="EinsatzleitungHints" ItemsSource="{Binding Hints}" IsVisible="{Binding Hints.Count}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="board-hint" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>


      <!-- The units nobody has placed; also where a dragged unit goes to be taken out of its Abschnitt. -->
      <Border x:Name="UnplacedStrip" Classes="board-card">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="HasUnplacedUnits" />
            <Binding Path="IsDraggingUnit" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel Spacing="8">
          <TextBlock Classes="overline" FontSize="10" Text="NICHT ZUGEORDNET" />
          <TextBlock Classes="secondary" FontSize="12" Text="Hier ablegen, um die Einheit aus ihrem Abschnitt zu nehmen."
                     IsVisible="{Binding !HasUnplacedUnits}" />
          <ItemsControl x:Name="UnplacedUnits" Classes="board-chips" ItemsSource="{Binding UnplacedUnits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BoardUnitRow">
                <Border Classes="unit-chip" Grid.IsSharedSizeScope="True">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UnitRowTemplate}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Funktionen typed on FUNKTIONEN with a free-text Abschnitt: shown, so nobody disappears, and
           taken into the structure with one button (#824). -->
      <ItemsControl x:Name="FreeTextSectionCards" Classes="board-wrap" ItemsSource="{Binding FreeTextSections}"
                    IsVisible="{Binding HasFreeTextSections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FreeTextSectionCard">
            <Border Classes="board-card">
              <StackPanel Spacing="6">
                <TextBlock Classes="secondary" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                <!-- ÄNDERN corrects the typed Abschnitt too, now that it is no place on the board. -->
                <ItemsControl ItemsSource="{Binding People}" ItemTemplate="{StaticResource AssistantRowTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button x:Name="AdoptFreeTextSectionButton" Classes="board-action" Content="ALS ABSCHNITT ÜBERNEHMEN"
                        HorizontalAlignment="Left" Margin="0,4,0,0"
                        Command="{Binding AdoptCommand}"
                        AutomationProperties.Name="{Binding AdoptAutomationName}"
                        ToolTip.Tip="Abschnitt bilden (oder den gleichnamigen nehmen) und die Funktionen dort einordnen" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>

  <!-- Over the board, not in it: it neither moves the cards under the pointer nor scrolls away,
       and it takes no hits, so the drop still lands on the card beneath. -->
  <Border x:Name="DropRefusalBanner" Classes="drop-refusal" IsHitTestVisible="False"
          IsVisible="{Binding DropRefusal, Converter={x:Static ObjectConverters.IsNotNull}}">
    <TextBlock x:Name="DropRefusalText" Text="{Binding DropRefusal}" />
  </Border>
  </Panel>
</UserControl>
