<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Feuerwehr.AppLogic.ViewModels;assembly=Feuerwehr.AppLogic"
             x:Class="Feuerwehr.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Grid>
    <!-- Faint diagonal hazard texture in the corner for atmosphere -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="320" Height="320"
            Margin="0,-60,-60,0" Opacity="0.05" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#FF3D2E" Offset="0" />
          <GradientStop Color="Transparent" Offset="0.7" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="56,48" Spacing="28" MaxWidth="720" HorizontalAlignment="Center">
        <!-- Greeting -->
        <StackPanel Spacing="6">
          <TextBlock Text="EINSATZBEREIT" Classes="overline" Foreground="{StaticResource ActiveBrush}" />
          <TextBlock Text="Lagebuch" Classes="display" FontSize="38" />
          <TextBlock Classes="secondary" FontSize="15" TextWrapping="Wrap"
                     Text="Dokumentation für den Einsatz. Lege einen neuen Einsatz an oder öffne ein bestehendes Lagebuch." />
        </StackPanel>

        <!-- Open-failure banner: matches the read-only banner in the workspace -->
        <Border x:Name="OpenErrorBanner" Background="#241608"
                BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}" Padding="14,10"
                IsVisible="{Binding OpenError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <!-- Grid, not a horizontal StackPanel: the latter measures children at infinite width,
               so the message would never wrap and the banner would outgrow the column. -->
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="⚠" FontSize="15" VerticalAlignment="Top" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" x:Name="OpenErrorMessage" Text="{Binding OpenError}"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource AmberBrush}" />
          </Grid>
        </Border>

        <!-- Recent incidents panel -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}" Padding="22,20"
                BoxShadow="{StaticResource PanelShadow}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="ZULETZT VERWENDET" Classes="overline" VerticalAlignment="Center" />
              <Border Grid.Column="1" Height="1" Background="{StaticResource HairlineBrush}"
                      VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>

            <ListBox x:Name="RecentList" ItemsSource="{Binding RecentFiles}"
                     SelectionMode="Single" MaxHeight="420" />

            <TextBlock Classes="secondary" FontSize="12"
                       IsVisible="{Binding !RecentFiles.Count}"
                       Text="Noch keine Einsätze. Beginne oben rechts mit „Neuer Einsatz“." />
            <TextBlock Classes="secondary mono" FontSize="11" Opacity="0.7"
                       IsVisible="{Binding RecentFiles.Count}"
                       Text="↩  Doppelklick zum Öffnen" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
