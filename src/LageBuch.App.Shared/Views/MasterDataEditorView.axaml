<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             x:Class="LageBuch.App.Shared.Views.MasterDataEditorView"
             x:DataType="vm:MasterDataEditorViewModel">
  <Panel>
    <DockPanel Margin="28,24">
      <!-- Header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="STAMMDATEN" Classes="display" FontSize="26" />
          <Border x:Name="DirtyDot" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                  Background="#241608" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                  Padding="8,3" IsVisible="{Binding IsDirty}">
            <TextBlock Text="Nicht gespeichert" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource AmberBrush}" />
          </Border>
          <Border x:Name="FileErrorBanner" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                  Background="#2A1013" BorderBrush="#F87171" BorderThickness="1" Padding="8,3"
                  IsVisible="{Binding FileError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding FileError}" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" />
          </Border>
          <!-- Fahrzeuge sind eindeutig (#76 follow-up): doppelte Funkrufnamen blockieren das
               Speichern, die Meldung nennt die Konflikte. -->
          <Border x:Name="VehicleConflictsBanner" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}"
                  Background="#2A1013" BorderBrush="#F87171" BorderThickness="1" Padding="8,3"
                  IsVisible="{Binding VehicleConflicts, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding VehicleConflicts}" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="ImportButton" Content="IMPORTIEREN" Command="{Binding ImportCommand}" />
          <Button x:Name="ExportButton" Content="EXPORTIEREN" Command="{Binding ExportCommand}" />
          <Button x:Name="DiscardButton" Content="VERWERFEN" Command="{Binding DiscardCommand}" />
          <Button x:Name="SaveButton" Classes="signal" Content="SPEICHERN" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>

      <!-- Master-detail -->
      <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" Padding="6" Margin="0,0,16,0">
          <ListBox x:Name="CategoryList" ItemsSource="{Binding Sections}"
                   SelectedItem="{Binding SelectedSection}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EditorSection">
                <TextBlock Text="{Binding Title}" Padding="6,4" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Border Grid.Column="1" Background="#0C1119"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" Padding="16" ClipToBounds="True">
          <ContentControl Content="{Binding SelectedSection}">
            <ContentControl.DataTemplates>

              <!-- Operational defaults (timers/durations) -->
              <DataTemplate x:DataType="vm:SettingsSection">
                <ScrollViewer>
                  <StackPanel Spacing="12" MaxWidth="440" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Rückmeldung an ILS – Erstmeldung nach" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding IlsReminderIntervalMinutes}"
                                     Minimum="1" Maximum="120" Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Min." Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Rückmeldung an ILS – Intervall" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding IlsReminderFollowUpIntervalMinutes}"
                                     Minimum="1" Maximum="120" Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Min." Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Einsatzzeit AGT" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding AgtMaxDurationMinutes}"
                                     Minimum="1" Maximum="180" Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Min." Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Einsatzzeit CSA-Trupp" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding CsaMaxDurationMinutes}"
                                     Minimum="1" Maximum="180" Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Min." Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Einsatzzeit LPA" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding LpaMaxDurationMinutes}"
                                     Minimum="1" Maximum="180" Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Min." Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Atemschutzkontrolle – Intervall" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding PressureControlIntervalMinutes}"
                                     Minimum="1" Maximum="60" Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Min." Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,140,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Rückzugsdruck" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding ReturnPressureBar}"
                                     Minimum="0" Maximum="400" Increment="5" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="bar" Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>

              <!-- String-list / checklist editor -->
              <DataTemplate x:DataType="vm:EditableListSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MasterDataItem">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
                            <TextBox Grid.Column="0" Text="{Binding Value}" />
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="1" Content="▲" Margin="6,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="2" Content="▼" Margin="4,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="3" Content="✕" Margin="4,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Checkliste template editor (Aufbau/Abbau): text + mandatory, reorderable -->
              <DataTemplate x:DataType="vm:ChecklistTemplateSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChecklistTemplateRow">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
                            <TextBox Grid.Column="0" Text="{Binding Text}" Margin="0,0,6,0" />
                            <CheckBox Grid.Column="1" Content="Pflicht" IsChecked="{Binding IsMandatory}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="2" Content="▲" Margin="0,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="3" Content="▼" Margin="4,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="4" Content="✕" Margin="4,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Links editor: name + URL, reorderable -->
              <DataTemplate x:DataType="vm:LinksSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Column headers (#137): each row is unlabeled otherwise. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,Auto,Auto,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="NAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="URL" Classes="overline" FontSize="10" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkRow">
                          <Grid ColumnDefinitions="*,*,Auto,Auto,Auto" Margin="0,0,0,6">
                            <TextBox Grid.Column="0"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.LinkNamePlaceholder}"
                                     Text="{Binding Name}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.LinkUrlPlaceholder}"
                                     Text="{Binding Url}" Margin="0,0,6,0" />
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="2" Content="▲" Margin="0,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="3" Content="▼" Margin="4,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="4" Content="✕" Margin="4,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Vehicles editor (#76): Wache + Funkrufname + Sitzplätze, reorderable.
                   NumericUpDown has no watermark, so the seat field carries its unit label beside
                   it — same convention as the Kräfte entry dock. -->
              <DataTemplate x:DataType="vm:VehiclesSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ HINZUFÜGEN"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Column headers (#137): each row is unlabeled otherwise. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,150,Auto,Auto,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="WACHE" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="FUNKRUFNAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="2" Text="SITZPLÄTZE" Classes="overline" FontSize="10" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VehicleRow">
                          <Grid ColumnDefinitions="*,*,150,Auto,Auto,Auto" Margin="0,0,0,6">
                            <!-- AutoCompleteBox statt ComboBox: Vorschläge aus den Stammdaten,
                                 aber Freitext bleibt möglich (Fremdwehren), wie im Kräfte-Dock. -->
                            <AutoCompleteBox Grid.Column="0"
                                             PlaceholderText="{x:Static md:AnonymizedExampleData.BrigadePlaceholder}"
                                             ItemsSource="{Binding WacheOptions}"
                                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                             Text="{Binding Wache}" Margin="0,0,6,0" />
                            <AutoCompleteBox Grid.Column="1"
                                             PlaceholderText="{x:Static md:AnonymizedExampleData.CallSignPlaceholder}"
                                             ItemsSource="{Binding CallSignOptions}"
                                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                             Text="{Binding CallSign}" Margin="0,0,6,0" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                              <NumericUpDown Width="90" Minimum="0" Maximum="99" Increment="1" FormatString="0"
                                             Value="{Binding Seats}" VerticalAlignment="Center" />
                              <TextBlock Text="Sitzplätze" Classes="secondary" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- ReflectionBinding: the section commands live on the parent ItemsControl's
                                 DataContext, whose static type is object under compiled bindings, so a
                                 compiled $parent cast path won't resolve. -->
                            <Button Grid.Column="3" Content="▲" Margin="0,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveUpCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="4" Content="▼" Margin="4,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.MoveDownCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="5" Content="✕" Margin="4,0,0,0"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

              <!-- Personnel editor -->
              <DataTemplate x:DataType="vm:PersonnelSection">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Classes="signal" Content="+ PERSON"
                          HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddCommand}" />
                  <!-- Column headers (#137): each row is unlabeled otherwise. -->
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,110,120,150,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="NACHNAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="VORNAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="2" Text="ROLLE" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="3" Text="RUFNAME" Classes="overline" FontSize="10" />
                    <TextBlock Grid.Column="4" Text="TELEFON" Classes="overline" FontSize="10" />
                  </Grid>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonRow">
                          <Grid ColumnDefinitions="*,*,110,120,150,Auto" Margin="0,0,0,6">
                            <TextBox Grid.Column="0"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.PersonLastNamePlaceholder}"
                                     Text="{Binding LastName}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.PersonFirstNamePlaceholder}"
                                     Text="{Binding FirstName}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.RolePlaceholder}"
                                     Text="{Binding Role}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="3"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.CallSignPlaceholder}"
                                     Text="{Binding CallSign}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="4"
                                     PlaceholderText="{x:Static md:AnonymizedExampleData.PhoneNumberPlaceholder}"
                                     Text="{Binding Phone}" Margin="0,0,6,0" />
                            <Button Grid.Column="5" Content="✕"
                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </DataTemplate>

            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>
      </Grid>
    </DockPanel>

    <!-- Discard-guard overlay, resolved by ViewLocator to ConfirmDialogView -->
    <ContentControl Content="{Binding PendingConfirm}"
                    IsVisible="{Binding PendingConfirm, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Panel>
</UserControl>
