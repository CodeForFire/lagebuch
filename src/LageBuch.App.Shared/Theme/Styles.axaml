<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
        xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LageBuch.App.Shared/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- =========================================================
       GLOBAL TEXT
       ========================================================= -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Display / heading -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- Section / overline label: condensed, tracked-out, muted -->
  <Style Selector="TextBlock.overline">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="LetterSpacing" Value="2.5" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>

  <!-- A field's "you still have to fill this in" line (#412). Same shape as the amber hints that
       sit under ForcesView's and RolesView's forms, red because those describe something the app
       will accept anyway and this describes the reason a press did nothing. -->
  <Style Selector="TextBlock.field-error">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>

  <!-- Tactical monospace: timestamps, call-signs, numbers -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.metric">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- =========================================================
       BUTTONS — default = quiet outline; .signal = primary
       ========================================================= -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceTopBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2C3848" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#161D27" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Primary signal button -->
  <Style Selector="Button.signal">
    <Setter Property="Background" Value="{StaticResource SignalGradientBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SignalHotBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.signal:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SignalHotBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SignalHotBrush}" />
  </Style>
  <Style Selector="Button.signal:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SignalDeepColor}" />
  </Style>

  <!-- Ghost button: text-only, used in header nav -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1C2531" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Bar button: a whole header banner made tappable (#422), keeping the banner's own colours.
       The default button sets a fixed ControlHeight and a 16px side padding, neither of which
       suits a full-width bar, and any background of its own would cover the banner behind it.
       Each instance therefore brings the padding the Border used to carry. The hover tint is a
       white wash rather than a fixed colour, so it reads on the amber Druckabfrage bar and on the
       red Rückzugsalarm banner alike. -->
  <Style Selector="Button.bar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26FFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3DFFFFFF" />
  </Style>
  <!-- The default button's press shrinks itself by 3%, which on a full-width banner reads as the
       whole header twitching. The background wash above is the press feedback here. -->
  <Style Selector="Button.bar:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- ===================== Header Meldungen =====================
       One anatomy for everything the header has to tell the Lagebuchführer, modelled on the
       annunciator panel of a Leitstelle: every row leads with a tile that names its module, the
       tiles line up in one column (SharedSizeGroup "MeldungTile"), and a tile LIGHTS UP when the
       row needs someone. Colour says how urgent, never which module:
         .info   unlit tile, quiet row          - a state (read-only)
         .due    amber tile, amber-washed row   - due, act on it (ILS, Druckabfrage, Aufgabe)
         .error  red tile, red-washed row       - data is being lost
         .alarm  the whole row lit signal red   - Rückzugsalarm, the one loud thing
       A countdown that is merely running is not a row at all: it is a readout on the quiet
       strip (Border.meldung-strip) and becomes a row when it falls due. -->
  <Style Selector="Border.meldung">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
  </Style>
  <Style Selector="Border.meldung.due">
    <Setter Property="Background" Value="{StaticResource AmberWashBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AmberDeepBrush}" />
  </Style>
  <Style Selector="Border.meldung.error">
    <Setter Property="Background" Value="{StaticResource ErrorWashBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ErrorDeepBrush}" />
  </Style>
  <Style Selector="Border.meldung.alarm">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Background" Value="{StaticResource SignalGradientBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SignalHotBrush}" />
    <Setter Property="BoxShadow" Value="0 0 22 -2 #CCFF3D2E" />
  </Style>

  <!-- A row's jump fills the row, so the tile inside it reaches top to bottom. -->
  <Style Selector="Border.meldung Button.bar">
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.meldung-tile">
    <Setter Property="Padding" Value="12,0,14,0" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.meldung.due Border.meldung-tile">
    <Setter Property="Background" Value="{StaticResource AmberBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
  </Style>
  <Style Selector="Border.meldung.error Border.meldung-tile">
    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="Border.meldung.alarm Border.meldung-tile">
    <Setter Property="Background" Value="{StaticResource SignalDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SignalDeepBrush}" />
  </Style>

  <Style Selector="TextBlock.meldung-label">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="PathIcon.meldung-icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.meldung.due TextBlock.meldung-label">
    <Setter Property="Foreground" Value="{StaticResource AmberInkBrush}" />
  </Style>
  <Style Selector="Border.meldung.due PathIcon.meldung-icon">
    <Setter Property="Foreground" Value="{StaticResource AmberInkBrush}" />
  </Style>
  <Style Selector="Border.meldung.error TextBlock.meldung-label">
    <Setter Property="Foreground" Value="{StaticResource ErrorInkBrush}" />
  </Style>
  <Style Selector="Border.meldung.error PathIcon.meldung-icon">
    <Setter Property="Foreground" Value="{StaticResource ErrorInkBrush}" />
  </Style>
  <Style Selector="Border.meldung.alarm TextBlock.meldung-label">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Border.meldung.alarm PathIcon.meldung-icon">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="TextBlock.meldung-text">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Margin" Value="14,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.meldung.info TextBlock.meldung-text">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.meldung.alarm TextBlock.meldung-text">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- The chevron at a jump row's end: the row is the way to the thing it names (#422). -->
  <Style Selector="PathIcon.meldung-chevron">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.meldung.alarm PathIcon.meldung-chevron">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="StackPanel.meldung-actions">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.meldung-actions > Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Border.meldung.alarm StackPanel.meldung-actions > Button">
    <Setter Property="Height" Value="38" />
  </Style>

  <!-- The quiet strip: countdowns that are running, not due. Readouts, not rows - no tile, no
       tint; the time is the only thing set bright. -->
  <Style Selector="Border.meldung-strip">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
  </Style>
  <Style Selector="TextBlock.meldung-readout-label">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <!-- Controls that only a narrow layout shows. The default has to live in a Style, not as
       IsVisible="False" on the control: a local value in XAML outranks every Style setter, so a
       container query could never turn them back on. Same reason as meldung-readout-short below. -->
  <Style Selector="Button.narrow-only">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.narrow-only">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- The short form a narrow header swaps in for the label (IncidentWorkspaceView's query). -->
  <Style Selector="TextBlock.meldung-readout-short">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TextBlock.meldung-readout-name">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.meldung-readout-value">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- Icon-only button: compact square, ghost background. Used for row actions (e.g. the ETB
       grid) where a labelled button would not fit. Give each instance a ToolTip.Tip, since the
       icon alone carries no text. -->
  <Style Selector="Button.icon-btn">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1C2531" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon-btn PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover PathIcon">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- =========================================================
       INPUTS — TextBox / ComboBox / NumericUpDown
       ========================================================= -->
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="Background" Value="#0C1119" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource SignalBrush}" />
    <Setter Property="SelectionBrush" Value="#40FF3D2E" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <!-- Every other control that pairs a fixed/MinHeight with Padding (Button, TabItem) also sets
         this, so the padding-vs-box-height gap resolves to a centered content, not top-aligned
         (Avalonia's default). Standard Padding="11,7" against MinHeight=ControlHeight leaves that
         gap small enough to go unnoticed, but a denser TextBox (smaller Padding/FontSize, e.g. the
         CO-Messung apartment header, #234) exposes text sitting near the top with visible empty
         space below. -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="Background" Value="#0C1119" />
  </Style>
  <!-- Text inputs show focus on their own edge, on any focus: a click into a field must show where
       the typing goes too. So they take the focus colour on :focus and no adorner (#541). -->
  <Style Selector="TextBox, ComboBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
    <Setter Property="Background" Value="#0C1119" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <!-- ComboBox -->
  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="Background" Value="#0C1119" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="PlaceholderForeground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="Background" Value="#0C1119" />
  </Style>
  <Style Selector="ComboBox:focus /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
    <Setter Property="Background" Value="#0C1119" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="11,8" />
  </Style>

  <!-- AutoCompleteBox — an editable text field backed by a suggestion list (call-sign, personnel
       names). Fluent's template hosts an inner TextBox and pushes the AutoCompleteBox's OWN
       Background/Foreground/BorderBrush/BorderThickness/CornerRadius/Padding down onto it via
       {TemplateBinding}. Those bindings apply at Template priority, which outranks the global
       "TextBox" style (Style priority) — so without this style the field ignores the app tokens and
       falls back to Fluent's pale default border (#99FFFFFF) and fill. Set them here to match the
       TextBox theme; the hover/focus edge is already handled, because the inner TextBox is a real
       TextBox and picks up the TextBox:pointerover / :focus template-child styles above. -->
  <Style Selector="AutoCompleteBox">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="Background" Value="#0C1119" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <!-- One keyboard model app-wide (#466): the list opens on focus/click (#259), a single prefix
         match completes inline, Shift+Tab never takes a match — see Behaviors/SuggestionBox.cs. -->
    <Setter Property="b:SuggestionBox.IsEnabled" Value="True" />
  </Style>

  <!-- NumericUpDown

       Integer by default. Every numeric input in this app is a count — Personen, AGT, Minuten,
       bar — and none has a fractional meaning. Left at the control's defaults (ParsingNumberStyle
       Any, no FormatString) a typed "3.5" is kept as 3.5 by the control and displayed as such,
       while the int-typed view-model property rounds it to 4: the number on screen is not the
       number written into the Einsatz record. Integer parsing refuses the fraction outright, and
       FormatString pins the display to whole numbers. A future input that genuinely needs decimals
       can override both locally. -->
  <Style Selector="NumericUpDown">
    <Setter Property="ParsingNumberStyle" Value="Integer" />
    <Setter Property="FormatString" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Background" Value="#0C1119" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <!-- Spinner arrows are fiddly for counts up to a few hundred (Druck, Minuten); typing the
         value directly is the primary interaction everywhere in this app. -->
    <Setter Property="ShowButtonSpinner" Value="False" />
  </Style>

  <!-- Labeled field wrapper (#137): caption above an arbitrary input control. Styling the
       built-in HeaderedContentControl rather than a bespoke control means a field can't be added
       without a Header showing up somewhere in the tree — an empty label slot is visually obvious
       in review, unlike a bare input silently missing its TextBlock sibling. -->
  <!-- One template for every variant, with the parts switched on by the class selectors below.
       It used to be copied per combination, which was already a near-duplicate at two variants and
       would have become four the moment mandatory fields (#414) wanted a marker of their own. -->
  <Style Selector="HeaderedContentControl.field">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Classes="overline" FontSize="10" Text="{TemplateBinding Header}" />
            <!-- Mandatory marker (#414): shape and colour together, because a colour-only signal
                 is lost to glare on an ELW screen. Opt in with Classes="field required". -->
            <TextBlock x:Name="RequiredMarker" Classes="overline" FontSize="10" Text="*"
                       IsVisible="False" />
          </StackPanel>
          <Grid>
            <ContentPresenter Content="{TemplateBinding Content}" />
            <!-- Suggestion marker (#259): signals the input is backed by a suggestion list
                 (AutoCompleteBox), not free text. A non-hit-testable overlay rather than a template
                 override on AutoCompleteBox itself, which needs its own template intact for the
                 popup wiring. Opt in per field with Classes="field suggest". -->
            <PathIcon x:Name="SuggestChevron" Width="9" Height="9" IsVisible="False"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,9,0" IsHitTestVisible="False"
                      Foreground="{StaticResource TextMutedBrush}"
                      Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
          </Grid>
          <!-- Missing-input message (#412), bound per field with ctrl:Field.Error. Not a
               TemplateBinding: that takes a single property name and would bind nothing at all
               here, silently, because an attached property is a path. -->
          <TextBlock x:Name="FieldError" Classes="field-error"
                     Text="{Binding (ctrl:Field.Error), RelativeSource={RelativeSource TemplatedParent}}"
                     IsVisible="{Binding (ctrl:Field.Error), RelativeSource={RelativeSource TemplatedParent},
                                         Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="HeaderedContentControl.field.suggest /template/ PathIcon#SuggestChevron">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- The asterisk is only seen. A screen reader lands on the input, not on the caption, so the
       input itself says it is required. TextBox also covers the one inside an AutoCompleteBox or a
       NumericUpDown. -->
  <!-- Foreground here rather than on the template part: a value set inside a template ranks
       below any style, so TextBlock.overline would repaint the asterisk in caption grey. -->
  <Style Selector="HeaderedContentControl.field.required /template/ TextBlock#RequiredMarker">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="HeaderedContentControl.field.required TextBox">
    <Setter Property="AutomationProperties.IsRequiredForForm" Value="True" />
  </Style>
  <Style Selector="HeaderedContentControl.field.required ComboBox">
    <Setter Property="AutomationProperties.IsRequiredForForm" Value="True" />
  </Style>

  <!-- A field the form is waiting on (#412). Set with Classes.invalid from the same error string
       that feeds the message, so the input says *which* field while the text says what is needed.
       Costs no layout at all, which is the point: in a dense horizontal dock a message under each
       field makes that field as wide as its text and pushes the action button out of reach.
       The BorderBrush transition on the inputs above carries it in, so it reads as the answer to
       the press rather than as something that was always there. -->
  <Style Selector="HeaderedContentControl.field.invalid TextBox">
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="HeaderedContentControl.field.invalid ComboBox">
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="HeaderedContentControl.field.invalid AutoCompleteBox TextBox">
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="HeaderedContentControl.field.invalid NumericUpDown">
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
  </Style>

  <!-- =========================================================
       CHECKBOX
       ========================================================= -->
  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- =========================================================
       TABCONTROL — left rail "dispatch sidebar"
       ========================================================= -->
  <Style Selector="TabControl">
    <Setter Property="TabStripPlacement" Value="Left" />
    <Setter Property="Padding" Value="0" />
    <!-- The stock Fluent TabControl template seats its ItemsPresenter directly in a DockPanel.
         With TabStripPlacement="Left" the theme v-flips the presenter's default WrapPanel, and on
         a viewport too short to fit every rail tab the WrapPanel wraps into extra side-by-side
         columns instead of overflowing. Wrapping the presenter in a ScrollViewer (which takes the
         Dock role) gives the WrapPanel unbounded height in its wrap direction, so the rail stays a
         single column and grows a scrollbar instead (#146). This is the upstream 12.1.1 template
         with exactly that one change; PART_ItemsPresenter keeps its name so the theme's own
         ^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel rule
         and the app's Margin=0 rule below still find and apply to it. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{TemplateBinding Background}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                VerticalAlignment="{TemplateBinding VerticalAlignment}">
          <DockPanel>
            <ScrollViewer DockPanel.Dock="{TemplateBinding TabStripPlacement}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
            <Panel ClipToBounds="True">
              <ContentPresenter Name="PART_SelectedContentHost2"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="False" />
              <ContentPresenter Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="20,0,20,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="Width" Value="172" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="3,*">
            <!-- active indicator rail -->
            <Border Name="Rail" Grid.Column="0" Background="Transparent" />
            <!-- ContentTemplate must follow HeaderTemplate: the rail is ItemsSource-driven, so a
                 tab's header is a view model and TabControl.ItemTemplate arrives here as
                 HeaderTemplate. Without this the presenter has no template and the app-level
                 ViewLocator claims it, rendering "Nicht gefunden: …View" in every tab. It was
                 unnecessary while every header was a literal string or panel. -->
            <ContentPresenter Grid.Column="1"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <!-- A global shortcut written next to what it opens (#544): the rail tabs, the warning bar F9
       goes to, the command bar's help. Shown inline, never only as a tooltip — a keyboard user
       never hovers. Muted, so it reads as a margin note to the label and not as a second one. -->
  <Style Selector="TextBlock.key-hint">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- On a Meldung the hint takes the chevron's colour: the muted grey all but vanishes on the
       lit Rückzugsalarm row. Declared after key-hint, because the later style wins. -->
  <Style Selector="Border.meldung TextBlock.key-hint">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.meldung.alarm TextBlock.key-hint">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- In a ghost button (the command bar's shortcut entry) the key is the label, so it takes the
       button's grey and size like the labels beside it; the glyph inherits that grey already. -->
  <Style Selector="Button.ghost TextBlock.key-hint">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TabItem:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="#161E2A" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#Root">
    <Setter Property="Background" Value="#1B2532" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#Rail">
    <Setter Property="Background" Value="{StaticResource SignalBrush}" />
  </Style>

  <!-- =========================================================
       ROW CARDS — one record per card, the narrow layout's DataGrid
       =========================================================
       A seven-column grid budgeted for a 1920px ELW monitor cannot be squeezed into 412dp, so the
       phone reads the same rows stacked: the identifying fact first, the free text in full (never
       trimmed — an entry nobody can read is an entry nobody can check), the quiet metadata and the
       row's own actions last. -->
  <Style Selector="Border.row-card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- A row action on a card is a thumb target, not a pointer target. -->
  <Style Selector="Button.card-action">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>
  <Style Selector="Button.card-action PathIcon">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
  </Style>

  <!-- =========================================================
       BOTTOM NAV BAR — the narrow layout's replacement for the rail
       =========================================================
       The 172px left rail is 42% of a 411dp phone before any content, so below the breakpoint the
       rail's TabItems are hidden and this takes over: the first four entries as thumb-reachable
       cells, the rest behind MEHR. Same vocabulary as the rail — signal-red rule on the open
       entry, the same status dots — turned through 90° and grown to a 56px touch target.
       Deliberately NOT the .icon-btn class: AutomationPropertiesTests counts every icon-btn in
       the workspace, and these exist in the visual tree at desktop widths too, merely hidden. -->
  <Style Selector="Border.navbar">
    <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Button.navcell">
    <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <!-- The default press shrinks the button 3%; on a bar cell that reads as the whole bar twitching. -->
  <Style Selector="Button.navcell:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.navcell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#161E2A" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.navcell.selected">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.navcell.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1B2532" />
  </Style>

  <!-- The open entry's marker. Mirrors the rail's 3px left rail, moved to the top edge. -->
  <Style Selector="Border.navcell-rule">
    <Setter Property="Height" Value="3" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.navcell.selected Border.navcell-rule">
    <Setter Property="Background" Value="{StaticResource SignalBrush}" />
  </Style>

  <Style Selector="PathIcon.navcell-icon">
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.navcell-label">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- =========================================================
       LISTBOX (recent files)
       ========================================================= -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="#0F141D" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,7" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="3,*">
            <Border Name="Tick" Grid.Column="0" Width="3" Margin="-14,-12" Background="Transparent"
                    CornerRadius="2,0,0,2" />
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" Margin="6,0,0,0" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ Border#Bd">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ Border#Tick">
    <Setter Property="Background" Value="{StaticResource SignalBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ Border#Bd">
    <Setter Property="Background" Value="{StaticResource SurfaceTopBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ Border#Tick">
    <Setter Property="Background" Value="{StaticResource SignalBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- A row that looks like a recent-file ListBoxItem but is not in a list: Home's last-connection
       row sits right above the recent files and must read as the same kind of thing. The left
       padding is the item's 14 plus its template's 3px tick column and 6px presenter margin, so
       the content starts where a list item's does; change both together. No hover, no tick: the
       row itself does nothing, only its buttons do. -->
  <Style Selector="Border.listRow">
    <Setter Property="Background" Value="#0F141D" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="23,12,14,12" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>
  <!-- A list row's two lines: what it is, and where it lives. -->
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.rowMeta">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- =========================================================
       DATAGRID — operational log table
       ========================================================= -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="RowHeight" Value="40" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="#0F141D" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="SeparatorBrush" Value="{StaticResource HairlineBrush}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="#14202B" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- #422: selection is an answer to a question now ("which Trupp is the banner talking about?"),
       not just a hover that stuck. The old #1C2A38 was a shade off the hover tint and all but
       invisible on the grid's #0C1119 — two rows apart, nobody could say which one was picked.
       Neutral blue-grey on purpose: the status column carries amber and red, and a highlight in
       either would read as a state the Trupp is in. -->
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="#2C4257" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- =========================================================
       SCROLLBAR — slim & dark
       ========================================================= -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
