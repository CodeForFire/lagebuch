<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sherpa-onnx binding, kept in its own project and referenced by the DESKTOP HEAD ONLY (the
    same split as LageBuch.Sync.Hosting, and for the same two reasons).

    First, the native payload: org.k2fsa.sherpa.onnx pulls every runtime package it has (android,
    linux, osx, win: about 338 MB restored), and none of that belongs anywhere near the Android
    head or the pure test projects.

    Second, the licence: the shipped libsherpa-onnx-c-api.so statically links espeak-ng, which is
    GPL-3.0-or-later. Lagebuch's own source stays MIT, but anything that links this is part of a
    combined work, and keeping that fact confined to one project is what makes it reviewable.
    See THIRD-PARTY-NOTICES.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LageBuch.Speech\LageBuch.Speech.csproj" />
  </ItemGroup>

</Project>
