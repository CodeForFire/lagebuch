<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             x:Class="LageBuch.App.Shared.Views.OperatorPromptView"
             x:DataType="vm:OperatorPromptViewModel">
  <Border Background="#B3070A10" Padding="40" Focusable="True" KeyDown="OnKeyDown">
    <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource OverlayShadow}">
      <DockPanel>
        <!-- Accent header strip -->
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource SignalGradientBrush}"
                CornerRadius="12,12,0,0" />
        <StackPanel Margin="26,22,26,24" Spacing="6">
          <TextBlock Text="DOKUMENTATION" Classes="overline" />
          <TextBlock Text="Wer dokumentiert?" Classes="display" FontSize="22" Margin="0,0,0,8" />
          <!-- Join flow only (§6): the host's LAN or Tailscale address/name (hosting no longer
               requires Tailscale, #59 follow-up), entered alongside "who documents here" so a
               joining device provides both in one prompt. -->
          <StackPanel IsVisible="{Binding CollectsHost}" Spacing="3">
            <TextBlock Text="GERÄT (NAME ODER IP-ADRESSE)" Classes="overline" FontSize="10" Margin="0,4,0,3" />
            <TextBox x:Name="HostBox" PlaceholderText="z. B. elw-1 oder 192.168.1.10" Text="{Binding Host}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <!-- The 4-digit PIN the hosting device shows; required to join (#64). -->
            <TextBlock Text="PIN" Classes="overline" FontSize="10" Margin="0,8,0,3" />
            <TextBox x:Name="PinBox" PlaceholderText="4-stellig" MaxLength="4" Text="{Binding Pin}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <!-- #182: a failed join stays on this dialog instead of closing it, reporting the
                 error here so Host/Name/Funkrufname aren't lost; only the PIN above is cleared. -->
            <Border x:Name="PromptErrorBanner" Background="#241608"
                    BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}" Padding="10,8" Margin="0,8,0,0"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="⚠" FontSize="14" VerticalAlignment="Top" Margin="0,0,10,0" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PromptErrorMessage" Text="{Binding ErrorMessage}"
                           FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource AmberBrush}" />
                <!-- TOFU cert-changed (#181): the only path to clearing the stale trust entry,
                     now reachable without leaving this dialog. -->
                <Button Grid.Row="1" Grid.Column="1" x:Name="PromptResetTrustButton" Classes="ghost"
                        Content="VERTRAUENSZUORDNUNG ZURÜCKSETZEN" Margin="0,8,0,0" Padding="8,3"
                        HorizontalAlignment="Left"
                        Command="{Binding ResetTrustCommand}"
                        IsVisible="{Binding CertificateChanged}" />
              </Grid>
            </Border>
          </StackPanel>
          <TextBlock Text="NAME" Classes="overline" FontSize="10" Margin="0,4,0,3" />
          <TextBox x:Name="OperatorNameBox"
                   PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorFullNamePlaceholder}"
                   Text="{Binding OperatorName}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock Text="FUNKRUFNAME" Classes="overline" FontSize="10" Margin="0,8,0,3" />
          <!-- Call sign is a suggestion list, not a closed set: an operator's Funkrufname need
               not be in the master list, so this is an AutoCompleteBox (Avalonia's ComboBox
               cannot be made editable) mirroring RolesView's personnel-name field. -->
          <AutoCompleteBox x:Name="CallSignBox"
                           PlaceholderText="{x:Static md:AnonymizedExampleData.OptionalCallSignPlaceholder}"
                           ItemsSource="{Binding CallSignOptions}"
                           FilterMode="ContainsOrdinal"
                           MinimumPrefixLength="0"
                           Text="{Binding OperatorCallSign}"
                           b:EnterSubmit.Command="{Binding ConfirmCommand}" />
          <!-- The Einsatznummer is unknown at the start of most incidents and not worth blocking on
               (#69), so the Stichwort (dispatch's short keyword, e.g. "B3P") is collected here
               instead. The Einsatznummer itself can be added later, from the workspace header. -->
          <StackPanel IsVisible="{Binding CollectsKeyword}" Spacing="3">
            <TextBlock Text="STICHWORT" Classes="overline" FontSize="10" Margin="0,8,0,3" />
            <TextBox x:Name="KeywordBox" PlaceholderText="optional, z. B. B3P" Text="{Binding Keyword}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </StackPanel>
          <!-- Join-in-progress status (#196): a stuck/slow connect attempt otherwise has no way out
               but to wait for the network layer's own timeout — the Cancel button below aborts it
               without leaving this dialog. -->
          <Border x:Name="ConnectingBanner" Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource IncomingBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="10,8" Margin="0,8,0,0"
                  IsVisible="{Binding IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="⏳" FontSize="14" VerticalAlignment="Center" />
              <TextBlock x:Name="ConnectingMessage" Text="Verbindung wird hergestellt…"
                         VerticalAlignment="Center" Classes="secondary" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" />
            <Button x:Name="ConfirmButton" Classes="signal" Content="BESTÄTIGEN" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
