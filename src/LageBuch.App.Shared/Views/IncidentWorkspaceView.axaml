<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             x:Class="LageBuch.App.Shared.Views.IncidentWorkspaceView"
             x:DataType="vm:IncidentWorkspaceViewModel">
  <Panel>
    <DockPanel>
      <!-- ===================== Status header ===================== -->
      <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
              Padding="24,10">
        <StackPanel Spacing="10">
          <!-- Incident identity. The Stichwort is what identifies THIS incident from the first minute
               (the Einsatznummer is usually unknown until ILS calls back, #69), so it is the hero —
               large tactical monospace — rather than the app's own name boxed off small to the side.
               The Einsatznummer becomes a secondary chip once known, with a quiet add-affordance while
               it isn't. Status shares the hero's line on the right as a bare dot + word, no chrome.
               The app name lives once, up in the command bar. Sharing (#52) is a compact icon button
               on that same status line rather than a labelled button on its own row — once active, the
               address/PIN it reveals sit immediately left of the status pill, so the whole identity
               block never grows past one line. -->
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock x:Name="EinsatznummerValue" Classes="metric" Text="{Binding HeroText}" />

              <!-- The three Einsatznummer-slot states are independent siblings (not nested inside a
                   shared collapsing wrapper): a data-bound text element stranded inside an
                   IsVisible-collapsed container measures to zero width the first time the container
                   un-collapses if its content changes in the same update (see the sharing row above
                   for the same fix applied to ShareStatus/SharePin). -->
              <Button x:Name="IncidentNumberChip" Classes="ghost"
                      IsVisible="{Binding ShowEinsatznummerChip}"
                      Command="{Binding BeginEditIncidentNumberCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="mono" Text="{Binding IncidentNumberInput}" />
                  <TextBlock Text="✎" />
                </StackPanel>
              </Button>

              <Button x:Name="AddIncidentNumberButton" Classes="ghost" Content="+ ILS-Nr. hinzufügen"
                      IsVisible="{Binding ShowAddEinsatznummerAffordance}"
                      Command="{Binding BeginEditIncidentNumberCommand}" />

              <StackPanel x:Name="IncidentNumberEditRow" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" IsVisible="{Binding ShowEinsatznummerEdit}">
                <TextBox x:Name="IncidentNumberEditBox" Width="220" PlaceholderText="z. B. B 1.2 260715 123"
                         Text="{Binding IncidentNumberEditInput}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ConfirmIncidentNumberCommand}" />
                    <KeyBinding Gesture="Escape" Command="{Binding CancelEditIncidentNumberCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button x:Name="ConfirmIncidentNumberButton" Classes="ghost" Content="✓"
                        Command="{Binding ConfirmIncidentNumberCommand}" />
                <Button x:Name="CancelIncidentNumberButton" Classes="ghost" Content="✕"
                        Command="{Binding CancelEditIncidentNumberCommand}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <!-- Multi-device sharing (#52): expose this open incident to other devices over the
                   network (loopback, LAN, or a tailnet) — a compact icon button on the status line
                   rather than a labelled button on its own row. -->
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                          IsVisible="{Binding CanHost}">
                <Button Classes="icon-btn" ToolTip.Tip="{Binding ShareButtonText}"
                        Command="{Binding ToggleSharingCommand}">
                  <Panel>
                    <PathIcon IsVisible="{Binding !IsSharing}"
                              Data="M18,16.08c-0.76,0-1.44,0.3-1.96,0.77L8.91,12.7c0.05-0.23,0.09-0.46,0.09-0.7s-0.04-0.47-0.09-0.7l7.05-4.11c0.54,0.5,1.25,0.81,2.04,0.81c1.66,0,3-1.34,3-3c0-1.66-1.34-3-3-3s-3,1.34-3,3c0,0.24,0.04,0.47,0.09,0.7L8.04,9.81C7.5,9.31,6.79,9,6,9c-1.66,0-3,1.34-3,3s1.34,3,3,3c0.79,0,1.5-0.31,2.04-0.81l7.12,4.16c-0.05,0.21-0.08,0.43-0.08,0.65c0,1.61,1.31,2.92,2.92,2.92s2.92-1.31,2.92-2.92C21,17.39,19.69,16.08,18,16.08z" />
                    <!-- Stop-sharing state: a plain "close" X. The earlier flat filled square had
                         no internal detail, so at 14px it read as an unrendered/missing icon rather
                         than an affordance (reported via screenshot) — the X's crossing strokes give
                         it a recognizable silhouette at the same size. -->
                    <PathIcon IsVisible="{Binding IsSharing}"
                              Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
                  </Panel>
                </Button>
                <TextBlock Classes="body" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding ShareStatus}"
                           IsVisible="{Binding ShareStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- The PIN a joining device must enter; read it out to whoever is connecting (#64).
                     The label and value gate their OWN IsVisible and hang off the always-visible
                     sharing group — they are NOT wrapped in a Border that collapses on SharePin. A
                     data-bound text element stranded inside an IsVisible-collapsed container is
                     measured to zero width the first time the container un-collapses (the text
                     arrives in the same notification) and caches it, so on the first share the number
                     showed blank until a later relayout. The ShareStatus line above renders on first
                     share for exactly this reason. -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="PIN" Classes="overline" FontSize="10" VerticalAlignment="Center"
                             Foreground="{StaticResource AmberBrush}"
                             IsVisible="{Binding SharePin, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock x:Name="PinValue" Text="{Binding SharePin}" VerticalAlignment="Center"
                             FontWeight="Medium" FontFamily="{StaticResource MonoFont}"
                             Foreground="{StaticResource AmberBrush}"
                             IsVisible="{Binding SharePin, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </StackPanel>

              <Border Width="1" Height="18" Background="{StaticResource HairlineBrush}"
                      VerticalAlignment="Center" IsVisible="{Binding CanHost}" />

              <StackPanel x:Name="StatusReadout" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource ActiveBrush}" />
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Medium" FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                           Text="{Binding StatusDisplay}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Joined-client disconnect banner (#52 §7): auto-reconnect is running; input is greyed
               out until it succeeds. "Zur Startseite" lets the user give up without waiting. -->
          <Border x:Name="DisconnectedBanner" Background="#241608"
                  BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="14,8"
                  IsVisible="{Binding !IsConnected}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="⚠" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"
                         Foreground="{StaticResource AmberBrush}" />
              <TextBlock Grid.Column="1" Text="Verbindung getrennt — verbinde neu…" FontWeight="SemiBold"
                         Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="2" x:Name="LeaveToHomeButton" Content="ZUR STARTSEITE"
                      Command="{Binding LeaveToHomeCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Read-only banner -->
          <Border x:Name="ReadOnlyBanner" Background="#241608"
                  BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="14,8"
                  IsVisible="{Binding IsReadOnly}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="🔒" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ReadOnlyReason}" FontWeight="SemiBold"
                         Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
              <Button x:Name="ContinueEditingButton" Content="WEITER BEARBEITEN"
                      Command="{Binding ContinueEditingCommand}"
                      IsVisible="{Binding CanContinueEditing}" />
            </StackPanel>
          </Border>

          <!-- ILS reminder bar -->
          <Border x:Name="ReminderBar" Background="#0B1A2A"
                  BorderBrush="{StaticResource IncomingBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="14,6"
                  IsVisible="{Binding HasReminder}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                        DataContext="{Binding Reminder}">
              <TextBlock Text="⏱" FontSize="15" VerticalAlignment="Center"
                         Foreground="{StaticResource IncomingBrush}" />
              <TextBlock Text="RÜCKMELDUNG AN ILS" Classes="overline" FontSize="10"
                         Foreground="{StaticResource IncomingBrush}" VerticalAlignment="Center" />

              <!-- Running, not due: the countdown is the hero of the bar — large tactical monospace
                   (stable digit width as it ticks every second) behind a quiet "NOCH" kicker and a
                   hairline. The reminder is autonomous, so there is no start/stop control. -->
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                          IsVisible="{Binding !IsDue}">
                <Border Width="1" Height="22" Background="{StaticResource HairlineBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Text="NOCH" Classes="overline" FontSize="9"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ReminderCountdownText" Classes="mono" FontSize="21" FontWeight="Medium"
                           Foreground="{StaticResource IncomingBrush}"
                           Text="{Binding RemainingDisplay}"
                           VerticalAlignment="Center" />
              </StackPanel>

              <!-- Due: alert + acknowledge -->
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                          IsVisible="{Binding IsDue}">
                <Border Background="{StaticResource SignalGradientBrush}" CornerRadius="{StaticResource RadiusSm}"
                        Padding="10,4" BoxShadow="0 0 16 -2 #99FF3D2E">
                  <TextBlock Text="FÄLLIG!" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                             LetterSpacing="1.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="ReminderAckButton" Classes="signal" Content="ERLEDIGT" Command="{Binding AcknowledgeCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Atemschutz pressure-control reminder (soonest-due Trupp across all tabs) -->
          <Border x:Name="ScbaControlBar" Background="#241608"
                  BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="14,6"
                  IsVisible="{Binding Scba.HasControlReminder}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                        DataContext="{Binding Scba}">
              <TextBlock Text="⏱" FontSize="15" VerticalAlignment="Center"
                         Foreground="{StaticResource AmberBrush}" />
              <TextBlock Text="ATEMSCHUTZ" Classes="overline" FontSize="10"
                         Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="ScbaControlText" Text="{Binding NextControlDisplay}" FontWeight="SemiBold"
                         Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
              <Border Background="{StaticResource SignalGradientBrush}" CornerRadius="{StaticResource RadiusSm}"
                      Padding="10,4" BoxShadow="0 0 16 -2 #99FF3D2E"
                      IsVisible="{Binding IsAnyControlDue}">
                <TextBlock Text="DRUCKABFRAGE!" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                           LetterSpacing="1.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Atemschutz Rückzugsalarm: unmissable red banner + audible alarm (life-safety) -->
          <Border x:Name="ScbaAlarmBar" Background="{StaticResource SignalGradientBrush}"
                  BorderBrush="{StaticResource SignalHotBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}" Padding="16,10"
                  BoxShadow="0 0 22 -2 #CCFF3D2E"
                  IsVisible="{Binding Scba.IsAnyAlarm}">
            <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding Scba}">
              <TextBlock Grid.Column="0" Text="🚨" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" Text="{Binding AlarmDisplay}"
                         FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                         LetterSpacing="1" Foreground="#FFFFFF" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="ALARM QUITTIEREN" Command="{Binding AcknowledgeAlarmCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- ===================== Action footer ===================== -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBarBrush}"
              BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
              Padding="24,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" IsEnabled="{Binding IsInputEnabled}">
            <Button x:Name="CloseButton" Content="EINSATZ ABSCHLIESSEN" Command="{Binding CloseIncidentCommand}" />
            <!-- PDF export renders from the local file, so it's host-only (hidden on a joined client). -->
            <Button x:Name="ExportButton" Classes="signal" Content="PDF EXPORTIEREN" Command="{Binding ExportPdfCommand}"
                    IsVisible="{Binding CanExport}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource ActiveBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="mono" FontSize="12" VerticalAlignment="Center"
                       Text="{Binding LastSavedAt, StringFormat='gespeichert {0:HH:mm:ss}'}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===================== Module tabs ===================== -->
      <!-- 24px left gutter so the nav rail shares the same left edge as the header bars
           and footer actions. The content area keeps its own inner padding, preserving
           the gap between rail and content. -->
      <!-- Greyed out while a joined client is reconnecting — it can't send commands until the link is back. -->
      <Border Background="{StaticResource AppBackgroundBrush}" Padding="24,0,0,0" IsEnabled="{Binding IsInputEnabled}">
        <TabControl x:Name="ModuleTabs">
          <TabControl.Background>
            <SolidColorBrush Color="Transparent" />
          </TabControl.Background>
          <TabItem>
            <TabItem.Header>
              <StackPanel x:DataType="vm:ChecklistViewModel" DataContext="{Binding ChecklistAufbau}"
                          Orientation="Horizontal" Spacing="7">
                <TextBlock Text="AUFBAU" />
                <Ellipse x:Name="AufbauCompleteDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{StaticResource ActiveBrush}" IsVisible="{Binding AllMandatoryDone}" />
                <Ellipse x:Name="AufbauIncompleteDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{StaticResource SignalBrush}" IsVisible="{Binding !AllMandatoryDone}" />
              </StackPanel>
            </TabItem.Header>
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding ChecklistAufbau}" />
            </Border>
          </TabItem>
          <TabItem Header="ETB">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Etb}" />
            </Border>
          </TabItem>
          <TabItem Header="AUFGABEN">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Tasks}" />
            </Border>
          </TabItem>
          <TabItem Header="FUNKTIONEN">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Roles}" />
            </Border>
          </TabItem>
          <TabItem Header="KRÄFTE">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Forces}" />
            </Border>
          </TabItem>
          <TabItem Header="ATEMSCHUTZ">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Scba}" />
            </Border>
          </TabItem>
          <TabItem Header="CO-MESSUNG">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding CoMessprotokoll}" />
            </Border>
          </TabItem>
          <TabItem Header="DATEIEN">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Files}" />
            </Border>
          </TabItem>
          <TabItem Header="LINKS">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Links}" />
            </Border>
          </TabItem>
          <TabItem Header="WASSERFÖRDERUNG">
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding Wasserfoerderung}" />
            </Border>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel x:DataType="vm:ChecklistViewModel" DataContext="{Binding ChecklistAbbau}"
                          Orientation="Horizontal" Spacing="7">
                <TextBlock Text="ABBAU" />
                <Ellipse x:Name="AbbauCompleteDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{StaticResource ActiveBrush}" IsVisible="{Binding AllMandatoryDone}" />
                <Ellipse x:Name="AbbauIncompleteDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{StaticResource SignalBrush}" IsVisible="{Binding !AllMandatoryDone}" />
              </StackPanel>
            </TabItem.Header>
            <Border Background="{StaticResource SurfaceBrush}" Padding="24" Margin="0">
              <ContentControl Content="{Binding ChecklistAbbau}" />
            </Border>
          </TabItem>
        </TabControl>
      </Border>
    </DockPanel>

    <!-- Continue-editing operator prompt overlay -->
    <ContentControl Content="{Binding PendingPrompt}"
                    IsVisible="{Binding PendingPrompt, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Confirmation overlay (e.g. closing the incident) -->
    <ContentControl Content="{Binding PendingConfirm}"
                    IsVisible="{Binding PendingConfirm, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Create-task overlay (from ETB rows, #88) -->
    <ContentControl Content="{Binding PendingTaskDialog}"
                    IsVisible="{Binding PendingTaskDialog, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Panel>
</UserControl>
