<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Feuerwehr.AppLogic.ViewModels;assembly=Feuerwehr.AppLogic"
             x:Class="Feuerwehr.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <StackPanel Margin="40" Spacing="16" MaxWidth="600">
    <TextBlock Text="Zuletzt verwendet" FontSize="20" FontWeight="SemiBold" />
    <ListBox x:Name="RecentList" ItemsSource="{Binding RecentFiles}" Height="400" />
  </StackPanel>
</UserControl>
