<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             x:Class="LageBuch.App.Shared.Views.IncidentDataDialogView"
             x:DataType="vm:IncidentDataDialogViewModel">
  <!-- MaxWidth, not Width, and Stretch rather than Center: a hard Width clips on a phone
       instead of shrinking — the card wanted its Width plus 80px of scrim against a 412dp
       screen. Avalonia centres a Stretch element that MaxWidth has made narrower than its
       slot, so a wide window looks exactly as it did. The scrim inset drops 40 -> 16 for the
       same reason; on a desktop the card never comes near either. -->
  <Border Background="#B3070A10" Padding="16"
          b:Overlay.CancelCommand="{Binding CancelCommand}" b:Overlay.PrimaryCommand="{Binding SaveCommand}"
          b:Overlay.InitialFocus="{Binding #IncidentDataKeywordBox}">
    <Border x:Name="IncidentDataDialogCard" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Stretch"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource OverlayShadow}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource SignalGradientBrush}"
                CornerRadius="12,12,0,0" />
        <StackPanel Margin="26,22,26,24" Spacing="12">
          <TextBlock Text="EINSATZDATEN" Classes="display" FontSize="20" />
          <!-- Everything here is optional and typically arrives piecemeal: the Stichwort from the
               alarm, the Einsatznummer once ILS calls back (#69), the address as it firms up. The
               fields are buffered until SPEICHERN so a half-typed number never lands in the file. -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <!-- #704: the Stammdaten's Stichwörter as suggestions, not a closed set: an alarm text
                 the list lacks stays enterable, so this is an AutoCompleteBox, as in the ETB. -->
            <HeaderedContentControl Grid.Column="0" Classes="field suggest" Header="STICHWORT">
              <AutoCompleteBox x:Name="IncidentDataKeywordBox" PlaceholderText="z. B. B3P"
                               ItemsSource="{Binding KeywordOptions}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                               Text="{Binding Keyword}" />
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Classes="field" Header="EINSATZNUMMER">
              <TextBox x:Name="IncidentDataNumberBox" Classes="mono" Text="{Binding IncidentNumber}"
                       PlaceholderText="z. B. B 1.2 260715 123" GotFocus="OnNumberBoxGotFocus" />
            </HeaderedContentControl>
          </Grid>
          <!-- #462: a number of another shape is pointed out, never refused. -->
          <TextBlock x:Name="IncidentNumberFormatHint" Classes="secondary" TextWrapping="Wrap" Margin="0,-6,0,0"
                     Text="{Binding IncidentNumberFormatHint}" IsVisible="{Binding ShowIncidentNumberFormatHint}" />
          <!-- #401: every address part is optional. Inside the home Gemeinde STRASSE, HAUSNR. and
               ORTSTEIL are enough; PLZ and ORT are for überörtliche Hilfe.
               #461: STRASSE and ORTSTEIL suggest the Stammdaten's Straßen and Ortsteile, like
               STICHWORT; a picked street fills in ORTSTEIL, PLZ and ORT where they are empty. -->
          <Grid ColumnDefinitions="3*,*" ColumnSpacing="12">
            <HeaderedContentControl Grid.Column="0" Classes="field suggest" Header="STRASSE">
              <AutoCompleteBox x:Name="IncidentDataStreetBox" PlaceholderText="z. B. Hauptstr."
                               ItemsSource="{Binding StreetOptions}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                               Text="{Binding Street}" />
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Classes="field" Header="HAUSNR.">
              <TextBox x:Name="IncidentDataHouseNumberBox" Text="{Binding HouseNumber}" PlaceholderText="12" />
            </HeaderedContentControl>
          </Grid>
          <Grid ColumnDefinitions="2*,3*,3*" ColumnSpacing="12">
            <HeaderedContentControl Grid.Column="0" Classes="field" Header="PLZ">
              <TextBox x:Name="IncidentDataPostalCodeBox" Text="{Binding PostalCode}" PlaceholderText="82256" />
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Classes="field" Header="ORT">
              <TextBox x:Name="IncidentDataPlaceBox" Text="{Binding Place}" PlaceholderText="z. B. Fürstenfeldbruck" />
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="2" Classes="field suggest" Header="ORTSTEIL">
              <AutoCompleteBox x:Name="IncidentDataDistrictBox" PlaceholderText="z. B. Puch"
                               ItemsSource="{Binding DistrictOptions}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                               Text="{Binding District}" />
            </HeaderedContentControl>
          </Grid>
          <!-- Left, primary first (#694): the actions start under the fields they save. -->
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" Margin="0,8,0,0"
                      IsVisible="{Binding !IsDiscardConfirmOpen}">
            <Button x:Name="IncidentDataSaveButton" Classes="signal" Content="SPEICHERN"
                    Command="{Binding SaveCommand}" />
            <Button x:Name="IncidentDataCancelButton" Content="ABBRECHEN" Command="{Binding CancelCommand}" />
          </StackPanel>
          <!-- #652: ABBRECHEN or Esc after typing asks first, in place of the buttons. ABBRECHEN means
               leave here too: it discards and closes, and so does a second Esc, so there is always a
               way out; ZURÜCK goes back to the form. A destructive confirm (#545): focus on ZURÜCK, so
               a reflex Enter keeps what was typed, and no primary command. -->

          <Border x:Name="IncidentDataDiscardPanel" Margin="0,8,0,0"
                  IsVisible="{Binding IsDiscardConfirmOpen}"
                  b:Overlay.IsInline="True"
                  b:Overlay.CancelCommand="{Binding ConfirmDiscardCommand}"
                  b:Overlay.InitialFocus="{Binding #IncidentDataKeepEditingButton}"
                  BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="ÄNDERUNGEN VERWERFEN?" Classes="overline" />
              <TextBlock Text="Die Eingaben sind noch nicht gespeichert." TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <Button x:Name="IncidentDataDiscardButton" Classes="signal" Content="ABBRECHEN"
                        Command="{Binding ConfirmDiscardCommand}" />
                <Button x:Name="IncidentDataKeepEditingButton" Content="ZURÜCK"
                        Command="{Binding CancelDiscardCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
