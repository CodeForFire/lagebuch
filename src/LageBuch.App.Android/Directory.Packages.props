<Project>
  <!-- Android-only package versions: Avalonia.Android itself is never referenced by the
       desktop projects, so it's pinned here rather than in the root file. Everything else
       (Avalonia, Avalonia.Fonts.Inter, ...) now matches root's 12.1.1 with no override needed.
       Nearest-wins rules apply, so import the root definitions first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />

  <ItemGroup>
    <PackageVersion Include="Avalonia.Android" Version="12.1.1" />
    <!-- Floors required by Avalonia.Android 12.1.1's own transitive dependency on
         Xamarin.AndroidX.AppCompat 1.7.1.3, which needs Core >= 1.17.0.2 and
         Activity >= 1.12.4.1 (checked against the AppCompat 1.7.1.3 nuspec). -->
    <PackageVersion Include="Xamarin.AndroidX.Activity" Version="1.12.4.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
  </ItemGroup>
</Project>
