<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Without OutputType=Exe a net8.0-android project builds as a library (.aar); the app head
         must be Exe so publish packages a launchable .apk. -->
    <OutputType>Exe</OutputType>
    <ApplicationId>de.codeforfire.lagebuch</ApplicationId>
    <!-- Placeholders for local builds only. The tag is the source of truth: release.yml passes
         -p:ApplicationVersion (versionCode), -p:ApplicationDisplayVersion (versionName) and
         -p:Version (assembly version, shown on the About screen). Never bump these by hand. -->
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.0.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <!-- .NET 9+ defaults to android-arm64;android-x64 only. Many Android tablets (the Galaxy Tab A
         line among them) run a 32-bit armeabi-v7a userland, and Play lists the app as incompatible
         for them. Play splits the .aab per ABI, so arm64 devices download no extra bytes; only the
         universal sideload .apk grows. release.yml fails if one of these ABIs goes missing. -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <!-- Dependabot restores this head on an SDK without the Android workload. There the SDK's own
         CoreCLR runtime-pack list applies, which knows android-arm64 and android-x64 but not
         android-arm, so the RID graph falls back to Microsoft.NETCore.App.Runtime.linux-bionic-arm
         — a package that was never published. The restore fails with NU1101 and every Dependabot
         NuGet job with it. It only reads package references, so drop the 32-bit RID there.
         DEPENDABOT_HOME is set by Dependabot's updater image and survives into its dotnet calls,
         which strip only MSBuild* variables. A real build has the workload and keeps all three. -->
    <RuntimeIdentifiers Condition="'$(DEPENDABOT_HOME)' != ''">android-arm64;android-x64</RuntimeIdentifiers>
    <!-- No packages.lock.json for this head (see Directory.Build.props). The Android SDK injects
         Microsoft.NET.ILLink.Tasks at the version of whichever SDK runs the restore, so a lock
         file here would fail CI's locked restore on every SDK patch release, and Dependabot
         cannot regenerate it. Its explicit packages are still pinned in Directory.Packages.props. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- Both formats out of one build. Google Play has not accepted an APK for a new app since
         2021, so the upload is the .aab; the GitHub release keeps its .apk. The SDK builds the
         bundle, then runs bundletool `build-apks` in universal mode over that same signed bundle
         and extracts the .apk from it (_CreateUniversalApkFromBundle) — so the sideload APK is a
         render of the exact bytes Play receives, not a separately built artefact. Note the
         SINGULAR AndroidPackageFormat wins over this when set, which is what used to suppress
         the bundle entirely. -->
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia.Android's generated Resource designer code isn't documented and would otherwise
         trip CS1591 under this repo's TreatWarningsAsErrors + GenerateDocumentationFile default. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Upload key for Google Play, opt-in. Without -p:AndroidSigningKeyStore the SDK falls back to
       its debug key, which is what a contributor's `make apk` and every Debug build want. The
       passwords are read from a file rather than passed literally: an -p:...Pass=<secret> on the
       command line lands in the binlog and in `ps`, and the env: prefix is documented as
       unsupported when the package format is aab. See docs/releasing.md, "Google Play". -->
  <PropertyGroup Condition="'$(AndroidSigningKeyStore)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' == ''">lagebuch-upload</AndroidSigningKeyAlias>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.AndroidX.Activity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LageBuch.App.Shared\LageBuch.App.Shared.csproj" />
    <ProjectReference Include="..\LageBuch.AppLogic\LageBuch.AppLogic.csproj" />
  </ItemGroup>

</Project>
