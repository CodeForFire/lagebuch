<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             x:Class="LageBuch.App.Shared.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <!-- 56px of gutter each side is 27% of a 412dp phone. The column and its MaxWidth already
       degrade correctly, so the gutter is the only thing this view gets wrong on a phone.
       Keyed off the shell's container, declared on MainView's root Panel. -->
  <UserControl.Styles>
    <Style Selector="StackPanel#ContentColumn">
      <Setter Property="Margin" Value="56,48" />
    </Style>
    <!-- A recent row's ÖFFNEN and remove buttons. Placed by style, not by attribute, so the phone
         query below can move them: a local value would win over its setters. -->
    <Style Selector="StackPanel.recentActions">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <ContainerQuery Name="Shell" Query="max-width:640">
      <Style Selector="StackPanel#ContentColumn">
        <Setter Property="Margin" Value="16,24" />
      </Style>
      <!-- #481: ÖFFNEN plus the remove button left the file name a few letters wide on a phone,
           so there the pair moves under the name, right-aligned, and the name gets the full row. -->
      <Style Selector="StackPanel.recentActions">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,8,0,0" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <Grid>
    <!-- Faint hazard glow in the corner for atmosphere. Radial, anchored on the corner it
         decorates, and fading to a zero-alpha stop of its own hue. The linear version fading to
         `Transparent` rendered as a visible 320x320 grey rectangle: `Transparent` is transparent
         WHITE, so the unpremultiplied interpolation drifted through grey, the last stop at offset
         0.7 cut the box mid-fade into hard left and bottom edges, and StartPoint="0%,0%" put the
         bright end at the box's top-LEFT, pointing into the page instead of at the corner.
         SignalFadedColor is SignalColor at zero alpha; fading to a different hue is what
         produced the grey. -->
    <Border x:Name="HazardGlow" HorizontalAlignment="Right" VerticalAlignment="Top"
            Width="320" Height="320" Opacity="0.05" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="100%">
          <GradientStop Color="{StaticResource SignalColor}" Offset="0" />
          <GradientStop Color="{StaticResource SignalFadedColor}" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <ScrollViewer>
      <!-- Stretch, not Center: Center sizes this column to its widest child, and the widest child
           is a virtualized ListBox whose desired width changes as rows are realized and recycled
           (a long path in the recent list wanted the full 720, a short one only ~643), so the
           whole page jumped sideways on every scroll. Stretch pins it to min(viewport, 720);
           Avalonia still centres a Stretch element that MaxWidth has made narrower than its slot. -->
      <StackPanel x:Name="ContentColumn" Spacing="28" MaxWidth="720"
                  HorizontalAlignment="Stretch">
        <!-- Greeting -->
        <StackPanel Spacing="6">
          <TextBlock Text="EINSATZBEREIT" Classes="overline" Foreground="{StaticResource ActiveBrush}" />
          <TextBlock Text="Lagebuch" Classes="display" FontSize="38" />
          <TextBlock Classes="secondary" FontSize="15" TextWrapping="Wrap"
                     Text="Dokumentation für den Einsatz. Lege einen neuen Einsatz an oder öffne ein bestehendes Lagebuch." />
        </StackPanel>

        <!-- Open-failure banner: matches the read-only banner in the workspace -->
        <Border x:Name="OpenErrorBanner" Background="#241608"
                BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}" Padding="14,10"
                IsVisible="{Binding OpenError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <!-- Grid, not a horizontal StackPanel: the latter measures children at infinite width,
               so the message would never wrap and the banner would outgrow the column. -->
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <PathIcon Grid.Row="0" Grid.Column="0" Width="15" Height="15" VerticalAlignment="Top" Margin="0,0,12,0"
                      Foreground="{StaticResource AmberBrush}"
                      Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OpenErrorMessage" Text="{Binding OpenError}"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource AmberBrush}" />
            <!-- #481: a moved or broken file is exactly the entry the user wants off the list. Only
                 offered for a listed entry; a file picked through the dialog was never on it. -->
            <Button Grid.Row="1" Grid.Column="1" x:Name="RemoveFailedRecentButton" Classes="ghost"
                    Content="AUS DER LISTE ENTFERNEN" Margin="0,10,0,0" Padding="10,4"
                    HorizontalAlignment="Left"
                    Command="{Binding RemoveRecentCommand}"
                    CommandParameter="{Binding FailedRecentPath}"
                    IsVisible="{Binding FailedRecentPath, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Border>

        <!-- Join-failure banner: version mismatch, or a host that isn't reachable / isn't sharing -->
        <Border x:Name="JoinErrorBanner" Background="#241608"
                BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}" Padding="14,10"
                IsVisible="{Binding JoinError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <PathIcon Grid.Row="0" Grid.Column="0" Width="15" Height="15" VerticalAlignment="Top" Margin="0,0,12,0"
                      Foreground="{StaticResource AmberBrush}"
                      Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="JoinErrorMessage" Text="{Binding JoinError}"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource AmberBrush}" />
            <!-- #181: a "geändert" (TOFU cert-changed) banner otherwise leaves no way to act on its
                 own instructions; this is the only path to clearing the stale trust entry. -->
            <Button Grid.Row="1" Grid.Column="1" x:Name="ResetTrustedCertificateButton" Classes="ghost"
                    Content="VERTRAUENSZUORDNUNG ZURÜCKSETZEN" Margin="0,10,0,0" Padding="10,4"
                    HorizontalAlignment="Left"
                    Command="{Binding ResetTrustedCertificateCommand}"
                    IsVisible="{Binding CanResetTrustedCertificate}" />
          </Grid>
        </Border>

        <!-- Last connection (#464): where this device was last joined to, one tap from rejoining.
             The PIN is not remembered: the host makes a new one every time it starts sharing. -->
        <Border x:Name="LastConnectionCard" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}" Padding="22,20"
                BoxShadow="{StaticResource PanelShadow}"
                IsVisible="{Binding HasLastConnection}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="ZULETZT VERBUNDEN" Classes="overline" VerticalAlignment="Center" />
              <Border Grid.Column="1" Height="1" Background="{StaticResource HairlineBrush}"
                      VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>
            <!-- LeadTrailPanel, as in the incident header: the buttons share the text's line while
                 both fit and move onto their own line, right-aligned, on a phone. A *,Auto Grid
                 squeezed the text into a sliver there and broke the time mid-number. -->
            <ctrl:LeadTrailPanel x:Name="LastConnectionLine" ItemSpacing="16" LineSpacing="12">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="LastConnectionHost" Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LastConnectionHost}"
                           Text="{Binding LastConnectionHost}"
                           IsVisible="{Binding HasLastConnection}" />
                <TextBlock x:Name="LastConnectionDetail" Classes="secondary" TextWrapping="Wrap"
                           Text="{Binding LastConnectionDetail}"
                           IsVisible="{Binding HasLastConnection}" />
                <TextBlock x:Name="LastConnectionError" TextWrapping="Wrap"
                           Foreground="{StaticResource AmberBrush}"
                           Text="{Binding LastConnectionError}"
                           IsVisible="{Binding LastConnectionError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="ReconnectButton" Content="NEU VERBINDEN" VerticalAlignment="Center"
                        Command="{Binding ReconnectCommand}" />
                <!-- The card keeps the PIN on this device; this takes it off again. -->
                <Button x:Name="ForgetLastConnectionButton" Classes="ghost" VerticalAlignment="Center"
                        ToolTip.Tip="Letzte Verbindung vergessen"
                        AutomationProperties.Name="Letzte Verbindung vergessen"
                        Command="{Binding ForgetLastConnectionCommand}">
                  <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                            Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                </Button>
              </StackPanel>
            </ctrl:LeadTrailPanel>
          </StackPanel>
        </Border>

        <!-- Recent incidents panel -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}" Padding="22,20"
                BoxShadow="{StaticResource PanelShadow}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="ZULETZT VERWENDET" Classes="overline" VerticalAlignment="Center" />
              <Border Grid.Column="1" Height="1" Background="{StaticResource HairlineBrush}"
                      VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>

            <!-- One scrollbar, on the page: a height-capped ListBox nested inside the page's
                 ScrollViewer swallowed the wheel until it bottomed out, so the list scrolled
                 several rows before the page moved at all. Disabled (not Auto) is what guarantees
                 it: the templated ScrollViewer then measures at infinite height and never
                 scrolls. JsonRecentFilesStore caps the list at 10 rows. -->
            <ListBox x:Name="RecentList" ItemsSource="{Binding RecentFiles}"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentFileItem">
                  <!-- Fixed lock gutter so filenames line up whether or not the incident is closed -->
                  <Grid ColumnDefinitions="22,*,Auto" RowDefinitions="Auto,Auto">
                    <PathIcon Grid.Column="0" Width="13" Height="13"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              IsVisible="{Binding IsClosed}"
                              ToolTip.Tip="Einsatz abgeschlossen"
                              Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" />
                      <TextBlock Classes="mono" FontSize="11" Opacity="0.7"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- ReflectionBinding: OpenRecentCommand and RemoveRecentCommand live on the
                         parent ListBox's DataContext (HomeViewModel), whose static type is object
                         under compiled bindings, so a compiled $parent cast path won't resolve (#262
                         UX: a visible open affordance alongside the existing double-click). -->
                    <StackPanel Classes="recentActions" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <Button Content="ÖFFNEN" VerticalAlignment="Center"
                              Command="{ReflectionBinding $parent[ItemsControl].DataContext.OpenRecentCommand}"
                              CommandParameter="{Binding Path}" />
                      <!-- #481: takes the entry off the list, never the file. A cross, not a bin:
                           nothing is deleted. -->
                      <Button x:Name="RemoveRecentButton" Classes="ghost" VerticalAlignment="Center"
                              ToolTip.Tip="Aus der Liste entfernen"
                              AutomationProperties.Name="Aus der Liste entfernen"
                              Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveRecentCommand}"
                              CommandParameter="{Binding Path}">
                        <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                  Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="RecentFilesError" TextWrapping="Wrap"
                       Foreground="{StaticResource AmberBrush}"
                       Text="{Binding RecentFilesError}"
                       IsVisible="{Binding RecentFilesError, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBlock Classes="secondary" FontSize="12"
                       IsVisible="{Binding !RecentFiles.Count}"
                       Text="Noch keine Einsätze. Beginne oben rechts mit „Neuer Einsatz“." />
            <StackPanel x:Name="RecentFilesHint" Orientation="Horizontal" Spacing="6" Opacity="0.7"
                        IsVisible="{Binding RecentFiles.Count}">
              <PathIcon Width="11" Height="11" VerticalAlignment="Center"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
              <TextBlock Classes="secondary mono" FontSize="11" Text="Doppelklick oder ÖFFNEN" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
