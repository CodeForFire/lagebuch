<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:c="clr-namespace:LageBuch.App.Shared.Controls"
             xmlns:map="clr-namespace:LageBuch.AppLogic.Services.Map;assembly=LageBuch.AppLogic"
             xmlns:conv="clr-namespace:LageBuch.App.Shared.Converters"
             x:Class="LageBuch.App.Shared.Views.LagekarteView"
             x:DataType="vm:LagekarteViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelPlacingCommand}" />
  </UserControl.KeyBindings>
  <!-- Keyed off the "narrow" class on IncidentWorkspaceView's root Panel (#685). The list sits
       beside the map on a desk and under it on a phone; both as Style setters, because a local
       DockPanel.Dock= or Width= would outrank them. -->
  <UserControl.Styles>
    <Style Selector="Border#UnitPanel">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Width" Value="300" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow Border#UnitPanel">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MaxHeight" Value="260" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <!-- The EBENEN list shares the panel with EINHEITEN. On a phone the panel is 260 px tall, so
         the list gives up all but about one Ebene and scrolls; EINHEITEN keeps room for its own. -->
    <Style Selector="ScrollViewer#OverlayScroll">
      <Setter Property="MaxHeight" Value="180" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow ScrollViewer#OverlayScroll">
      <Setter Property="MaxHeight" Value="64" />
    </Style>
    <!-- A unit's pin: the exact spot it stands on. Small to see past, with a finger-sized grip
         around it (the transparent Panel), so a tablet can still drag it. -->
    <Style Selector="Panel.unit-pin">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="Panel.unit-pin > Ellipse">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Fill" Value="Black" />
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|TacticalSignControl">
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <!-- The Einsatzstelle (#885): a pin whose head reads "ESt" and whose tip is the spot. A
         teardrop, so it is never taken for a taktisches Zeichen. The panel is twice the pin's
         height with the tip at its centre, because MapMarkerPanel centres a mark on its spot; the
         lower half has no background, so a tap there still reaches the map. The pin and its text
         keep their screen size at every zoom. -->
    <Style Selector="Panel.einsatzort-pin">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="96" />
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="Panel.einsatzort-pin > Path">
      <Setter Property="Fill" Value="{StaticResource SignalBrush}" />
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="2.5" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Panel.einsatzort-pin > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- The icon-btn look for the map's toggles; Button.icon-btn does not reach a ToggleButton. -->
    <Style Selector="ToggleButton.map-toggle">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ToggleButton.map-toggle PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Border#AddressSearch">
      <Setter Property="Width" Value="320" />
    </Style>
    <!-- Narrow enough to leave the zoom buttons free on a phone. -->
    <Style Selector="Panel#WorkspaceRoot.narrow Border#AddressSearch">
      <Setter Property="Width" Value="250" />
    </Style>
    <!-- On a phone the key wraps, leaving the attribution its corner. -->
    <Style Selector="Panel#WorkspaceRoot.narrow Border#WaterLegend">
      <Setter Property="MaxWidth" Value="180" />
    </Style>
    <!-- What floats over the map in the map's own colours: light by day, dark with NACHTKARTE. -->
    <Style Selector="Border#WaterLegend">
      <Setter Property="Background" Value="#E6FFFFFF" />
    </Style>
    <Style Selector="Grid#MapArea.night Border#WaterLegend">
      <Setter Property="Background" Value="#E61E2023" />
    </Style>
    <Style Selector="Border#Attribution">
      <Setter Property="Background" Value="#CCFFFFFF" />
    </Style>
    <Style Selector="Grid#MapArea.night Border#Attribution">
      <Setter Property="Background" Value="#CC1E2023" />
    </Style>
    <Style Selector="Border#Attribution TextBlock">
      <Setter Property="Foreground" Value="#FF333333" />
    </Style>
    <Style Selector="Grid#MapArea.night Border#Attribution TextBlock">
      <Setter Property="Foreground" Value="#FFB0B0B0" />
    </Style>
    <Style Selector="Border.map-banner">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- A DWD warning of level "Unwetter" or above: severe or extreme. -->
    <Style Selector="Border.weather-alert.severe">
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- As Style setters, not local values, so the narrow layout below can outrank them. -->
    <Style Selector="Border#WeatherCard">
      <Setter Property="MaxWidth" Value="340" />
    </Style>
    <Style Selector="ScrollViewer#WeatherAlertsScroll">
      <Setter Property="MaxHeight" Value="240" />
    </Style>
    <!-- On a phone the weather card leaves the legend its corner, and the warnings the map. -->
    <Style Selector="Panel#WorkspaceRoot.narrow Border#WeatherCard">
      <Setter Property="MaxWidth" Value="220" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow ScrollViewer#WeatherAlertsScroll">
      <Setter Property="MaxHeight" Value="140" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Einsatzort and units: what can be put on the map, and what already is. -->
    <Border x:Name="UnitPanel" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="EINSATZORT" Classes="overline" FontSize="10" Margin="0,0,0,6" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
          <Button Grid.Column="0" x:Name="PlaceEinsatzortButton" Classes="signal" HorizontalAlignment="Left"
                  Content="{Binding EinsatzortLabel}"
                  IsEnabled="{Binding CanEdit}" Command="{Binding PlaceEinsatzortCommand}" />
          <Button Grid.Column="1" Classes="icon-btn" ToolTip.Tip="Zum Einsatzort"
                  AutomationProperties.Name="Zum Einsatzort" IsVisible="{Binding HasEinsatzort}"
                  Command="{Binding CenterOnEinsatzortCommand}">
            <PathIcon Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm8.94 3A8.99 8.99 0 0 0 13 3.06V1h-2v2.06A8.99 8.99 0 0 0 3.06 11H1v2h2.06A8.99 8.99 0 0 0 11 20.94V23h2v-2.06A8.99 8.99 0 0 0 20.94 13H23v-2h-2.06zM12 19a7 7 0 1 1 0-14 7 7 0 0 1 0 14z" />
          </Button>
          <Button Grid.Column="2" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Einsatzort von der Karte nehmen"
                  AutomationProperties.Name="Einsatzort von der Karte nehmen"
                  IsVisible="{Binding HasEinsatzort}" IsEnabled="{Binding CanEdit}"
                  Command="{Binding RemoveEinsatzortCommand}">
            <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
          </Button>
        </Grid>

        <!-- Kartenebenen: imported GeoJSON, such as a DWD Ausbreitungsprognose. Which one is
             shown belongs to this screen; the Ebenen themselves are the Einsatz's. -->
        <StackPanel DockPanel.Dock="Top" x:Name="OverlayPanel" Margin="0,0,0,14" Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="EBENEN" Classes="overline" FontSize="10" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="ImportOverlayButton" Classes="ghost" Content="IMPORTIEREN"
                    ToolTip.Tip="GeoJSON oder ZIP als Kartenebene importieren"
                    IsVisible="{Binding Overlays.CanImport}"
                    IsEnabled="{Binding !Overlays.IsImporting}"
                    Command="{Binding Overlays.ImportCommand}" />
          </Grid>
          <TextBlock x:Name="NoOverlaysHint" TextWrapping="Wrap" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Keine Ebenen. GeoJSON importieren, z. B. eine Ausbreitungsprognose."
                     IsVisible="{Binding !Overlays.HasItems}" />
          <TextBlock x:Name="OverlayErrorText" Text="{Binding Overlays.Error}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{StaticResource ErrorBrush}"
                     IsVisible="{Binding Overlays.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ScrollViewer x:Name="OverlayScroll" IsVisible="{Binding Overlays.HasItems}">
            <ItemsControl x:Name="OverlayList" ItemsSource="{Binding Overlays.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapOverlayItem">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                    <CheckBox Grid.RowSpan="2" VerticalAlignment="Top" IsChecked="{Binding IsVisible}"
                              AutomationProperties.Name="{Binding VisibilityAutomationName}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Grid.RowSpan="2" Classes="icon-btn" Margin="4,0,0,0" VerticalAlignment="Top"
                            ToolTip.Tip="Auf der Karte zeigen" AutomationProperties.Name="{Binding ShowAutomationName}"
                            IsEnabled="{Binding Data, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding ShowCommand}">
                      <PathIcon Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm8.94 3A8.99 8.99 0 0 0 13 3.06V1h-2v2.06A8.99 8.99 0 0 0 3.06 11H1v2h2.06A8.99 8.99 0 0 0 11 20.94V23h2v-2.06A8.99 8.99 0 0 0 20.94 13H23v-2h-2.06zM12 19a7 7 0 1 1 0-14 7 7 0 0 1 0 14z" />
                    </Button>
                    <!-- ReflectionBinding: CanEdit lives on the view's DataContext, object-typed here. -->
                    <Button Grid.Column="3" Grid.RowSpan="2" Classes="icon-btn" Margin="4,0,0,0" VerticalAlignment="Top"
                            ToolTip.Tip="Ebene entfernen" AutomationProperties.Name="{Binding RemoveAutomationName}"
                            IsVisible="{ReflectionBinding $parent[UserControl].DataContext.CanEdit}"
                            Command="{Binding RemoveCommand}">
                      <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                    </Button>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding LoadError}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                               IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <!-- Zeitleiste: one step per forecast time, stepped by hand. -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Spacing="2"
                                IsVisible="{Binding ShowsTimeline}">
                      <TextBlock Text="{Binding FrameLabel}" FontWeight="SemiBold" FontSize="12" />
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Classes="icon-btn" ToolTip.Tip="Früherer Zeitpunkt"
                                AutomationProperties.Name="{Binding PreviousAutomationName}"
                                Command="{Binding PreviousFrameCommand}">
                          <PathIcon Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
                        </Button>
                        <Slider Grid.Column="1" Margin="6,0" Minimum="0" Maximum="{Binding MaxFrameIndex}"
                                TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                AutomationProperties.Name="{Binding TimelineAutomationName}"
                                Value="{Binding FramePosition}" />
                        <Button Grid.Column="2" Classes="icon-btn" ToolTip.Tip="Späterer Zeitpunkt"
                                AutomationProperties.Name="{Binding NextAutomationName}"
                                Command="{Binding NextFrameCommand}">
                          <PathIcon Data="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
                        </Button>
                      </Grid>
                    </StackPanel>
                    <ItemsControl Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0"
                                  ItemsSource="{Binding Legend}" IsVisible="{Binding ShowsLegend}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="map:OverlayLegendEntry">
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                            <Rectangle Width="12" Height="12" VerticalAlignment="Center"
                                       Fill="{Binding FillArgb, Converter={x:Static conv:ArgbBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="EINHEITEN" Classes="overline" FontSize="10" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" x:Name="NoUnitsHint" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Noch keine Einheiten. Unter KRÄFTE erfassen."
                   IsVisible="{Binding HasNoUnits}" />
        <ScrollViewer>
          <ItemsControl x:Name="UnitList" ItemsSource="{Binding Units}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LagekarteUnitRow">
                <!-- The name gets the whole width: a Funkrufname cut to "Florian Musterst…" names no one. -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
                  <TextBlock Grid.ColumnSpan="4" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Detail}" FontSize="12" VerticalAlignment="Center"
                             Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                  <!-- ReflectionBinding: the commands live on the ItemsControl's DataContext,
                       object-typed under compiled bindings. -->
                  <Button Grid.Row="1" Grid.Column="1" Classes="ghost" Content="{Binding PlaceLabel}" Margin="6,0,0,0"
                          IsEnabled="{ReflectionBinding $parent[ItemsControl].DataContext.CanEdit}"
                          Command="{ReflectionBinding $parent[ItemsControl].DataContext.PlaceUnitCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Row="1" Grid.Column="2" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Auf der Karte zeigen"
                          AutomationProperties.Name="Auf der Karte zeigen" IsVisible="{Binding IsPlaced}"
                          Command="{ReflectionBinding $parent[ItemsControl].DataContext.CenterOnUnitCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm8.94 3A8.99 8.99 0 0 0 13 3.06V1h-2v2.06A8.99 8.99 0 0 0 3.06 11H1v2h2.06A8.99 8.99 0 0 0 11 20.94V23h2v-2.06A8.99 8.99 0 0 0 20.94 13H23v-2h-2.06zM12 19a7 7 0 1 1 0-14 7 7 0 0 1 0 14z" />
                  </Button>
                  <Button Grid.Row="1" Grid.Column="3" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Von der Karte nehmen"
                          AutomationProperties.Name="Von der Karte nehmen" IsVisible="{Binding IsPlaced}"
                          IsEnabled="{ReflectionBinding $parent[ItemsControl].DataContext.CanEdit}"
                          Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveUnitCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- HÖHENPROFIL: under the map rather than over it, so the map's key and marks stay in view. -->
    <Border x:Name="ProfilePanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,6"
            Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" IsVisible="{Binding HasProfile}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold">
              <Run Text="HÖHENPROFIL  " />
              <Run Text="{Binding ProfileTitle}" />
            </TextBlock>
            <TextBlock x:Name="ProfileSummary" Text="{Binding ProfileSummary}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="icon-btn" VerticalAlignment="Top" ToolTip.Tip="Höhenprofil schließen"
                  AutomationProperties.Name="Höhenprofil schließen" Command="{Binding CloseProfileCommand}">
            <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
          </Button>
        </Grid>
        <c:ElevationProfileChart x:Name="ProfileChart" Height="130" Margin="0,6,0,0"
                                 AutomationProperties.Name="Höhenprofil"
                                 Profile="{Binding Profile}" Foreground="{StaticResource TextSecondaryBrush}" />
      </DockPanel>
    </Border>

    <!-- The map, its marks, and what floats over it. -->
    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <Grid x:Name="MapArea" Classes.night="{Binding IsNightMap}">
        <c:MapCanvasControl x:Name="Map"
                            AutomationProperties.Name="Lagekarte"
                            IsNight="{Binding IsNightMap}"
                            TileSource="{Binding Map.TileSource}"
                            WaterPoints="{Binding VisibleWaterPoints}"
                            Elevation="{Binding Terrain.Elevation}"
                            TerrainStyle="{Binding Terrain.Style}"
                            FlowPath="{Binding Terrain.FlowPoints}"
                            SelectedWaterPoint="{Binding SelectedWaterPoint}"
                            Overlays="{Binding MapShapes}"
                            Center="{Binding Map.Center}"
                            Zoom="{Binding Map.Zoom}"
                            Rotation="{Binding Map.Rotation}"
                            ViewChangedCommand="{Binding Map.ChangeViewCommand}"
                            TappedCommand="{Binding MapTappedCommand}" />

        <!-- WETTER: the wind at the Einsatzort, pointing downwind, beneath every sign and pin. -->
        <c:MapMarkerPanel x:Name="WindLayer" Center="{Binding Map.Center}" Zoom="{Binding Map.Zoom}"
                          Rotation="{Binding Map.Rotation}" IsHitTestVisible="False"
                          IsVisible="{Binding Weather.HasWind}">
          <c:WindArrow x:Name="WindArrow" c:MapMarkerPanel.Position="{Binding EinsatzortPosition}"
                       Angle="{Binding Weather.WindArrowAngle}" />
        </c:MapMarkerPanel>

        <!-- The taktische Zeichen, beneath the pins: each stands at its offset from its pin and draws
             its Verbindungsstrich back to it (DV 102 §1.5). A sign never dragged gets a free place
             from the panel, clear of the other signs and of every pin. Dragging one moves only the
             sign; the unit stays where its pin is. -->
        <ItemsControl x:Name="Signs" ItemsSource="{Binding Signs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate x:DataType="vm:LagekarteViewModel">
              <c:MapMarkerPanel Center="{Binding Map.Center}" Zoom="{Binding Map.Zoom}" Rotation="{Binding Map.Rotation}"
                                KeepClear="{Binding PinPositions}"
                                KeepClearEinsatzort="{Binding EinsatzortPosition}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.Styles>
            <Style Selector="ItemsControl#Signs > ContentPresenter" x:DataType="vm:LagekarteMarker">
              <Setter Property="c:MapMarkerPanel.Position" Value="{Binding Position}" />
              <Setter Property="c:MapMarkerPanel.LabelOffset" Value="{Binding LabelOffset}" />
              <Setter Property="c:MapMarkerPanel.Anchor" Value="{x:Static c:TacticalSignControl.SymbolCenter}" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LagekarteMarker">
              <c:TacticalSignControl AutomationProperties.Name="{Binding SignAutomationName}"
                                     VehicleType="{Binding VehicleType}" Title="{Binding Title}"
                                     Strength="{Binding Strength}" Status="{Binding Subtitle}"
                                     PointerPressed="OnSignPressed" PointerMoved="OnSignMoved"
                                     PointerReleased="OnSignReleased" PointerCaptureLost="OnSignCaptureLost" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="Marks" ItemsSource="{Binding Markers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate x:DataType="vm:LagekarteViewModel">
              <c:MapMarkerPanel Center="{Binding Map.Center}" Zoom="{Binding Map.Zoom}" Rotation="{Binding Map.Rotation}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.Styles>
            <Style Selector="ItemsControl#Marks > ContentPresenter" x:DataType="vm:LagekarteMarker">
              <Setter Property="c:MapMarkerPanel.Position" Value="{Binding Position}" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LagekarteMarker">
              <Panel AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="{Binding Title}"
                     PointerPressed="OnMarkerPressed" PointerMoved="OnMarkerMoved"
                     PointerReleased="OnMarkerReleased" PointerCaptureLost="OnMarkerCaptureLost">
                <Panel Classes="einsatzort-pin" IsVisible="{Binding IsEinsatzort}">
                  <Path x:Name="EinsatzortPin" Data="M20,48 L5.8,26.3 A17,17 0 1 1 34.2,26.3 Z" />
                  <TextBlock x:Name="EinsatzortText" Text="ESt" />
                </Panel>
                <Panel Classes="unit-pin" IsVisible="{Binding !IsEinsatzort}">
                  <Ellipse />
                </Panel>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
          <!-- Offline address search from the pack's address list; a hit marks the Einsatzort. -->
          <Border Classes="map-banner" x:Name="AddressSearch" IsVisible="{Binding CanSearchAddresses}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="AddressQueryBox" Text="{Binding AddressQuery}"
                         PlaceholderText="Adresse suchen, z. B. Hauptstr 12"
                         AutomationProperties.Name="Adresse suchen">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchAddressCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Adresse suchen"
                        AutomationProperties.Name="Adresse suchen starten" Command="{Binding SearchAddressCommand}">
                  <PathIcon Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                </Button>
              </Grid>
              <TextBlock x:Name="AddressStatusText" Text="{Binding AddressStatus}" TextWrapping="Wrap" FontSize="12"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         IsVisible="{Binding AddressStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding AddressHint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                         IsVisible="{Binding HasAddressHits}" />
              <ScrollViewer MaxHeight="240" IsVisible="{Binding HasAddressHits}">
                <ItemsControl x:Name="AddressHitList" ItemsSource="{Binding AddressHits}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LagekarteAddressRow">
                      <!-- ReflectionBinding: the command lives on the ItemsControl's DataContext,
                           object-typed under compiled bindings. -->
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              AutomationProperties.Name="{Binding AutomationName}"
                              Command="{ReflectionBinding $parent[ItemsControl].DataContext.ChooseAddressCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <!-- What the next tap places; the way out without placing anything. -->
          <Border Classes="map-banner" x:Name="PlacingBanner" IsVisible="{Binding IsPlacing}"
                  BorderBrush="{StaticResource SignalBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding PlacingHint}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
              <Button Classes="ghost" Content="IN KARTENMITTE" Command="{Binding PlaceAtCenterCommand}" />
              <Button Classes="ghost" Content="ABBRECHEN" Command="{Binding CancelPlacingCommand}" />
            </StackPanel>
          </Border>
          <Border Classes="map-banner" x:Name="NoMapBanner" IsVisible="{Binding HasNoMap}">
            <TextBlock TextWrapping="Wrap" MaxWidth="420"
                       Text="Kein Kartenpaket auf diesem Gerät. Unter Stammdaten → Karten herunterladen." />
          </Border>
          <!-- A tapped water point, with what OSM says about it. -->
          <Border Classes="map-banner" x:Name="WaterPointCard" Width="280" IsVisible="{Binding HasSelectedWaterPoint}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Text="{Binding SelectedWaterPoint.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon-btn" ToolTip.Tip="Schließen"
                        AutomationProperties.Name="Wasserentnahmestelle schließen"
                        Command="{Binding CloseWaterPointCommand}">
                  <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
              </Grid>
              <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="Aus OpenStreetMap, nicht vom Wasserversorger. Vor Ort prüfen." />
              <!-- HÖHENPROFIL: from this water point to the Einsatzort, for the Wasserförderung. -->
              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="2" IsVisible="{Binding OffersProfile}">
                <Button x:Name="ShowProfileButton" Classes="ghost" HorizontalAlignment="Stretch"
                        Content="HÖHENPROFIL ZUM EINSATZORT" Command="{Binding ShowProfileCommand}" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                           IsVisible="{Binding !HasEinsatzort}" Text="Erst den Einsatzort setzen." />
              </StackPanel>
              <ItemsControl x:Name="WaterPointDetails" ItemsSource="{Binding SelectedWaterPoint.Details}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="map:WaterPointDetail">
                    <Grid Margin="0,1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="WaterDetailLabel" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,10,0"
                                 Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
          <Border Classes="map-banner" x:Name="WaterPointsErrorBanner" BorderBrush="{StaticResource ErrorBrush}"
                  IsVisible="{Binding WaterPointsError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding WaterPointsError}" TextWrapping="Wrap" MaxWidth="420" />
          </Border>
          <Border Classes="map-banner" x:Name="TerrainErrorBanner" BorderBrush="{StaticResource ErrorBrush}"
                  IsVisible="{Binding Terrain.Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Terrain.Error}" TextWrapping="Wrap" MaxWidth="420" />
          </Border>
          <Border Classes="map-banner" x:Name="MapErrorBanner" BorderBrush="{StaticResource ErrorBrush}"
                  IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ActionError}" TextWrapping="Wrap" MaxWidth="420" />
          </Border>
          <Border Classes="map-banner" x:Name="WeatherLoadingBanner" IsVisible="{Binding Weather.IsLoading}">
            <TextBlock Text="Wetter wird geladen …" />
          </Border>
          <Border Classes="map-banner" x:Name="WeatherErrorBanner" BorderBrush="{StaticResource ErrorBrush}"
                  IsVisible="{Binding Weather.Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Weather.Error}" TextWrapping="Wrap" MaxWidth="420" />
          </Border>
          <!-- The DWD's warnings for the Einsatzort, a severe or extreme one in the signal colour.
               Scrolls once there are more than fit, so the last of them stays reachable. -->
          <ScrollViewer x:Name="WeatherAlertsScroll" IsVisible="{Binding Weather.HasAlerts}">
            <ItemsControl x:Name="WeatherAlerts" ItemsSource="{Binding Weather.Alerts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WeatherAlertRow">
                  <Border Classes="map-banner weather-alert" Classes.severe="{Binding IsSevere}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="420" FontWeight="SemiBold" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- On the app's dark surface, so the buttons stand out against a light map. -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Spacing="4"
                    Background="{StaticResource SurfaceRaisedBrush}">
          <Button Classes="icon-btn" ToolTip.Tip="Vergrößern" AutomationProperties.Name="Vergrößern"
                  Command="{Binding Map.ZoomInCommand}">
            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
          </Button>
          <Button Classes="icon-btn" ToolTip.Tip="Verkleinern" AutomationProperties.Name="Verkleinern"
                  Command="{Binding Map.ZoomOutCommand}">
            <PathIcon Data="M19 13H5v-2h14v2z" />
          </Button>
          <!-- Only on a turned map: the needle shows where north is, a press turns it back. -->
          <Button x:Name="FaceNorthButton" Classes="icon-btn" ToolTip.Tip="Norden nach oben"
                  AutomationProperties.Name="Norden nach oben"
                  IsVisible="{Binding Map.IsRotated}" Command="{Binding Map.FaceNorthCommand}">
            <c:CompassNeedle Angle="{Binding Map.Rotation}" />
          </Button>
          <ToggleButton x:Name="WaterPointsToggle" Classes="icon-btn map-toggle" ToolTip.Tip="Hydranten zeigen"
                        AutomationProperties.Name="Hydranten zeigen"
                        IsVisible="{Binding HasWaterPoints}" IsChecked="{Binding ShowWaterPoints}">
            <PathIcon Data="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
          </ToggleButton>
          <!-- GELÄNDE: one of the DGM5 layers over the map, or none. -->
          <Button x:Name="TerrainButton" Classes="icon-btn" ToolTip.Tip="Gelände"
                  AutomationProperties.Name="Gelände" IsVisible="{Binding Terrain.HasElevation}">
            <PathIcon Data="M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22L14 6z" />
            <Button.Flyout>
              <Flyout Placement="LeftEdgeAlignedTop">
                <StackPanel x:Name="TerrainChoices" Spacing="2" MinWidth="200">
                  <TextBlock Text="GELÄNDE" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <ItemsControl ItemsSource="{Binding Terrain.Choices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TerrainChoice">
                        <RadioButton GroupName="terrainLayer" Content="{Binding Label}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnTerrainPicked" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- Dark map colours for a dark ELW; kept on this device for the next Einsatz. -->
          <ToggleButton x:Name="NightMapToggle" Classes="icon-btn map-toggle" ToolTip.Tip="Nachtkarte"
                        AutomationProperties.Name="Nachtkarte"
                        IsChecked="{Binding IsNightMap}">
            <PathIcon Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" />
          </ToggleButton>
          <!-- WETTER: fetched only on this press, because it tells the weather service where the Einsatz is. -->
          <Button x:Name="WeatherButton" Classes="icon-btn" ToolTip.Tip="{Binding Weather.LoadTip}"
                  ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Wetter laden"
                  IsVisible="{Binding Weather.IsAvailable}" Command="{Binding Weather.LoadCommand}">
            <PathIcon Data="M4,10A1,1 0 0,1 3,9A1,1 0 0,1 4,8H12A2,2 0 0,0 14,6A2,2 0 0,0 12,4C11.45,4 10.95,4.22 10.59,4.59C10.2,5 9.56,5 9.17,4.59C8.78,4.2 8.78,3.56 9.17,3.17C9.9,2.45 10.9,2 12,2A4,4 0 0,1 16,6A4,4 0 0,1 12,10H4M19,12A1,1 0 0,0 20,11A1,1 0 0,0 19,10C18.72,10 18.47,10.11 18.29,10.29C17.9,10.68 17.27,10.68 16.88,10.29C16.5,9.9 16.5,9.27 16.88,8.88C17.42,8.34 18.17,8 19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14H5A1,1 0 0,1 4,13A1,1 0 0,1 5,12H19M18,18H4A1,1 0 0,1 3,17A1,1 0 0,1 4,16H18A3,3 0 0,1 21,19A3,3 0 0,1 18,22C17.17,22 16.42,21.66 15.88,21.12C15.5,20.73 15.5,20.1 15.88,19.71C16.27,19.32 16.9,19.32 17.29,19.71C17.47,19.89 17.72,20 18,20A1,1 0 0,0 19,19A1,1 0 0,0 18,18Z" />
          </Button>
        </StackPanel>

        <!-- What the water symbols and the POI dots mean, whenever they are on the map. Drawn like
             MapDrawing and VectorTileRenderer draw them. -->
        <Border x:Name="WaterLegend" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                CornerRadius="{StaticResource RadiusSm}" Padding="8,4"
                IsVisible="{Binding ShowsLegend}">
          <StackPanel Spacing="2">
            <StackPanel.Styles>
              <Style Selector="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#FF212121" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0,10,0" />
              </Style>
              <Style Selector="Grid#MapArea.night TextBlock">
                <Setter Property="Foreground" Value="#FFE4E4E4" />
              </Style>
              <Style Selector="Ellipse.poi">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Stroke" Value="White" />
                <Setter Property="StrokeThickness" Value="1" />
              </Style>
              <!-- MapStyle's POI inks, day and night. -->
              <Style Selector="Ellipse.fire">
                <Setter Property="Fill" Value="#FFE65100" />
              </Style>
              <Style Selector="Ellipse.help">
                <Setter Property="Fill" Value="#FF6A1B9A" />
              </Style>
              <Style Selector="Ellipse.people">
                <Setter Property="Fill" Value="#FFAD1457" />
              </Style>
              <Style Selector="Ellipse.office">
                <Setter Property="Fill" Value="#FF455A64" />
              </Style>
              <Style Selector="Ellipse.fuel">
                <Setter Property="Fill" Value="#FF795548" />
              </Style>
              <Style Selector="Grid#MapArea.night Ellipse.fire">
                <Setter Property="Fill" Value="#FFFF8A3D" />
              </Style>
              <Style Selector="Grid#MapArea.night Ellipse.help">
                <Setter Property="Fill" Value="#FFB585DD" />
              </Style>
              <Style Selector="Grid#MapArea.night Ellipse.people">
                <Setter Property="Fill" Value="#FFE8709F" />
              </Style>
              <Style Selector="Grid#MapArea.night Ellipse.office">
                <Setter Property="Fill" Value="#FF9AAEB8" />
              </Style>
              <Style Selector="Grid#MapArea.night Ellipse.fuel">
                <Setter Property="Fill" Value="#FFB8968A" />
              </Style>
              <!-- A marker's coloured field, with the glyph WaterPointMarkers draws into it: the
                   same on a day and a night map, as the markers are. -->
              <Style Selector="Border.water-field">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="Background" Value="{x:Static c:WaterPointMarkers.UnbekanntBrush}" />
              </Style>
              <Style Selector="Border.water-field > Path">
                <Setter Property="Stroke" Value="White" />
                <Setter Property="StrokeThickness" Value="1.4" />
                <Setter Property="StrokeLineCap" Value="Round" />
                <Setter Property="StrokeJoin" Value="Round" />
              </Style>
            </StackPanel.Styles>
            <!-- What the colour says: the flow class, in l/min. -->
            <WrapPanel x:Name="WaterFlowKey" IsVisible="{Binding ShowsWaterLegend}">
              <TextBlock Text="l/min" FontWeight="SemiBold" />
              <Border Classes="water-field" />
              <TextBlock Text="unbekannt" />
              <Border Classes="water-field" Background="{x:Static c:WaterPointMarkers.Unter400Brush}" />
              <TextBlock Text="&lt; 400" />
              <Border Classes="water-field" Background="{x:Static c:WaterPointMarkers.Bis799Brush}" />
              <TextBlock Text="400–799" />
              <Border Classes="water-field" Background="{x:Static c:WaterPointMarkers.Bis1599Brush}" />
              <TextBlock Text="800–1.599" />
              <Border Classes="water-field" Background="{x:Static c:WaterPointMarkers.Bis3199Brush}" />
              <TextBlock Text="1.600–3.199" />
              <Border Classes="water-field" Background="{x:Static c:WaterPointMarkers.Ab3200Brush}" />
              <TextBlock Text="ab 3.200" />
            </WrapPanel>
            <!-- What the glyph says: the kind of Entnahmestelle. -->
            <WrapPanel x:Name="WaterPointKey" IsVisible="{Binding ShowsWaterLegend}">
              <Border Classes="water-field"><Path Data="{x:Static c:WaterPointMarkers.UnterflurhydrantGlyph}" /></Border>
              <TextBlock Text="Unterflurhydrant" />
              <Border Classes="water-field"><Path Data="{x:Static c:WaterPointMarkers.UeberflurhydrantGlyph}" /></Border>
              <TextBlock Text="Überflurhydrant" />
              <Border Classes="water-field"><Path Data="{x:Static c:WaterPointMarkers.WandhydrantGlyph}" /></Border>
              <TextBlock Text="Wandhydrant" />
              <Border Classes="water-field"><Path Data="{x:Static c:WaterPointMarkers.SaugstelleGlyph}" /></Border>
              <TextBlock Text="Saugstelle" />
              <Border Classes="water-field"><Path Data="{x:Static c:WaterPointMarkers.LoeschwasserbrunnenGlyph}" /></Border>
              <TextBlock Text="Brunnen" />
              <Border Classes="water-field"><Path Data="{x:Static c:WaterPointMarkers.ZisterneGlyph}" /></Border>
              <TextBlock Text="Zisterne" />
              <Border Classes="water-field"><Path Data="{x:Static c:WaterPointMarkers.OffenesGewaesserGlyph}" /></Border>
              <TextBlock Text="Löschteich" />
            </WrapPanel>
            <!-- The terrain layer's key, coloured as TerrainShading paints it. -->
            <WrapPanel x:Name="TerrainKey" IsVisible="{Binding Terrain.ShowsLegend}">
              <StackPanel Orientation="Horizontal" IsVisible="{Binding Terrain.ShowsSlopeKey}">
                <Rectangle Width="14" Height="10" Fill="#8CFFD900" />
                <TextBlock Text="ab 10 %" />
                <Rectangle Width="14" Height="10" Fill="#8CFF8000" />
                <TextBlock Text="ab 20 %" />
                <Rectangle Width="14" Height="10" Fill="#8CD90000" />
                <TextBlock Text="ab 35 %" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" IsVisible="{Binding Terrain.ShowsRelativeKey}">
                <Rectangle Width="14" Height="10" Fill="#A62166AC" />
                <TextBlock Text="tiefer" />
                <Rectangle Width="14" Height="10" Fill="#A6B2182B" />
                <TextBlock Text="höher" />
              </StackPanel>
              <Border Width="22" Height="7" Margin="0,0,4,0" VerticalAlignment="Center" CornerRadius="3"
                      Background="#FF0D47A1" BorderBrush="White" BorderThickness="1.5"
                      IsVisible="{Binding Terrain.ShowsFlowKey}" />
              <Rectangle Width="60" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"
                         IsVisible="{Binding Terrain.ShowsRampKey}">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#FF2E7D32" />
                    <GradientStop Offset="0.25" Color="#FF9CCC65" />
                    <GradientStop Offset="0.5" Color="#FFFFF176" />
                    <GradientStop Offset="0.75" Color="#FFFFB74D" />
                    <GradientStop Offset="1" Color="#FF8D6E63" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <TextBlock x:Name="TerrainLegendText" Text="{Binding Terrain.LegendText}" />
            </WrapPanel>
            <WrapPanel x:Name="PoiKey" IsVisible="{Binding ShowsPoiLegend}">
              <Ellipse Classes="poi fire" />
              <TextBlock Text="Feuerwehr" />
              <Ellipse Classes="poi help" />
              <TextBlock Text="Krankenhaus · Polizei" />
              <Ellipse Classes="poi people" />
              <TextBlock Text="Schule · Kita · Pflegeheim" />
              <Ellipse Classes="poi office" />
              <TextBlock Text="Rathaus · Apotheke" />
              <Ellipse Classes="poi fuel" />
              <TextBlock Text="Tankstelle" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <!-- WETTER: what the nearest DWD station measured, and where and when. -->
          <Border Classes="map-banner" x:Name="WeatherCard" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  IsVisible="{Binding Weather.HasReading}">
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="WeatherWindText" Text="{Binding Weather.WindText}" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon-btn" Margin="4,0,0,0" ToolTip.Tip="Schließen"
                        AutomationProperties.Name="Wetter schließen" Command="{Binding Weather.CloseCommand}">
                  <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
              </Grid>
              <TextBlock Text="{Binding Weather.DetailText}" TextWrapping="Wrap" IsVisible="{Binding Weather.HasDetail}" />
              <TextBlock Text="{Binding Weather.SourceText}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                <Button x:Name="WeatherToEtbButton" Classes="ghost" Content="INS ETB" IsVisible="{Binding Weather.CanLog}"
                        Command="{Binding Weather.LogToEtbCommand}" />
                <Button Classes="ghost" Content="NEU LADEN" Command="{Binding Weather.LoadCommand}" />
              </StackPanel>
              <TextBlock Text="Im ETB vermerkt." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                         IsVisible="{Binding Weather.IsLogged}" />
              <TextBlock Text="Daten: Deutscher Wetterdienst, über Bright Sky" FontSize="10" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
          <!-- ODbL: every map drawn from OSM data names its source. -->
          <Border x:Name="Attribution" HorizontalAlignment="Right" Padding="4,1"
                  IsVisible="{Binding Map.Attribution, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel>
              <TextBlock Text="{Binding Map.Attribution}" FontSize="10" TextWrapping="Wrap" />
              <TextBlock x:Name="WaterPointsNote" Text="{Binding WaterPointsNote}" FontSize="10"
                         IsVisible="{Binding WaterPointsNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
