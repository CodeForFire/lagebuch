<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             x:Class="LageBuch.App.Shared.Views.TaskDialogView"
             x:DataType="vm:TaskDialogViewModel">
  <!-- MaxWidth, not Width, and Stretch rather than Center: a hard Width clips on a phone
       instead of shrinking — the card wanted its Width plus 80px of scrim against a 412dp
       screen. Avalonia centres a Stretch element that MaxWidth has made narrower than its
       slot, so a wide window looks exactly as it did. The scrim inset drops 40 -> 16 for the
       same reason; on a desktop the card never comes near either. -->
  <Border Background="#B3070A10" Padding="16"
          b:Overlay.CancelCommand="{Binding CancelCommand}" b:Overlay.PrimaryCommand="{Binding SaveCommand}"
          b:Overlay.InitialFocus="{Binding #TaskDialogText}">
    <Border x:Name="TaskDialogCard" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Stretch"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource OverlayShadow}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource SignalGradientBrush}"
                CornerRadius="12,12,0,0" />
        <StackPanel Margin="26,22,26,24" Spacing="12">
          <TextBlock Text="TASK ERSTELLEN" Classes="display" FontSize="20" />
          <HeaderedContentControl Classes="field required" Header="AUFGABE" ctrl:Field.Error="{Binding TextError}">
            <!-- Freitext: kein Platzhalter, siehe #137 -->
            <TextBox x:Name="TaskDialogText" Text="{Binding Text}" AcceptsReturn="False" />
          </HeaderedContentControl>
          <!-- Triage segments (#246) on a row of their own: a scale wants its width. -->
          <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12">
            <HeaderedContentControl Classes="field" Header="WICHTIGKEIT">
              <ListBox Classes="triage" ItemsSource="{Binding ImportanceOptions}"
                       SelectedValue="{Binding Importance}" SelectedValueBinding="{Binding Value}"
                       AutomationProperties.Name="Wichtigkeit"
                       ItemTemplate="{StaticResource ImportanceSegment}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="DRINGLICHKEIT">
              <ListBox Classes="triage" ItemsSource="{Binding UrgencyOptions}"
                       SelectedValue="{Binding Urgency}" SelectedValueBinding="{Binding Value}"
                       AutomationProperties.Name="Dringlichkeit"
                       ItemTemplate="{StaticResource UrgencySegment}" />
            </HeaderedContentControl>
          </WrapPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <HeaderedContentControl Grid.Column="0" Classes="field" Header="TIMER (MIN)"
                                    ctrl:Field.Error="{Binding TimerMinutesError}">
              <TextBox Width="60" Text="{Binding TimerMinutes}" b:IntegerOnly.IsEnabled="True"
                       PlaceholderText="{x:Static md:AnonymizedExampleData.TimerMinutesPlaceholder}" />
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Classes="field suggest" Header="ZUGETEILT AN">
              <AutoCompleteBox ItemsSource="{Binding AssigneeOptions}"
                               PlaceholderText="{x:Static md:AnonymizedExampleData.OperatorNamePlaceholder}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                               Text="{Binding Assignee}" />
            </HeaderedContentControl>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="TaskDialogCancelButton" Content="ABBRECHEN" Command="{Binding CancelCommand}" />
            <Button x:Name="TaskDialogSaveMoreButton" Classes="ghost"
                    Content="SPEICHERN &amp; WEITEREN TASK" Command="{Binding SaveAndCreateAnotherCommand}" />
            <Button x:Name="TaskDialogSaveButton" Classes="signal" Content="SPEICHERN"
                    Command="{Binding SaveCommand}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
