<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Feuerwehr.AppLogic.ViewModels;assembly=Feuerwehr.AppLogic"
             xmlns:b="clr-namespace:Feuerwehr.App.Shared.Behaviors"
             xmlns:etb="clr-namespace:Feuerwehr.Domain.Etb;assembly=Feuerwehr.Domain"
             x:Class="Feuerwehr.App.Shared.Views.EtbView"
             x:DataType="vm:EtbViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Grid.Column="0" Text="EINSATZTAGEBUCH" Classes="overline" VerticalAlignment="Center" />
      <CheckBox Grid.Column="1" x:Name="HideSystemCheckBox"
                Content="Systemmeldungen ausblenden"
                IsChecked="{Binding HideSystemEntries}" />
    </Grid>

    <!-- Input dock -->
    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="DirectionBox" Width="130"
                  ItemsSource="{Binding DirectionOptions}"
                  SelectedValue="{Binding NewDirection}"
                  SelectedValueBinding="{Binding Value}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EtbDirectionOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- Suggestion list, not a closed set: a sender/recipient outside Stammdaten (e.g. "ELW 1",
             a person's name) must stay enterable, so this is an AutoCompleteBox rather than a
             ComboBox, mirroring ForcesView's Brigade field. -->
        <AutoCompleteBox Width="110" Watermark="Von" ItemsSource="{Binding CallSignOptions}"
                         FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                         Text="{Binding NewFrom}" b:EnterSubmit.Command="{Binding AddEntryCommand}" />
        <AutoCompleteBox Width="110" Watermark="An" ItemsSource="{Binding CallSignOptions}"
                         FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                         Text="{Binding NewTo}" b:EnterSubmit.Command="{Binding AddEntryCommand}" />
        <TextBox x:Name="EtbTextBox" Width="320" Watermark="Eintrag" Text="{Binding NewText}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddEntryCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button x:Name="EtbAddButton" Classes="signal" Content="HINZUFÜGEN" Command="{Binding AddEntryCommand}" />
      </StackPanel>
    </Border>

    <!-- Edit panel: a small form below the grid, mirroring the input dock's visual language, shown
         only while a row is being edited (not inline DataGrid cell editing). -->
    <Border DockPanel.Dock="Bottom" x:Name="EditPanel" Margin="0,16,0,0"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14"
            IsVisible="{Binding IsEditing}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="EditTextBox" Width="420" Watermark="Eintrag" Text="{Binding EditText}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button x:Name="SaveEditButton" Classes="signal" Content="SPEICHERN" Command="{Binding SaveEditCommand}" />
        <Button x:Name="CancelEditButton" Content="ABBRECHEN" Command="{Binding CancelEditCommand}" />
      </StackPanel>
    </Border>

    <!-- History panel: read-only, available whenever the selected row has prior versions.
         Deliberately independent of IsReadOnly and of the edit panel above, so a closed incident's
         edit history is still reachable (a rewrite must stay auditable after the fact). -->
    <Border DockPanel.Dock="Bottom" x:Name="HistoryPanel" Margin="0,16,0,0"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14"
            IsVisible="{Binding HistoryEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Verlauf" Classes="overline" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="SCHLIESSEN" Command="{Binding CloseHistoryCommand}" />
        </Grid>
        <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryEntry.Edits}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="etb:EtbEntryEdit">
              <TextBlock Classes="mono" Foreground="{StaticResource TextMutedBrush}" Margin="0,2">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}: „{1}“ ({2})">
                    <Binding Path="EditedAt" />
                    <Binding Path="PreviousText" />
                    <Binding Path="EditedBy" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <DataGrid x:Name="EtbGrid" ItemsSource="{Binding Entries}" IsReadOnly="True" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ZEIT" Binding="{Binding Time}" />
          <DataGridTextColumn Header="RICHTUNG" Binding="{Binding Direction}" />
          <DataGridTextColumn Header="VON" Binding="{Binding From}" />
          <DataGridTextColumn Header="AN" Binding="{Binding To}" />
          <DataGridTemplateColumn Header="EINTRAG" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:EtbEntryRow">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,4">
                  <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                  <Border x:Name="EditedTag" Background="#241A08" BorderBrush="{StaticResource AmberBrush}"
                          BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="6,1"
                          IsVisible="{Binding WasEdited}">
                    <TextBlock Text="bearbeitet" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="ERFASST VON" Binding="{Binding EnteredBy}" />
          <DataGridTemplateColumn Header="">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:EtbEntryRow">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,4">
                  <Button Content="BEARBEITEN" Command="{Binding BeginEditCommand}"
                          IsVisible="{Binding IsEditable}" />
                  <!-- Not gated on IsEditable/IsReadOnly like BEARBEITEN: history must stay
                       readable even for a System entry's neighbours or a closed incident. -->
                  <Button Content="VERLAUF" Command="{Binding ShowHistoryCommand}"
                          IsVisible="{Binding WasEdited}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
