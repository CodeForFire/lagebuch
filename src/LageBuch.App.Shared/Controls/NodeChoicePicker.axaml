<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             x:Class="LageBuch.App.Shared.Controls.NodeChoicePicker"
             x:Name="Root"
             x:DataType="ctrl:NodeChoicePicker">
  <!-- The Abschnitt picker shared by the Kräfte list and the Führung board. A flyout of commands
       and not a ComboBox: a selection bound to a domain write re-enters through Changed mid-update
       (see SafetyTruppChoice). The entry in force is marked rather than styled, so it still reads
       at a glance on the ELW's dimmed screen. -->
  <Button x:Name="PickerButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
          Padding="8,4" FontSize="12"
          ToolTip.Tip="{Binding Label, ElementName=Root}" AutomationProperties.Name="Abschnitt wählen">
    <TextBlock Text="{Binding Label, ElementName=Root}" TextTrimming="CharacterEllipsis" />
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft">
        <ItemsControl ItemsSource="{Binding Choices, ElementName=Root}" MinWidth="190">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NodeChoice">
              <Button Classes="ghost" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left" Padding="8,5"
                      Command="{Binding SelectCommand}"
                      Click="OnChoiceClick">
                <Grid ColumnDefinitions="14,*" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="✓" FontWeight="Bold" IsVisible="{Binding IsCurrent}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
