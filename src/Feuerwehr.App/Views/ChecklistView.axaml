<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Feuerwehr.AppLogic.ViewModels;assembly=Feuerwehr.AppLogic"
             x:Class="Feuerwehr.App.Views.ChecklistView"
             x:DataType="vm:ChecklistViewModel">
  <ScrollViewer>
    <ItemsControl ItemsSource="{Binding Items}" IsEnabled="{Binding !IsReadOnly}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ChecklistItemViewModel">
          <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsDone}" />
            <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
