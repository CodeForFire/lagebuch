<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             xmlns:etb="clr-namespace:LageBuch.Domain.Etb;assembly=LageBuch.Domain"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:views="clr-namespace:LageBuch.App.Shared.Views"
             x:Class="LageBuch.App.Shared.Views.EtbView"
             x:DataType="vm:EtbViewModel">
  <!-- The narrow layout, keyed off the workspace's container (declared on IncidentWorkspaceView's
       root Panel — a query resolves its container by name anywhere below it, so a module view
       states its own phone rules without the shell knowing anything about them).

       Every field width lives in a Style here rather than as Width="…" on the control, because a
       local value in XAML outranks a Style setter and the query below could never widen it. The
       one dock serves both layouts: the query turns its row of fixed-width fields into a stack of
       full-width ones. -->
  <UserControl.Styles>
    <!-- Orientation as a Style, never Orientation="Horizontal" on the panel: a local value in
         XAML outranks a Style setter, so the narrow query below could not turn the dock upright
         and every field stayed on one squeezed line. A StackPanel rather than a WrapPanel because
         a vertical WrapPanel flows into columns; a vertical StackPanel gives one field per line
         and constrains each to the panel's width, which is what makes Width=NaN fill it. -->
    <Style Selector="StackPanel#DockFields">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="Border#SituationReportPanel">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Width" Value="440" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <!-- The Lagemeldung's Nr. on its ETB row: quiet, outlined, the same weight as a time. -->
    <Style Selector="ScrollViewer#FunkspruchScroll">
      <Setter Property="MaxHeight" Value="360" />
    </Style>
    <Style Selector="Border.lm-badge">
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.lm-badge > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="StackPanel#EditFields">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="AutoCompleteBox#FromBox">
      <Setter Property="Width" Value="150" />
    </Style>
    <Style Selector="AutoCompleteBox#ToBox">
      <Setter Property="Width" Value="150" />
    </Style>
    <Style Selector="TextBox#EtbTextBox">
      <Setter Property="Width" Value="320" />
    </Style>
    <Style Selector="TextBox#EditTextBox">
      <Setter Property="Width" Value="420" />
    </Style>

    <ContainerQuery Name="Workspace" Query="max-width:640">
      <Style Selector="StackPanel#DockFields">
        <Setter Property="Orientation" Value="Vertical" />
      </Style>
      <!-- A phone has no room beside the journal: the Lagemeldung takes the screen, the way the
           entry sheet does, and the journal comes back when it closes. -->
      <Style Selector="ScrollViewer#FunkspruchScroll">
        <Setter Property="MaxHeight" Value="200" />
      </Style>
      <Style Selector="Border#SituationReportPanel">
        <Setter Property="DockPanel.Dock" Value="Top" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Margin" Value="0" />
      </Style>
      <Style Selector="StackPanel#EditFields">
        <Setter Property="Orientation" Value="Vertical" />
      </Style>
      <!-- The bottom bar already says ETB; the heading would only cost the checkbox its width. -->
      <Style Selector="TextBlock#EtbTitle">
        <Setter Property="IsVisible" Value="False" />
      </Style>

      <!-- Six columns budgeted for an ELW monitor cannot be made to fit 412dp, so the phone
           reads the same rows as cards instead. -->
      <Style Selector="Border#EtbGridPanel">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border#EtbCardPanel">
        <Setter Property="IsVisible" Value="True" />
      </Style>

      <!-- The dock stacks. -->
      <Style Selector="AutoCompleteBox#FromBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="AutoCompleteBox#ToBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="TextBox#EtbTextBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="TextBox#EditTextBox">
        <Setter Property="Width" Value="NaN" />
      </Style>
      <Style Selector="HeaderedContentControl.field">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="Button.dock-action">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <DockPanel>
    <!-- WrapPanel rather than fixed columns: on a phone the four controls take two lines instead
         of squeezing the title out. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
      <TextBlock Grid.Column="0" x:Name="EtbTitle" Text="EINSATZTAGEBUCH" Classes="overline" VerticalAlignment="Top" />
      <WrapPanel Grid.Column="1" x:Name="EtbHeaderActions" Orientation="Horizontal" HorizontalAlignment="Right"
                 ItemSpacing="12" LineSpacing="6">
        <!-- The Lagemeldung (#592) lives here, beside the journal it is written from. -->
        <Button x:Name="OpenSituationReportButton" Content="LAGEMELDUNG"
                VerticalAlignment="Center"
                ToolTip.Tip="Lagemeldung an die Leitstelle schreiben (Strg+L)"
                IsVisible="{Binding !IsReadOnly}"
                Command="{Binding SituationReport.OpenCommand}" />
        <!-- The Buchstabier-Helfer on its own, for a name in an ordinary ETB entry. -->
        <Button x:Name="OpenSpellingHelperButton" Classes="ghost" Content="BUCHSTABIEREN"
                VerticalAlignment="Center"
                Command="{Binding OpenSpellingHelperCommand}" />
        <CheckBox x:Name="OnlySituationReportsCheckBox"
                  Content="Nur Lagemeldungen"
                  IsChecked="{Binding ShowOnlySituationReports}" />
        <CheckBox x:Name="HideSystemCheckBox"
                  Content="Systemmeldungen ausblenden"
                  IsChecked="{Binding HideSystemEntries}" />
      </WrapPanel>
    </Grid>

    <!-- The Lagemeldung (#592), beside the journal it is written from: the grid stays readable on
         the left, so Lage and Maßnahmen can be taken from what happened. Docked before the input
         dock so it runs the full height on the right and a quick ETB line can still be written
         below the journal mid-report. On SENDEN it becomes an ETB row and the panel closes; there
         is no list of reports of its own. An inline panel under the overlay contract (#538):
         focus lands on LAGE, Escape folds it away and keeps the draft. -->
    <Border x:Name="SituationReportPanel"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="16,14"
            IsVisible="{Binding SituationReport.IsOpen}"
            b:Overlay.IsInline="True"
            b:Overlay.CancelCommand="{Binding SituationReport.CloseCommand}"
            b:Overlay.InitialFocus="{Binding #SrSituationBox}"
            b:Overlay.FallbackFocus="{Binding #OpenSituationReportButton}">
      <DockPanel DataContext="{Binding SituationReport}" x:DataType="vm:SituationReportComposerViewModel">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Text="Lagemeldung" Classes="display" FontSize="18" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="CloseSituationReportButton" Classes="ghost"
                  AutomationProperties.Name="Lagemeldung schließen (Entwurf bleibt)"
                  ToolTip.Tip="Schließen – der Entwurf bleibt erhalten"
                  Command="{Binding CloseCommand}">
            <PathIcon Width="13" Height="13"
                      Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
          </Button>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
          <Button x:Name="DiscardSituationReportButton" Classes="ghost dock-action" Content="VERWERFEN"
                  Command="{Binding DiscardCommand}" />
          <Button x:Name="SendSituationReportButton" Classes="signal dock-action" Content="{Binding SendLabel}"
                  Command="{Binding SendCommand}" />
        </StackPanel>

        <!-- The Funkspruch as a script: what is said, top to bottom, in speaking order, one part
             per line, so the Lagebuchführer reads down it into the radio. The street is the part
             the ILS asks to have spelled, so its spelling sits right under it. Docked right above
             SENDEN, so reading it out and sending it are one glance; the fields scroll above. -->
        <Border DockPanel.Dock="Bottom" x:Name="FunkspruchScript" Margin="0,12,0,0" Padding="14,12"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="3,0,0,0"
                CornerRadius="{StaticResource RadiusMd}">
          <ScrollViewer x:Name="FunkspruchScroll"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="0,0,6,0">
              <TextBlock Text="Funkspruch" Classes="secondary" FontSize="12" />
              <ItemsControl x:Name="FunkspruchLinesList" ItemsSource="{Binding FunkspruchLines}"
                            IsVisible="{Binding HasFunkspruch}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <!-- SelectableTextBlock, so a line can be copied; it is not a TextBlock to the
                       global text style, hence the body font set here. -->
                  <DataTemplate x:DataType="vm:FunkspruchLine">
                    <StackPanel Spacing="2">
                      <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource BodyFont}"
                                           FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                      <SelectableTextBlock Text="{Binding Spelling}" FontFamily="{StaticResource BodyFont}"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           IsVisible="{Binding Spelling, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Noch leer. Was hier steht, wird vorgelesen und ins ETB geschrieben."
                         TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                         IsVisible="{Binding !HasFunkspruch}" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <ScrollViewer x:Name="SituationReportScroll"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8" Margin="0,0,6,0">
            <HeaderedContentControl Classes="field" Header="MELDENDER">
              <TextBox x:Name="SrReporterBox" Text="{Binding Reporter}" IsReadOnly="{Binding !IsEditable}"
                       MaxLength="{x:Static vm:SituationReportComposerViewModel.MaxReporterLength}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="EINSATZSTELLE">
              <TextBox x:Name="SrLocationBox" Text="{Binding Location}" IsReadOnly="{Binding !IsEditable}"
                       TextWrapping="Wrap"
                       MaxLength="{x:Static vm:SituationReportComposerViewModel.MaxLocationLength}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="LAGE">
              <TextBox x:Name="SrSituationBox" Text="{Binding Situation}" IsReadOnly="{Binding !IsEditable}"
                       TextWrapping="Wrap"
                       MaxLength="{x:Static vm:SituationReportComposerViewModel.MaxFieldLength}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="DURCHGEFÜHRTE MASSNAHMEN">
              <TextBox x:Name="SrMeasuresBox" Text="{Binding Measures}" IsReadOnly="{Binding !IsEditable}"
                       TextWrapping="Wrap"
                       MaxLength="{x:Static vm:SituationReportComposerViewModel.MaxFieldLength}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="EINGESETZTE EINHEITEN">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" x:Name="SrUnitsBox" Text="{Binding Units}" IsReadOnly="{Binding !IsEditable}"
                         TextWrapping="Wrap"
                         MaxLength="{x:Static vm:SituationReportComposerViewModel.MaxFieldLength}" />
                <Button Grid.Column="1" x:Name="SrRefreshUnitsButton" Classes="ghost" VerticalAlignment="Top"
                        ToolTip.Tip="Aus den Kräften neu übernehmen"
                        AutomationProperties.Name="Einheiten aus den Kräften neu übernehmen"
                        Command="{Binding RefreshUnitsCommand}">
                  <PathIcon Width="14" Height="14"
                            Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                </Button>
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="NACHFORDERUNGEN">
              <TextBox x:Name="SrRequestsBox" Text="{Binding Requests}" IsReadOnly="{Binding !IsEditable}"
                       TextWrapping="Wrap"
                       MaxLength="{x:Static vm:SituationReportComposerViewModel.MaxFieldLength}" />
            </HeaderedContentControl>
            <TextBlock x:Name="SrError" Classes="field-error" Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- The whole Buchstabier-Helfer, folded away: the Einsatzstelle above is spelled
                 already, this is for any other word. -->
            <Expander x:Name="SrHelperExpander" Header="Buchstabieren" Margin="0,6,0,0"
                      HorizontalAlignment="Stretch"
                      IsExpanded="{Binding IsHelperExpanded}">
              <views:SpellingHelperView x:Name="SrHelper" DataContext="{Binding Helper}" MaxHeight="420" />
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- The phone's way in to the dock. Full width and at the bottom edge of the list, where the
         thumb already is; on a wide window the dock is simply always open and this never shows. -->
    <Button DockPanel.Dock="Bottom" x:Name="OpenComposerButton" Classes="signal"
            Margin="0,12,0,0" HorizontalAlignment="Stretch"
            Height="{StaticResource ControlHeightTouch}"
            Content="+ NEUER EINTRAG"
            IsVisible="{Binding ShowComposerButton}"
            Command="{Binding OpenComposerCommand}" />

    <!-- Input dock -->
    <!-- Enter submits from every field; focus then goes back to VON, cleared like AN (#540): an
         entry starts with who sent it, in reading order. VON is deliberately not sticky: a
         leftover sender would put the next message in the record under the wrong unit. -->
    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            IsVisible="{Binding ShowComposer}"
            b:EntryForm.SubmitCommand="{Binding AddEntryCommand}"
            b:EntryForm.FirstField="{Binding #FromBox}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <!-- Scrolls so a focused field can still be reached once Android's AdjustResize has taken
           the bottom half of the window for the soft keyboard. On a wide window the dock is one
           row tall and the scrollbar never appears. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6">
          <!-- Only the phone's sheet needs a way back out; the wide dock is never in the way. -->
          <Grid x:Name="ComposerHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,4"
                IsVisible="{Binding IsNarrow}">
            <TextBlock Grid.Column="0" Text="NEUER EINTRAG" Classes="overline" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="CloseComposerButton" Classes="ghost"
                    AutomationProperties.Name="Eingabe schließen"
                    ToolTip.Tip="Eingabe schließen"
                    Command="{Binding CloseComposerCommand}">
              <PathIcon Width="13" Height="13"
                        Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
            </Button>
          </Grid>
          <StackPanel x:Name="DockFields" Spacing="8">
            <!-- Suggestion list, not a closed set: a sender/recipient outside Stammdaten (e.g. "ELW 1",
                 a person's name) must stay enterable, so this is an AutoCompleteBox rather than a
                 ComboBox, mirroring ForcesView's Brigade field. -->
            <HeaderedContentControl Classes="field suggest" Header="VON">
              <AutoCompleteBox x:Name="FromBox" PlaceholderText="{x:Static md:AnonymizedExampleData.CallSignPlaceholder}"
                               ItemsSource="{Binding CallSignOptions}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                               Text="{Binding NewFrom}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field suggest" Header="AN">
              <AutoCompleteBox x:Name="ToBox" PlaceholderText="{x:Static md:AnonymizedExampleData.SecondCallSignPlaceholder}"
                               ItemsSource="{Binding CallSignOptions}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                               Text="{Binding NewTo}" />
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field required" Header="EINTRAG"
                                      Classes.invalid="{Binding NewTextError, Converter={x:Static ObjectConverters.IsNotNull}}">
              <!-- Freitext: kein Platzhalter, siehe #137 -->
              <TextBox x:Name="EtbTextBox" Text="{Binding NewText}" />
            </HeaderedContentControl>
            <Button x:Name="EtbAddButton" Classes="signal dock-action" Content="HINZUFÜGEN" Command="{Binding AddEntryCommand}"
                    VerticalAlignment="Bottom" Margin="0,0,0,1" />
            <Button x:Name="EtbAddAndTaskButton" Classes="ghost dock-action" Content="HINZUFÜGEN &amp; AUFGABE"
                    Command="{Binding AddEntryAndCreateTaskCommand}"
                    VerticalAlignment="Bottom" Margin="0,0,0,1" />
          </StackPanel>
          <!-- Was noch fehlt (#412): eine eigene Zeile, weil eine Meldung unter dem Feld
               selbst dieses so breit machen wuerde wie ihren Text und den Knopf aus dem
               Fenster schoebe. Die Felder sagen welche, diese Zeile sagt was. -->
          <TextBlock x:Name="DockErrorSummary" Classes="field-error"
                     Text="{Binding ErrorSummary}"
                     IsVisible="{Binding ErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Edit panel: a small form below the grid, mirroring the input dock's visual language, shown
         only while a row is being edited (not inline DataGrid cell editing). It keeps the overlay
         keyboard contract (#538) as an inline panel. Closing hands focus back to the row's edit
         button; if a rebuild has taken that away meanwhile, to the entry field. -->
    <Border DockPanel.Dock="Bottom" x:Name="EditPanel" Margin="0,16,0,0"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14"
            IsVisible="{Binding IsEditing}"
            b:Overlay.IsInline="True"
            b:Overlay.CancelCommand="{Binding CancelEditCommand}" b:Overlay.PrimaryCommand="{Binding SaveEditCommand}"
            b:Overlay.InitialFocus="{Binding #EditTextBox}" b:Overlay.FallbackFocus="{Binding #EtbTextBox}">
      <StackPanel Spacing="6">
        <StackPanel x:Name="EditFields" Spacing="8">
          <HeaderedContentControl Classes="field required" Header="EINTRAG"
                                    Classes.invalid="{Binding EditTextError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Freitext: kein Platzhalter, siehe #137 -->
            <TextBox x:Name="EditTextBox" Text="{Binding EditText}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </HeaderedContentControl>
          <Button x:Name="SaveEditButton" Classes="signal dock-action" Content="SPEICHERN" Command="{Binding SaveEditCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
          <Button x:Name="CancelEditButton" Classes="dock-action" Content="ABBRECHEN" Command="{Binding CancelEditCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </StackPanel>
        <!-- Was noch fehlt (#412): eine eigene Zeile, weil eine Meldung unter dem Feld
             selbst dieses so breit machen wuerde wie ihren Text und den Knopf aus dem
             Fenster schoebe. Die Felder sagen welche, diese Zeile sagt was. -->
        <TextBlock x:Name="EditErrorSummary" Classes="field-error"
                   Text="{Binding EditErrorSummary}"
                   IsVisible="{Binding EditErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- History panel: read-only, available whenever the selected row has prior versions.
         Deliberately independent of IsReadOnly and of the edit panel above, so a closed incident's
         edit history is still reachable (a rewrite must stay auditable after the fact). -->
    <Border DockPanel.Dock="Bottom" x:Name="HistoryPanel" Margin="0,16,0,0"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14"
            IsVisible="{Binding HistoryEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Verlauf" Classes="overline" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="SCHLIESSEN" Command="{Binding CloseHistoryCommand}" />
        </Grid>
        <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryEntry.Edits}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="etb:EtbEntryEdit">
              <!-- No Foreground here (#438): "mono" already paints TextSecondary, and the inline
                   override these rows used to carry pushed them down to TextMuted — a
                   semi-transparent token (#65728580, ~40% alpha) meant for disabled text, which
                   over the panel's #0F141D lands at roughly 1,9:1 against WCAG AA's 4,5:1. These
                   rows are the audit trail this panel exists for: the previous wording, who
                   rewrote it and when. Same fix as the Übergabe heading in #436. -->
              <TextBlock Classes="mono" Margin="0,2" TextWrapping="Wrap">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}: „{1}“ ({2})">
                    <Binding Path="EditedAt" />
                    <Binding Path="PreviousText" />
                    <Binding Path="EditedBy" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- The wide layout: one row per entry, every column at once. Hidden on a phone while the
         Lagemeldung takes the screen. -->
    <Panel x:Name="EtbJournal" IsVisible="{Binding ShowJournal}">
      <Border x:Name="EtbGridPanel" Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
        <DataGrid x:Name="EtbGrid" b:RowKeys.IsEnabled="True" ItemsSource="{Binding Entries}" IsReadOnly="True" CanUserSortColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ZEIT" Binding="{Binding Time}" />
            <DataGridTextColumn Header="VON" Binding="{Binding From}" />
            <DataGridTextColumn Header="AN" Binding="{Binding To}" />
            <DataGridTemplateColumn Header="EINTRAG" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:EtbEntryRow">
                  <!-- A sent Lagemeldung carries its Nr. (#592), so "Nur Lagemeldungen" is not the
                       only way to tell it from the rest of the traffic to the Leitstelle. -->
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,4" VerticalAlignment="Center">
                    <Border Classes="lm-badge" IsVisible="{Binding SituationReportLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding SituationReportLabel}" />
                    </Border>
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="ERFASST VON" Binding="{Binding EnteredBy}" />
            <DataGridTemplateColumn Header="">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:EtbEntryRow">
                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,4">
                    <Button Classes="icon-btn" Command="{Binding BeginEditCommand}" b:RowKeys.Role="Primary"
                            IsVisible="{Binding IsEditable}" ToolTip.Tip="Bearbeiten (Enter)"
                            AutomationProperties.Name="Bearbeiten">
                      <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                    </Button>
                    <!-- Not gated on IsEditable/IsReadOnly like the edit button: history must stay
                         readable even for a System entry's neighbours or a closed incident. Its
                         amber tint is the row's only "was edited" marker: it only shows up here,
                         so a separate badge in the EINTRAG column would just repeat the same fact. -->
                    <Button Classes="icon-btn" Command="{Binding ShowHistoryCommand}"
                            IsVisible="{Binding WasEdited}" ToolTip.Tip="Verlauf (bearbeitet)"
                            AutomationProperties.Name="Verlauf (bearbeitet)">
                      <PathIcon Foreground="{StaticResource AmberBrush}"
                                Data="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6a7 7 0 1 1 7 7 6.92 6.92 0 0 1-4.95-2.05l-1.41 1.41A9 9 0 1 0 13 3zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8z" />
                    </Button>
                    <!-- Reopens the same overlay #88 wired to the input dock's "HINZUFÜGEN & AUFGABE"
                         button, the one thing that flow left no way back to once an entry was saved
                         (#247). Hidden entirely (not just disabled), like the host feature gate. -->
                    <Button Classes="icon-btn" Command="{Binding CreateTaskCommand}"
                            IsVisible="{Binding CanCreateTask}" ToolTip.Tip="Aufgabe erstellen"
                            AutomationProperties.Name="Aufgabe erstellen">
                      <PathIcon Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- The narrow layout: the same rows, read as cards. The time leads because it is what the
           Lagebuchführer scans for; the Eintrag is the body and wraps in full, because an entry
           trimmed to an ellipsis is an entry nobody can check against what was reported. -->
      <Border x:Name="EtbCardPanel" Classes="narrow-only"
              Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="EtbCards" b:RowKeys.IsEnabled="True" ItemsSource="{Binding Entries}" Margin="8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EtbEntryRow">
                <Border Classes="row-card">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mono" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding Time}" />
                    <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} → {1}">
                          <Binding Path="From" />
                          <Binding Path="To" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <Border Classes="lm-badge" HorizontalAlignment="Left"
                            IsVisible="{Binding SituationReportLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding SituationReportLabel}" />
                    </Border>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="mono" FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding EnteredBy}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Classes="icon-btn card-action" Command="{Binding BeginEditCommand}" b:RowKeys.Role="Primary"
                                IsVisible="{Binding IsEditable}" ToolTip.Tip="Bearbeiten (Enter)"
                                AutomationProperties.Name="Bearbeiten">
                          <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                        </Button>
                        <Button Classes="icon-btn card-action" Command="{Binding ShowHistoryCommand}"
                                IsVisible="{Binding WasEdited}" ToolTip.Tip="Verlauf (bearbeitet)"
                                AutomationProperties.Name="Verlauf (bearbeitet)">
                          <PathIcon Foreground="{StaticResource AmberBrush}"
                                    Data="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6a7 7 0 1 1 7 7 6.92 6.92 0 0 1-4.95-2.05l-1.41 1.41A9 9 0 1 0 13 3zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8z" />
                        </Button>
                        <Button Classes="icon-btn card-action" Command="{Binding CreateTaskCommand}"
                                IsVisible="{Binding CanCreateTask}" ToolTip.Tip="Aufgabe erstellen"
                                AutomationProperties.Name="Aufgabe erstellen">
                          <PathIcon Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
