<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LageBuch.AppLogic.ViewModels;assembly=LageBuch.AppLogic"
             xmlns:md="clr-namespace:LageBuch.Persistence.MasterData;assembly=LageBuch.Persistence"
             xmlns:b="clr-namespace:LageBuch.App.Shared.Behaviors"
             xmlns:ctrl="clr-namespace:LageBuch.App.Shared.Controls"
             x:Class="LageBuch.App.Shared.Views.RolesView"
             x:DataType="vm:RolesViewModel">
  <!-- Keyed off the workspace's "narrow" class (#685). Field widths are Styles rather than Width= on the
       controls: a local value in XAML outranks a Style setter, so the narrow styles could never
       widen them. One dock serves both layouts. -->
  <UserControl.Resources>
    <!-- One entry of the Unterstellen menu (#703), shared by the grid row and the phone card.
         A Button and a Flyout, not a ComboBox, for the reason ScbaView's Sicherheitstrupp picker
         gives: the pick writes to the incident and rebuilds these entries mid-selection. -->
    <DataTemplate x:Key="ReportsToChoiceTemplate" x:DataType="vm:ReportsToChoice">
      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5"
              Command="{Binding SelectCommand}">
        <Grid ColumnDefinitions="14,Auto,*" ColumnSpacing="6">
          <TextBlock Grid.Column="0" Text="✓" FontWeight="Bold" IsVisible="{Binding IsCurrent}" />
          <TextBlock Grid.Column="1" Text="{Binding Display}" />
          <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="cellLabel" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Orientation as a Style, never Orientation="Horizontal" on the panel: a local value in
         XAML outranks a Style setter, so the narrow styles below could not turn the dock upright
         and every field stayed on one squeezed line. A StackPanel rather than a WrapPanel because
         a vertical WrapPanel flows into columns; a vertical StackPanel gives one field per line
         and constrains each to the panel's width, which is what makes Width=NaN fill it. -->
    <Style Selector="StackPanel#DockFields">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="StackPanel#TransferFields">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <!-- The row a dragged Funktion would land under (#703), set by the code-behind during a drag. -->
    <Style Selector="DataGridRow.drop-target">
      <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
    </Style>
    <!-- The guide lines run the cell's full height, so they join from one row to the next. -->
    <Style Selector="DataGridCell.tree">
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border#TopLevelDropZone.drag-over">
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
      <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
    </Style>
    <Style Selector="AutoCompleteBox#RoleBox">
      <Setter Property="Width" Value="120" />
    </Style>
    <Style Selector="AutoCompleteBox#PersonNameBox">
      <Setter Property="Width" Value="200" />
    </Style>
    <Style Selector="TextBox#SectionBox">
      <Setter Property="Width" Value="130" />
    </Style>
    <Style Selector="AutoCompleteBox#CallSignBox">
      <Setter Property="Width" Value="150" />
    </Style>
    <Style Selector="TextBox#PhoneBox">
      <Setter Property="Width" Value="150" />
    </Style>
    <Style Selector="AutoCompleteBox#TransferPersonNameBox">
      <Setter Property="Width" Value="200" />
    </Style>
    <Style Selector="AutoCompleteBox#TransferCallSignBox">
      <Setter Property="Width" Value="150" />
    </Style>
    <Style Selector="TextBox#TransferPhoneBox">
      <Setter Property="Width" Value="150" />
    </Style>

    <Style Selector="Panel#WorkspaceRoot.narrow StackPanel#DockFields">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow StackPanel#TransferFields">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <!-- The bottom bar already says FUNKTIONEN; dropping the heading gives the checkbox room. -->
    <Style Selector="Panel#WorkspaceRoot.narrow TextBlock#RolesTitle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow Border#RolesGridPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow Border#RolesCardPanel">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow AutoCompleteBox#RoleBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow AutoCompleteBox#PersonNameBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow TextBox#SectionBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow AutoCompleteBox#CallSignBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow TextBox#PhoneBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow AutoCompleteBox#TransferPersonNameBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow AutoCompleteBox#TransferCallSignBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow TextBox#TransferPhoneBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow HeaderedContentControl.field">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Panel#WorkspaceRoot.narrow Button.dock-action">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="{StaticResource ControlHeightTouch}" />
    </Style>
  </UserControl.Styles>

  <!-- Tab follows the screen, top to bottom (#695). The DockPanel needs its bottom-docked
       children declared before the list that fills the rest, and declaration order alone tabbed
       the dock before the list above it. Each child is its own tab group, ranked by TabIndex in
       the order it appears on screen. -->
  <DockPanel KeyboardNavigation.TabNavigation="Local">
    <Grid KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0" DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Grid.Column="0" x:Name="RolesTitle" Text="FÜHRUNG &amp; FUNKTIONEN" Classes="overline" VerticalAlignment="Top" />
      <CheckBox Grid.Column="1" x:Name="ShowAllRolesCheckBox"
                Content="Alle Funktionen (auch beendete)"
                IsChecked="{Binding ShowAllRoles}" />
    </Grid>

    <!-- The phone's way in to the dock, at the bottom edge where the thumb already is. -->
    <Button KeyboardNavigation.TabIndex="4" DockPanel.Dock="Bottom" x:Name="OpenComposerButton" Classes="signal"
            Margin="0,12,0,0" HorizontalAlignment="Stretch"
            Height="{StaticResource ControlHeightTouch}"
            Content="+ FUNKTION ZUWEISEN"
            IsVisible="{Binding ShowComposerButton}"
            Command="{Binding OpenComposerCommand}" />

    <!-- Input dock. Enter submits from every field; focus then goes back to FUNKTION (#540). -->
    <Border KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="3" x:Name="InputDock" DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            IsVisible="{Binding ShowComposer}"
            b:EntryForm.SubmitCommand="{Binding AddRoleCommand}"
            b:EntryForm.FirstField="{Binding #RoleBox}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14">
      <!-- Scrolls so a focused field stays reachable once Android's AdjustResize has given the
           bottom of the window to the soft keyboard. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <!-- Only the phone's form needs a way back out; the wide dock is never in the way. -->
        <Grid x:Name="ComposerHeader" ColumnDefinitions="*,Auto"
              IsVisible="{Binding IsNarrow}">
          <TextBlock Grid.Column="0" Text="FUNKTION ZUWEISEN" Classes="overline" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="CloseComposerButton" Classes="ghost"
                  AutomationProperties.Name="Eingabe schließen"
                  ToolTip.Tip="Eingabe schließen"
                  Command="{Binding CloseComposerCommand}">
            <PathIcon Width="13" Height="13"
                      Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
          </Button>
        </Grid>
        <StackPanel x:Name="DockFields" Spacing="8">
          <!-- Funktion is a suggestion list, not a closed set: an ad-hoc or mutual-aid role must stay
               enterable, so this is an AutoCompleteBox rather than a ComboBox (which Avalonia cannot
               make editable) — mirrors PersonNameBox below. -->
          <HeaderedContentControl Classes="field suggest required" Header="FUNKTION"
                                  Classes.invalid="{Binding NewRoleError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <AutoCompleteBox x:Name="RoleBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.RolePlaceholder}"
                             ItemsSource="{Binding RoleOptions}"
                             FilterMode="ContainsOrdinal"
                             MinimumPrefixLength="0"
                             Text="{Binding NewRole}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="ABSCHNITT">
            <TextBox x:Name="SectionBox"
                     PlaceholderText="{x:Static md:AnonymizedExampleData.SectionPlaceholder}"
                     Text="{Binding NewSection}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field suggest required" Header="NAME"
                                  Classes.invalid="{Binding NewPersonNameError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <AutoCompleteBox x:Name="PersonNameBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.PersonDisplayNamePlaceholder}"
                             ItemsSource="{Binding PersonOptions}"
                             FilterMode="ContainsOrdinal"
                             MinimumPrefixLength="0"
                             Text="{Binding NewPersonName}" />
          </HeaderedContentControl>
          <!-- Suggestion list, not a closed set: an ad-hoc or mutual-aid call sign must stay
               enterable, so this is an AutoCompleteBox rather than a ComboBox (#92). -->
          <HeaderedContentControl Classes="field suggest" Header="FUNKRUFNAME">
            <AutoCompleteBox x:Name="CallSignBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.CallSignPlaceholder}"
                             ItemsSource="{Binding CallSignOptions}"
                             FilterMode="ContainsOrdinal"
                             MinimumPrefixLength="0"
                             Text="{Binding NewCallSign}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="HANDYNUMMER">
            <TextBox x:Name="PhoneBox"
                     PlaceholderText="{x:Static md:AnonymizedExampleData.PhoneNumberPlaceholder}"
                     Text="{Binding NewPhone}" />
          </HeaderedContentControl>
          <Button x:Name="AddRoleButton" Classes="signal dock-action" Content="ZUWEISEN" Command="{Binding AddRoleCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </StackPanel>
        <!-- Was noch fehlt (#412): eigene Zeile, damit keine Meldung ihr Feld verbreitert. -->
        <TextBlock x:Name="DockErrorSummary" Classes="field-error"
                   Text="{Binding ErrorSummary}"
                   IsVisible="{Binding ErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- Funktion ist bewusst Freitext (ad hoc, überörtliche Hilfe), also nur ein Hinweis:
             die Zuweisung wird so oder so übernommen. Gleiche Darstellung wie ForcesView's
             DuplicateHint. -->
        <TextBlock x:Name="UnknownRoleHint" Text="Funktion steht nicht in den Stammdaten — wird trotzdem zugewiesen"
                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsNewRoleUnknown}" />
        <!-- Wer die schon vergebene Funktion hält (#470): der Druck auf ZUWEISEN wird zur Übergabe,
             nicht zur zweiten Zuweisung. Gleiche Darstellung wie der Hinweis darüber — beides ist
             Information, keine Eingabeverweigerung. -->
        <TextBlock x:Name="RoleConflictHint"
                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ConflictHint}"
                   IsVisible="{Binding ConflictHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Transfer panel: a small form below the grid, mirroring EtbView's edit panel, shown only
         while a handover is in progress (not inline DataGrid cell editing) — a transfer needs its
         own person/call sign/phone, not a single cell. Keyboard as EtbView's edit panel (#538). -->
    <Border KeyboardNavigation.TabIndex="2" DockPanel.Dock="Bottom" x:Name="TransferPanel" Margin="0,16,0,0" IsEnabled="{Binding !IsReadOnly}"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="14"
            IsVisible="{Binding IsTransferring}"
            b:Overlay.IsInline="True"
            b:Overlay.CancelCommand="{Binding CancelTransferCommand}" b:Overlay.PrimaryCommand="{Binding ConfirmTransferCommand}"
            b:Overlay.InitialFocus="{Binding #TransferPersonNameBox}" b:Overlay.FallbackFocus="{Binding #PersonNameBox}">
      <StackPanel Spacing="10">
        <!-- No Foreground here (#413): "mono" already paints TextSecondary, and the inline
             override this line used to carry pushed it down to TextMuted. Muted is a
             semi-transparent token (#65728580, ~40% alpha) meant for disabled text; over the
             panel's #0F141D it composites to roughly 1,9:1 against WCAG AA's 4,5:1 — on the one
             line that says which Funktion is being handed to whom. The arrow beside it takes
             TextSecondary explicitly, since PathIcon is not covered by the "mono" style. -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="TransferSummaryText" Classes="mono">
            <TextBlock.Text>
              <MultiBinding StringFormat="Übergabe {0}: {1}">
                <Binding Path="TransferringRow.Role" />
                <Binding Path="TransferringRow.PersonName" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <PathIcon x:Name="TransferArrowIcon" Width="11" Height="11" VerticalAlignment="Center"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Data="M16.01 11H4v2h12.01v3L20 12l-3.99-4z" />
        </StackPanel>
        <StackPanel x:Name="TransferFields" Spacing="8">
          <HeaderedContentControl Classes="field suggest required" Header="NAME"
                                  Classes.invalid="{Binding TransferPersonNameError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <AutoCompleteBox x:Name="TransferPersonNameBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.PersonDisplayNamePlaceholder}"
                             ItemsSource="{Binding PersonOptions}"
                             FilterMode="ContainsOrdinal"
                             MinimumPrefixLength="0"
                             Text="{Binding TransferPersonName}"
                             b:EnterSubmit.Command="{Binding ConfirmTransferCommand}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field suggest" Header="FUNKRUFNAME">
            <AutoCompleteBox x:Name="TransferCallSignBox"
                             PlaceholderText="{x:Static md:AnonymizedExampleData.SecondCallSignPlaceholder}"
                             ItemsSource="{Binding CallSignOptions}"
                             FilterMode="ContainsOrdinal"
                             MinimumPrefixLength="0"
                             Text="{Binding TransferCallSign}" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="HANDYNUMMER">
            <TextBox x:Name="TransferPhoneBox"
                     PlaceholderText="{x:Static md:AnonymizedExampleData.PhoneNumberPlaceholder}"
                     Text="{Binding TransferPhone}" />
          </HeaderedContentControl>
          <Button x:Name="ConfirmTransferButton" Classes="signal dock-action" Content="ÜBERTRAGEN" Command="{Binding ConfirmTransferCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
          <Button x:Name="CancelTransferButton" Classes="dock-action" Content="ABBRECHEN" Command="{Binding CancelTransferCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </StackPanel>
        <!-- Was noch fehlt (#412): eigene Zeile, damit keine Meldung ihr Feld verbreitert. -->
        <TextBlock x:Name="TransferErrorSummary" Classes="field-error"
                   Text="{Binding TransferErrorSummary}"
                   IsVisible="{Binding TransferErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <Panel KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
    <Border x:Name="RolesGridPanel" Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <DataGrid x:Name="RolesGrid" DragDrop.AllowDrop="{Binding !IsReadOnly}" b:RowKeys.IsEnabled="True" b:SelectedRowTab.IsEnabled="True" ItemsSource="{Binding Roles}" IsReadOnly="True" CanUserSortColumns="False">
        <DataGrid.Columns>
          <!-- The Führungsstruktur (#703): each Funktion under the one it reports to, behind guide
               lines. The grip starts a drag; dropping on another row puts the Funktion under that one. -->
          <DataGridTemplateColumn Header="FUNKTION" CellStyleClasses="tree">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:RoleAssignmentRow">
                <Grid ColumnDefinitions="Auto,Auto,*" Margin="6,0,12,0">
                  <Border Grid.Column="0" x:Name="RoleDragHandle" Background="Transparent" Padding="2,4,6,4" Cursor="SizeAll"
                          VerticalAlignment="Center"
                          IsVisible="{Binding CanSetReportsTo}"
                          ToolTip.Tip="Ziehen, um die Funktion unterzustellen"
                          AutomationProperties.Name="Funktion ziehen">
                    <PathIcon Width="10" Height="14" Foreground="{StaticResource TextSecondaryBrush}"
                              Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" />
                  </Border>
                  <!-- One 18px cell per level above the row: a line down the left of the cell, and a
                       branch out to the Funktion on the row's own level. -->
                  <ItemsControl Grid.Column="1" x:Name="RoleTreeGuide" ItemsSource="{Binding TreeSegments}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TreeGuideSegment">
                        <Grid Width="18" RowDefinitions="*,*" ColumnDefinitions="7,*">
                          <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="0,0,1,0"
                                  IsVisible="{Binding LineAbove}" />
                          <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="0,0,1,0"
                                  IsVisible="{Binding LineBelow}" />
                          <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="0,0,0,1"
                                  Margin="0,0,4,0" IsVisible="{Binding Branch}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Grid.Column="2" Text="{Binding Role}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="ABSCHNITT" Binding="{Binding Section}" />
          <DataGridTextColumn Header="NAME" Binding="{Binding PersonName}" Width="*" />
          <DataGridTextColumn Header="FUNKRUFNAME" Binding="{Binding CallSign}" />
          <!-- Handynummer is a live cell rather than printed text: a corrected number is edited in
               place, not by ending and re-assigning the role. Mirrors ForcesView's Bemerkung column,
               but — unlike Bemerkung — a save here also writes an ETB line (EditRolePhone logs a
               real change), so committing on every keystroke would both spam the journal with
               partial numbers and, since the row rebuilds on each commit (see #33), throw focus out
               of the box after every character. UpdateSourceTrigger=LostFocus pushes once, when the
               operator actually leaves the field. -->
          <DataGridTemplateColumn Header="HANDYNUMMER" Width="170">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:RoleAssignmentRow">
                <TextBox Margin="6,4"
                         PlaceholderText="{x:Static md:AnonymizedExampleData.PhoneNumberPlaceholder}"
                         Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding !IsReadOnly}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="VON" Binding="{Binding FromDisplay}" />
          <DataGridTextColumn Header="BIS" Binding="{Binding ToDisplay}" />
          <DataGridTemplateColumn Header="AKTION" Width="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:RoleAssignmentRow">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <!-- Eine doppelt vergebene Funktion aus einer älteren Datei, einem Import oder
                       einem anderen Gerät lässt sich nicht verweigern, nur anzeigen (#470). Neben dem
                       Button, der sie auflöst. -->
                  <PathIcon x:Name="RoleDuplicateIcon" Width="13" Height="13" VerticalAlignment="Center"
                            Foreground="{StaticResource AmberBrush}"
                            Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                            IsVisible="{Binding IsDuplicate}"
                            ToolTip.Tip="Doppelt vergeben – Funktion übertragen"
                            AutomationProperties.Name="Funktion doppelt vergeben" />
                  <!-- The drag's keyboard and touch twin (#703): the same links, as a menu. -->
                  <Button x:Name="ReportsToButton" Classes="ghost" Margin="0,2" Padding="6,4"
                          IsVisible="{Binding CanSetReportsTo}"
                          ToolTip.Tip="{Binding ReportsToButtonText, StringFormat='Unterstellen unter … (meldet an: {0})'}"
                          AutomationProperties.Name="Unterstellen unter">
                    <PathIcon Width="13" Height="13"
                              Data="M19,15L13,21L11.58,19.58L15.17,16H4V4H6V14H15.17L11.58,10.42L13,9L19,15Z" />
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel MinWidth="220" Spacing="4">
                          <TextBlock Text="UNTERSTELLEN UNTER" Classes="overline" Margin="8,2,8,2" />
                          <ItemsControl ItemsSource="{Binding ReportsToChoices}"
                                        ItemTemplate="{StaticResource ReportsToChoiceTemplate}" />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Button x:Name="TransferRowButton" Content="ÜBERTRAGEN" Margin="4,2"
                          IsVisible="{Binding IsRunning}"
                          Command="{Binding BeginTransferCommand}"
                          b:RowKeys.Role="Primary" ToolTip.Tip="Funktion übertragen (Enter)" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Laid over the grid's header while a Funktion is dragged (#703): a drop here takes it out from
         under its superior. Over the header rather than above the grid, so the rows do not move
         under the pointer when it appears. -->
    <Border x:Name="TopLevelDropZone" VerticalAlignment="Top" Height="34" Margin="1"
            Background="#0F141D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            IsVisible="{Binding IsDraggingRole}"
            DragDrop.AllowDrop="{Binding !IsReadOnly}">
      <TextBlock Text="HIER ABLEGEN: OBERSTE EBENE" Classes="overline"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- The narrow layout: one card per assignment, in the grid's order (#696). The Funktion leads —
         it is what the position is called on the radio — with its Abschnitt and the person under it;
         the Handynummer stays a live field for the same reason it is one in the grid, and
         ÜBERTRAGEN stays with the row it hands over. -->
    <Border x:Name="RolesCardPanel" Classes="narrow-only"
            Background="#0C1119" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="RolesCards" b:RowKeys.IsEnabled="True" ItemsSource="{Binding Roles}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RoleAssignmentRow">
              <!-- Indented by its depth in the Führungsstruktur (#703), with a line down the indent. -->
              <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" x:Name="RoleCardIndent" Width="{Binding IndentWidth}"
                      BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0" Margin="0,0,0,8" />
              <Border Grid.Column="1" Classes="row-card">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Role}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Section}" Classes="secondary" FontSize="13" TextWrapping="Wrap"
                             IsVisible="{Binding Section, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="{Binding PersonName}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CallSign}" Classes="mono" FontSize="12"
                             IsVisible="{Binding CallSign, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBox PlaceholderText="{x:Static md:AnonymizedExampleData.PhoneNumberPlaceholder}"
                           Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           IsEnabled="{Binding !IsReadOnly}" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="MELDET AN" Classes="overline" FontSize="9" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="ReportsToCardButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Height="{StaticResource ControlHeightTouch}"
                            Content="{Binding ReportsToButtonText}"
                            IsEnabled="{Binding CanSetReportsTo}"
                            AutomationProperties.Name="Meldet an wählen">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel MinWidth="220" Spacing="4">
                            <TextBlock Text="UNTERSTELLEN UNTER" Classes="overline" Margin="8,2,8,2" />
                            <ItemsControl ItemsSource="{Binding ReportsToChoices}"
                                          ItemTemplate="{StaticResource ReportsToChoiceTemplate}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="VON" Classes="overline" FontSize="9" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FromDisplay}" Classes="mono" FontSize="12" />
                    </StackPanel>
                    <!-- ToDisplay is "—" while running, which the grid column wants and a card
                         would read as ended (#668). -->
                    <StackPanel x:Name="RoleCardTo" Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding !IsRunning}">
                      <TextBlock Text="BIS" Classes="overline" FontSize="9" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ToDisplay}" Classes="mono" FontSize="12" />
                    </StackPanel>
                  </WrapPanel>
                  <Button Content="ÜBERTRAGEN" HorizontalAlignment="Stretch"
                          Height="{StaticResource ControlHeightTouch}"
                          IsVisible="{Binding IsRunning}"
                          Command="{Binding BeginTransferCommand}"
                          b:RowKeys.Role="Primary" ToolTip.Tip="Funktion übertragen (Enter)" />
                </StackPanel>
              </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    </Panel>
  </DockPanel>
</UserControl>
